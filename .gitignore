# game data NEVER enters this repo
*.iso
*.bin
*.img
*.elf
*.zip
*.7z
*.cue
*.chd
*.mdf
*.nrg
# extracted / decrypted game content
/dump/
/extracted/
/iso/

# IOP driver modules (IRX) taken from the captain's own disc — game data, law 1.
# They live under the build root on the SSD and must NEVER be committed.
*.IRX
*.irx
IRX/
# build output
/build/
/out/
target/
*.o
*.obj
*.exe
# editor / OS
.vscode/
.idea/
.DS_Store

# opencode plugin state (goal plugin) — runtime, never source
.opencode/

# upstream clone — never commit another project's tree
/tools/PS2Recomp/
# built toolchain binaries — reproducible from tools/patches, never committed
/tools/bin/
/tools/scratch/out/
/tools/scratch/out_le/
*.o

# build-mode harness bookkeeping (dish queue + driver logs), not project content
/.auto/
