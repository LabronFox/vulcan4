   "handler_5B73C8@0x005B73C8",
   "handler_5B7390@0x005B7390",
   "handler_5B7408@0x005B7408",
   "handler_5B74E0@0x005B74E0",
+  "func_5B0850@0x005B0850",
   "_sceCd_cd_read_intr@0x01014078",
