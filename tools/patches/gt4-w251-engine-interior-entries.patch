@@ entry_points = [
   "handler_5B74E0@0x005B74E0",
   "func_5B0850@0x005B0850",
+  "func_60B548@0x0060B548",
+  "func_60B590@0x0060B590",
+  "func_60B5C0@0x0060B5C0",
+  "func_60B608@0x0060B608",
+  "func_5DA258@0x005DA258",
