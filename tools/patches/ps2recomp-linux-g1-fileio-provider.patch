 //
 // It is a plain function pointer, not a std::function, and it is checked for null on every store:
 // the null case costs one predictable branch and changes nothing about the hot path.
+// W46. A monotonic trace sequence, shared by every producer of trace output.
+//
+// W45 established that the W44 contradiction almost certainly rested on a bad assumption: that
+// stdout line order is execution order. It is not. std::cout (guest executor) and RUNTIME_LOG (the
+// IOP/driver side) are two unsynchronised producers writing into one stream, and a single log line in
+// the W44 sample shows them interleaving mid-line. Every "nothing wrote this address" conclusion since
+// W33 was read off stdout position, so the ordering has to be re-derived from something trustworthy.
+//
+// This counter is that something: it is atomic, monotonic, and shared, so two trace lines can be
+// ordered by their sequence regardless of which producer emitted them or how the stream interleaved.
+// It costs one relaxed atomic increment per traced event and nothing when tracing is off.
+inline std::atomic<uint64_t> &ps2TraceSequenceCounter() noexcept
+{
+    static std::atomic<uint64_t> s_sequence{0u};
+    return s_sequence;
+}
+
+inline uint64_t ps2NextTraceSequence() noexcept
+{
+    return ps2TraceSequenceCounter().fetch_add(1u, std::memory_order_relaxed) + 1u;
+}
