+        // ---------------------------------------------------------------- G1
+        tc.Run("G1: loading fileio activates a FileIO endpoint, so a disc open is served", [](TestCase &t)
+        {
+            iop_test::Host host;
+            ps2x::iop::IopSubsystem subsystem(host);
+
+            // THE WALL. iop_subsystem.cpp:197 routes strictly by request.sid against the
+            // routes table built from each service's sids(). That lookup is correct, so the
+            // only way a guest open of its own disc executable (core.gt4) can fail is if
+            // NOTHING serves the FileIO SID. It does not: only mcserv, libsd and dbcman
+            // implement sids(), and 0x80000001 appears nowhere in the tree. Meanwhile
+            // iop_module_manager.cpp:70 lists "fileio" in m_builtinKeys, so
+            // sceSifLoadModule("fileio") SUCCEEDS and the guest believes its filesystem
+            // driver loaded. The open then fails, the guest falls back to the memory-card
+            // RPC, and sceMcOpen answers -4 forever. 212,577 times, measured.
+            t.IsFalse(subsystem.canBindRpc(0x80000001u),
+                      "MECHANISM: no FileIO provider exists today, so every guest file open is "
+                      "unhandled and the guest falls back to the memory card. That fallback loop "
+                      "is the main-menu blocker.");
+
+            const ps2x::iop::ModuleLoadResult loaded = subsystem.loadModule("rom0:FILEIO");
+            t.IsTrue(loaded.moduleId > 0,
+                     "fileio is already advertised in m_builtinKeys, so the load must succeed");
+
+            t.IsTrue(subsystem.canBindRpc(0x80000001u),
+                     "loading fileio must activate the FileIO RPC endpoint (SID 0x80000001). "
+                     "Without it the guest's open can never be served, and it will keep "
+                     "probing the memory card for a file no card has.");
+
+            ps2x::iop::RpcRequest request{};
+            request.sid = 0x80000001u;
+            request.function = 5u; // open
+            const ps2x::iop::RpcResult result = subsystem.handleRpc(request);
+            t.IsTrue(result.handled,
+                     "an activated FileIO endpoint must handle its open rather than leaving the "
+                     "request to fall through unhandled");
+        });
+
         tc.Run("unknown SID remains unhandled without a loaded IRX", [](TestCase &t)
         {
             iop_test::Host host;
