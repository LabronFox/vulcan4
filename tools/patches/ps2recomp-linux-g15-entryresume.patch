+        tc.Run("a dispatched direct call EXECUTES the callee body, and a resume does not re-execute it", [](TestCase &t)
+        {
+            // G1.5. The reported failure was "a dispatched call whose callee never
+            // executes". This asserts the positive side effect, not merely "no crash".
+            gDirectCallBodyRuns.store(0u, std::memory_order_release);
+
+            PS2Runtime runtime;
+            runtime.setMissingFunctionPolicy(PS2Runtime::MissingFunctionPolicy::Stop);
+            runtime.registerFunction(kDirectCallEntry, &testGeneratedShapedCallee);
+
+            R5900Context ctx{};
+            // A real `jal` leaves ctx->pc pointing at the CALLER's current pc, and the
+            // dispatcher is handed the callee entry as targetPc. Mirror that: a fresh
+            // call arrives with ctx->pc equal to the entry address, NOT a resume case.
+            ctx.pc = kDirectCallEntry;
+            setRegU32(ctx, 31, kDirectCallFallthrough);
+
+            runtime.dispatchGuestBranch(nullptr, &ctx, kDirectCallEntry, 0x010286D4u,
+                                        kDirectCallFallthrough,
+                                        PS2Runtime::GuestBranchKind::DirectCall, "JAL");
+
+            t.Equals(gDirectCallBodyRuns.load(std::memory_order_acquire), 1u,
+                     "the callee body must execute exactly once for a fresh direct call");
+            // The callee is modelled on one that suspends at its `jr $ra`, so it legitimately
+            // leaves ctx->pc AT the resume address rather than at the caller's fallthrough --
+            // that is the resume point the harness would re-enter at. What matters here is
+            // that pc advanced out of the entry, i.e. the body really ran.
+            t.Equals(ctx.pc, kDirectCallResume,
+                     "a fresh call must enter the callee at its first instruction, not return early");
+        });
+
+        tc.Run("a resume PC must not alias back to the function body", [](TestCase &t)
+        {
+            gDirectCallBodyRuns.store(0u, std::memory_order_release);
+
+            PS2Runtime runtime;
+            runtime.setMissingFunctionPolicy(PS2Runtime::MissingFunctionPolicy::Stop);
+            runtime.registerFunction(kDirectCallEntry, &testGeneratedShapedCallee);
+
+            R5900Context ctx{};
+            // Resumption does NOT go through dispatchGuestBranch -- that helper forces
+            // ctx->pc = targetPc on entry, so a callee reached that way can never observe a
+            // resume address. The harness resumes through the generated function table,
+            // which has its own synthesised stub per address. The safety property that
+            // matters is that an unstubbed resume PC must NOT be silently aliased to the
+            // owning function, because running the body from a resume PC would re-execute
+            // every instruction before the suspend point. Getting this wrong is what made
+            // the G1.4 report claim the body never ran -- and fixing it the other way
+            // (aliasing) would re-execute the body instead.
+            ctx.pc = kDirectCallResume;
+
+            auto fn = runtime.lookupFunction(ctx.pc);
+            fn(nullptr, &ctx, &runtime);
+
+            t.Equals(gDirectCallBodyRuns.load(std::memory_order_acquire), 0u,
+                     "an unstubbed resume PC must not re-enter the function body");
+            t.IsTrue(runtime.isStopRequested(),
+                     "an unstubbed resume PC must be reported, not silently aliased to the body");
+        });
+
