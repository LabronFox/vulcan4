+    // ---------------------------------------------------------------------
+    // G1.5 regression fixtures.
+    //
+    // These two handlers are hand-written copies of the SHAPE the recompiler emits
+    // for a resumable function, so the entry-vs-resume contract is pinned by a test
+    // rather than by reading generated C. They are deliberately modelled on
+    // sub_01028638_0x1028638, the GT4 stub that G1.4 wrongly suspected of never
+    // running its body.
+    //
+    // Layout of a generated resumable function:
+    //
+    //     switch (ctx->pc) { case <resume>: goto label_<resume>; ... default: break; }
+    //     ctx->pc = <entry>;
+    //   label_<entry>:            <-- first real instruction
+    //     <body>
+    //   label_<resume>:           <-- resumes here, body NOT re-run
+    //
+    // gDirectCallBodyRuns counts how many times the first instruction executed.
+    // gEntryCaseBodyRuns is for the shape where the entry address is ITSELF a resume
+    // case (61 of the 707 GT4 functions have this) and the label sits at the body
+    // start, so the two paths must converge without skipping anything.
+    // ---------------------------------------------------------------------
+    std::atomic<uint32_t> gDirectCallBodyRuns{0u};
+    std::atomic<uint32_t> gEntryCaseBodyRuns{0u};
+
+    constexpr uint32_t kDirectCallEntry = 0x1028638u;
+    constexpr uint32_t kDirectCallResume = 0x1028640u; // the jr $ra
+    constexpr uint32_t kDirectCallFallthrough = 0x10286dcu;
+
+    void testGeneratedShapedCallee(uint8_t *, R5900Context *ctx, PS2Runtime *)
+    {
+        if (!ctx)
+            return;
+        switch (ctx->pc)
+        {
+        case kDirectCallResume:
+            // Resume path: return immediately, exactly like the generated `jr $ra`.
+            ctx->pc = kDirectCallFallthrough;
+            return;
+        default:
+            break;
+        }
+
+        // Fresh-call path: the first instruction of the body. If a dispatch ever
+        // takes the resume case when it should take default, this never runs.
+        gDirectCallBodyRuns.fetch_add(1u, std::memory_order_acq_rel);
+        ctx->pc = kDirectCallResume;
+    }
+
+    void testEntryCaseCallee(uint8_t *, R5900Context *ctx, PS2Runtime *)
+    {
+        if (!ctx)
+            return;
+        switch (ctx->pc)
+        {
+        case kDirectCallEntry:
+            goto body_start;
+        case kDirectCallResume:
+            ctx->pc = kDirectCallFallthrough;
+            return;
+        default:
+            break;
+        }
+        ctx->pc = kDirectCallEntry;
+    body_start:
+        // The label for the entry case is placed HERE, at the top of the body, so
+        // entering as a "resume" of the entry address still runs the body.
+        gEntryCaseBodyRuns.fetch_add(1u, std::memory_order_acq_rel);
+        ctx->pc = kDirectCallResume;
+    }
+
 }
 
