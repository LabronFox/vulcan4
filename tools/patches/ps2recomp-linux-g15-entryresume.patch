+            gEntryCaseBodyRuns.store(0u, std::memory_order_release);
+
+            PS2Runtime runtime;
+            runtime.setMissingFunctionPolicy(PS2Runtime::MissingFunctionPolicy::Stop);
+            runtime.registerFunction(kDirectCallEntry, &testEntryCaseCallee);
+
+            R5900Context ctx{};
+            ctx.pc = kDirectCallEntry; // matches the entry case AND the fresh-call path
+            setRegU32(ctx, 31, kDirectCallFallthrough);
+
+            runtime.dispatchGuestBranch(nullptr, &ctx, kDirectCallEntry, 0x010286D4u,
+                                        kDirectCallFallthrough,
+                                        PS2Runtime::GuestBranchKind::DirectCall, "JAL");
+
+            t.Equals(gEntryCaseBodyRuns.load(std::memory_order_acquire), 1u,
+                     "entry-address resume case must converge on the body start, not skip it");
+        });
