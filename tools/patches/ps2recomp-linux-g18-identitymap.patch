+    // MMIO accounting. Every guest read/write funnels through here (read8/16/32/64,
+    // write8/16/32/64), so this is the one place that can answer "did the guest ever touch the
+    // console's hardware registers, and which ones?". A guest that spins waiting for a hardware
+    // bit is the classic reason a recomp appears to hang, and this is how that is told apart
+    // from a guest spinning in software.
+    if (Ps2IsSpecialAddress(virtualAddress))
+    {
+        ++m_mmioAccessCount;
+        ++m_mmioCounts[virtualAddress];
+        m_lastMmioAddress = virtualAddress;
+    }
