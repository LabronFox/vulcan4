+bool EeScheduler::serviceInvocations(int stepBudget)
+{
+    assertExecutor();
+    bool ranAnything = false;
+
+    // G1.8c: WHO OWNS THE BASE FRAME, decided once, because it changes the copy direction below.
+    //
+    // GuestThread::context is a COPY of the main frame. EeScheduler::run() keeps it current because
+    // run() is the only thing advancing the guest. A driver that is not run() -- the harness, and
+    // every unit test using driveGuestLikeTheHarness -- advances PS2Runtime::m_cpuContext directly,
+    // so THAT is the live frame and the scheduler's copy is stale from the moment the guest moves.
+    //
+    // W6 was exactly this. Measured with a probe before the fix: 256 consecutive resumes, every one
+    // of them at 0x00300808, the PC the base frame held before the chain ever published a new one.
+    // On GT4 the same shape appears at the ELF entry point 0x01000008, distinct_pcs=1, its own CRT
+    // init re-run 25 times. The stale copy was being published over the live one on completion.
+    //
+    // The refresh happens HERE, on entry, and not after servicing. It has to be before: onComplete
+    // writes the handler's $v0 into the base frame, so refreshing afterwards would discard the very
+    // result being delivered. Refreshing first makes the base frame correct, lets onComplete apply
+    // $v0 to a correct frame, and the unconditional publish at the end then delivers both.
+    //
+    // Guarded on m_guestExecuting, which is true only while run() is between its own steps -- the one
+    // case where the scheduler's copy is authoritative. Without that guard this rewinds run()'s own
+    // state and the suite hangs; that was measured, which is why the guard is here.
+    if (!m_guestExecuting.load(std::memory_order_acquire))
+    {
+        if (GuestThread *main = thread(kMainThreadId))
+        {
+            main->context = m_runtime.m_cpuContext;
+        }
+    }
+
+    for (int step = 0; step < stepBudget; ++step)
+    {
+        processPendingEvents();
+        if (m_stopRequested.load(std::memory_order_acquire))
+        {
+            break;
+        }
+
+        if (m_currentThreadId == 0)
+        {
+            // The signal usually arrives with the running thread still current, but a block inside
+            // the guest will have cleared it. Re-establish the main thread so an invocation has
+            // somewhere to attach.
+            if (GuestThread *main = thread(kMainThreadId))
+            {
+                if (main->status == EeThreadStatus::Ready)
+                {
+                    removeReady(*main);
+                }
+                main->wait = {};
+                if (main->status == EeThreadStatus::Ready || main->invocations.empty())
+                {
+                    main->status = EeThreadStatus::Ready;
+                    makeRunning(*main);
+                }
+            }
+            if (m_currentThreadId == 0)
+            {
+                break; // nothing is current and nothing can be made current
+            }
+        }
+
+        GuestThread *running = currentThread();
+        if (running == nullptr)
+        {
+            break;
+        }
+
+        // A pending invocation outranks the base frame, exactly as in run().
+        if (!m_pendingInvocations.empty() && running->invocations.empty())
+        {
+            GuestInvocation invocation = std::move(m_pendingInvocations.front());
+            m_pendingInvocations.pop_front();
+            if (getRegU32(&invocation.context, 29) == 0u)
+            {
+                SET_GPR_U32(&invocation.context, 29, invocationStackTop());
+            }
+            running->invocations.push_back(std::move(invocation));
+            ranAnything = true;
+            continue;
+        }
+
+        R5900Context &context = running->activeContext();
+
+        if (context.pc == 0u)
+        {
+            if (running->invocations.empty())
+            {
+                // The base frame is finished; there is no invocation to complete.
+                break;
+            }
+            GuestInvocation completed = std::move(running->invocations.back());
+            running->invocations.pop_back();
+            ranAnything = true;
+            if (completed.onComplete)
+            {
+                try
+                {
+                    completed.onComplete(completed.context, running->activeContext());
+                }
+                catch (const EeDispatcherTransfer &)
+                {
+                }
+            }
+            if (running->invocations.empty())
+            {
+                // Back on the base frame. The caller is resumed, which is the point of the whole
+                // exercise. Safe to publish unconditionally: the entry refresh above guaranteed this
+                // frame is current whether run() or an external driver is driving.
+                copyMainContextToRuntime();
+                break;
+            }
+            continue;
+        }
+
+        if (!m_runtime.hasFunction(context.pc))
+        {
+            // A guest that branched somewhere we have no code for. Report it the same way run()
+            // does, then stop rather than spinning on it.
+            m_runtime.reportMissingFunction(m_rdram,
+                                            &context,
+                                            context.pc,
+                                            context.pc,
+                                            PS2Runtime::GuestBranchKind::DirectJump,
+                                            "EE invocation service");
+            copyMainContextToRuntime();
+            break;
+        }
+
+        PS2Runtime::RecompiledFunction function = m_runtime.lookupFunction(context.pc);
+        try
+        {
+            m_insideInterrupt = !running->invocations.empty() &&
+                                running->invocations.back().kind == GuestInvocationKind::Interrupt;
+            function(m_rdram, &context, &m_runtime);
+            m_insideInterrupt = false;
+        }
+        catch (const EeDispatcherTransfer &)
+        {
+            m_insideInterrupt = false;
+        }
+        ranAnything = true;
+    }
+
+    copyMainContextToRuntime();
+    publishSnapshot();
+    return ranAnything;
+}
+
+void EeScheduler::rollbackAbortedInlineInvocation(int threadId)
+{
+    assertExecutor();
+    if (threadId == 0)
+    {
+        return;
+    }
+    GuestThread *aborted = thread(threadId);
+    if (aborted == nullptr)
+    {
+        return;
+    }
+    // The inline attempt ended in a throw, so it never became an invocation and never owned
+    // anything. Undo only what a block changed on this thread: the wait, the status, and the fact
+    // that it stopped being current. Anything else the handler did to OTHER threads stands.
+    aborted->wait = {};
+    aborted->status = EeThreadStatus::Ready;
+    if (m_currentThreadId == 0)
+    {
+        makeRunning(*aborted);
+    }
+    publishSnapshot();
+}
