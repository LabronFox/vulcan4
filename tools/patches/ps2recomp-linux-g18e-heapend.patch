     };
+
+    // ---------------------------------------------------------------- G1.8b
+    //
+    // A syscall override is a plain synchronous call on real hardware: the guest issues `syscall`,
+    // the kernel calls the installed handler, the handler returns, and $v0 holds the result. The
+    // guest's caller frame is never unwound, because nothing unwinds it.
+    //
+    // The runtime instead deferred every override to EeScheduler::invokeCurrent, which THROWS
+    // EeDispatcherTransfer. That is the scheduler's control-transfer signal, and it is documented
+    // as "must only be caught at EeScheduler::run()". A driver that is not the scheduler -- which
+    // is exactly what tools/harness/vulcan4_harness.cpp is -- catches it itself, so the throw
+    // leaves the guest's callee frame, the queued invocation is never serviced, and the guest's
+    // own caller-saved registers never get the handler's result. GT4's syscall-override
+    // convergence loop is shaped exactly like the caller below, and its $s2/$s3 were observed
+    // reset to zero every third iteration for this reason.
+    //
+    // These two shapes are the contract any driver step must honour, asserted on the shipped
+    // driver pattern rather than on the scheduler's own loop (which was already correct).
+
+    constexpr uint32_t K_SYNC_OVERRIDE_CALLER = 0x300700u;
+    constexpr uint32_t K_SYNC_OVERRIDE_RESUME = 0x300708u;
+    constexpr uint32_t K_SYNC_OVERRIDE_HANDLER = 0x300710u;
+    constexpr uint32_t K_SYNC_OVERRIDE_SYSCALL = 0x95u;
+    constexpr uint32_t K_SYNC_OVERRIDE_RESULT = 0x1234u;
+    constexpr uint32_t K_SYNC_SENTINEL_S2 = 0xAAAA0002u;
+    constexpr uint32_t K_SYNC_SENTINEL_S3 = 0xBBBB0003u;
+    constexpr uint32_t K_SYNC_UNSET = 0xDEADBEEFu;
+
+    uint32_t gSyncHandlerRan = 0u;
+    uint32_t gSyncEscapedTransfers = 0u;
+    uint32_t gSyncCallerV0 = K_SYNC_UNSET;
+    uint32_t gSyncCallerS2 = K_SYNC_UNSET;
+    uint32_t gSyncCallerS3 = K_SYNC_UNSET;
+    uint32_t gSyncPostSyscallRan = 0u;
+
+    void syncOverrideHandler(uint8_t *, R5900Context *ctx, PS2Runtime *)
+    {
+        ++gSyncHandlerRan;
+        setReturnU32(ctx, K_SYNC_OVERRIDE_RESULT);
+        ctx->pc = getRegU32(ctx, 31); // jr $ra
+    }
+
+    // The caller is GT4's loop, in miniature, and it is shaped the way RECOMPILED code is shaped:
+    // before the call it publishes the address it must be re-entered at, and that address is a
+    // separate resume entry, not the top of the function. Getting this wrong is itself a bug -- a
+    // caller that republishes its own entry gets restarted from the top every time the driver
+    // re-enters it, which is a second way to lose $s2/$s3.
+    void syncOverrideCaller(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        setRegU32(*ctx, 18, K_SYNC_SENTINEL_S2);
+        setRegU32(*ctx, 19, K_SYNC_SENTINEL_S3);
+        ctx->pc = K_SYNC_OVERRIDE_RESUME;
+        runtime->handleSyscall(rdram, ctx, K_SYNC_OVERRIDE_SYSCALL);
+        // Unreachable in a correct run: the driver re-enters at K_SYNC_OVERRIDE_RESUME instead.
+        ++gSyncPostSyscallRan;
+    }
+
+    // The resume entry: everything after the call, which is the part that dies when the frame is
+    // lost.
+    void syncOverrideResume(uint8_t *, R5900Context *ctx, PS2Runtime *)
+    {
+        ++gSyncPostSyscallRan;
+        gSyncCallerV0 = getRegU32(ctx, 2);
+        gSyncCallerS2 = getRegU32(ctx, 18);
+        gSyncCallerS3 = getRegU32(ctx, 19);
+        ctx->pc = 0u;
+    }
+
+    // ---------------------------------------------------------------- G1.8c
+    //
+    // W6, measured on GT4: pc=0x01000008, distinct_pcs=1, 24 repeats, and sce_SetupHeap /
+    // sce_SetupThread / sce_CreateSema called 25 times each. 0x01000008 is the ELF ENTRY POINT, and
+    // a guest loop does not re-initialise its own heap. The guest is being restarted from its entry
+    // instead of resumed at the PC each frame published for itself.
+    //
+    // The shape below is that bug, made deterministic: a chain of frames, each of which publishes
+    // the next resume PC and then makes an overridden syscall. Resume correctly and the entry runs
+    // ONCE. Resume at the entry and it runs once per link, forever -- which is exactly the shape in
+    // the boot log.
+    //
+    // It also asserts WHICH context the resume PC came from, so this is a mechanism test and not a
+    // symptom test: the resume PC must be the one the frame published into the driver's own context,
+    // and GuestThread::context (the scheduler's private copy) must not be the source.
+
+    constexpr uint32_t K_CHAIN_ENTRY = 0x300800u;
+    constexpr uint32_t K_CHAIN_LINK0 = 0x300808u;
+    constexpr uint32_t K_CHAIN_LINK1 = 0x300810u;
+    constexpr uint32_t K_CHAIN_LINK2 = 0x300818u;
+    constexpr uint32_t K_CHAIN_TAIL = 0x300820u;
+    constexpr uint32_t K_CHAIN_SYSCALL = 0x96u;
+    constexpr uint32_t K_CHAIN_RESULT = 0x0BADCAFEu;
+    constexpr int K_CHAIN_LINKS = 3;
+    constexpr uint32_t K_CHAIN_S2_SEED = 0xAAAA0002u;
+    constexpr uint32_t K_CHAIN_S3_SEED = 0xBBBB0003u;
+
+    uint32_t gChainEntryEntries = 0u;
+    uint32_t gChainLinkEntries = 0u;
+    uint32_t gChainTailEntries = 0u;
+    uint32_t gChainHandlerRan = 0u;
+    uint32_t gChainV0s = 0u;
+    std::vector<uint32_t> gChainResumePcs;
+    uint32_t gChainSentinelS2 = 0u;
+    uint32_t gChainSentinelS3 = 0u;
+    uint32_t gChainS2Seed = K_CHAIN_S2_SEED;
+    uint32_t gChainS3Seed = K_CHAIN_S3_SEED;
+
+    void chainOverrideHandler(uint8_t *, R5900Context *ctx, PS2Runtime *)
+    {
+        ++gChainHandlerRan;
+        setReturnU32(ctx, K_CHAIN_RESULT);
+        ctx->pc = getRegU32(ctx, 31); // jr $ra
+    }
+
+    // One link. Every frame in the chain is the same code: publish the next resume PC, make the
+    // overridden syscall, and let the driver re-enter at what was published. The next resume PC is
+    // handed in through $a3, which no part of the chain clobbers, so the chain is data-driven and
+    // there is no per-link copy of this function to go stale.
+    void chainLink(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        ++gChainLinkEntries;
+        const uint32_t nextResume = getRegU32(ctx, 7); // $a3 = where to resume
+        ctx->pc = nextResume;
+        runtime->handleSyscall(rdram, ctx, K_CHAIN_SYSCALL);
+        // Unreachable when the driver honours the published PC. Reaching here at all means the
+        // frame was restarted rather than resumed, which is the wall.
+        gChainResumePcs.push_back(ctx->pc);
+    }
+
+    void chainEntry(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        ++gChainEntryEntries;
+        // Seeded ONCE, here, and never again. The tail proves they survived every subsequent link,
+        // so a frame that lost them mid-chain is caught rather than re-seeding over the evidence.
+        setRegU32(*ctx, 18, K_CHAIN_S2_SEED);
+        setRegU32(*ctx, 19, K_CHAIN_S3_SEED);
+        setRegU32(*ctx, 7, K_CHAIN_LINK0);
+        chainLink(rdram, ctx, runtime);
+    }
+
+    void chainLink0(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        setRegU32(*ctx, 7, K_CHAIN_LINK1);
+        chainLink(rdram, ctx, runtime);
+    }
+
+    void chainLink1(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        setRegU32(*ctx, 7, K_CHAIN_LINK2);
+        chainLink(rdram, ctx, runtime);
+    }
+
+    void chainLink2(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        setRegU32(*ctx, 7, K_CHAIN_TAIL);
+        chainLink(rdram, ctx, runtime);
+    }
+
+    void chainTail(uint8_t *, R5900Context *ctx, PS2Runtime *)
+    {
+        ++gChainTailEntries;
+        gChainV0s = getRegU32(ctx, 2);
+        gChainSentinelS2 = getRegU32(ctx, 18);
+        gChainSentinelS3 = getRegU32(ctx, 19);
+        ctx->pc = 0u;
+    }
+
+    // Drives guest code the way a driver that is not EeScheduler::run() has to. The scheduler's
+    // transfer signal is the documented way to reach the dispatcher; the driver's OBLIGATION on
+    // catching it is to let the scheduler service the invocation the guest just queued. Forgetting
+    // that second half is G1.8's wall: the syscall never returns a value, the caller's saved
+    // registers are lost, and hasInvocation() latches so every later call falls through to the
+    // builtin. tools/harness/vulcan4_harness.cpp is such a driver and now calls serviceInvocations.
+    bool driveGuestLikeTheHarness(PS2Runtime &runtime, R5900Context &ctx, uint8_t *rdram, int stepCap)
+    {
+        for (int step = 0; step < stepCap; ++step)
+        {
+            if (ctx.pc == 0u || runtime.isStopRequested())
+            {
+                return true;
+            }
+            PS2Runtime::RecompiledFunction fn = runtime.lookupFunction(ctx.pc);
+            if (fn == nullptr)
+            {
+                return false;
+            }
+            try
+            {
+                fn(rdram, &ctx, &runtime);
+            }
+            catch (const EeDispatcherTransfer &)
+            {
+                ++gSyncEscapedTransfers;
+                // The obligation. The signal means "I queued something; come and run it".
+                runtime.eeScheduler().serviceInvocations();
+            }
+        }
+        return false;
+    }
 }
 
