+// guest store, because sampling once per driver step cannot see what happens between two steps.
+//
+// ps2TraceGuestWrite is already exactly that hook: every WRITE8/16/32/64/128 macro calls it, and
+// every PS2Runtime::StoreN calls it. It was a no-op stub. Making it the observer means the hook
+// lives in a header the recompiler's generated code already includes, so it SURVIVES a
+// regeneration -- which a probe hand-injected into the generated translation unit does not, and
+// which this project already shipped once and the verifier caught in flight.
+//
+// It is a plain function pointer, not a std::function, and it is checked for null on every store:
+// the null case costs one predictable branch and changes nothing about the hot path.
+using PS2GuestStoreObserver = void (*)(uint32_t guestAddr,
+                                       uint32_t size,
+                                       uint64_t value,
+                                       const R5900Context *ctx);
+
+inline PS2GuestStoreObserver g_ps2GuestStoreObserver = nullptr;
+
+inline void ps2SetGuestStoreObserver(PS2GuestStoreObserver observer)
+{
+    g_ps2GuestStoreObserver = observer;
