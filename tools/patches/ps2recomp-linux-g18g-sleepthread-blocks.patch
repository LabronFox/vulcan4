+                                      uint64_t value,
+                                      const R5900Context *ctx);
+
+inline PS2GuestLoadObserver g_ps2GuestLoadObserver = nullptr;
+
+inline void ps2SetGuestLoadObserver(PS2GuestLoadObserver observer)
+{
+    g_ps2GuestLoadObserver = observer;
+}
+
+inline void ps2TraceGuestRead(uint32_t guestAddr,
+                              uint32_t size,
+                              uint64_t value,
+                              const R5900Context *ctx)
+{
+    if (g_ps2GuestLoadObserver != nullptr)
+    {
+        g_ps2GuestLoadObserver(guestAddr, size, value, ctx);
+    }
+}
