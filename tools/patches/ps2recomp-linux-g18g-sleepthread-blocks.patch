diff --git a/CMakeLists.txt b/CMakeLists.txt
index c7c7af5..0a0d5e4 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -79,6 +79,23 @@ if(PS2X_IS_ARM_TARGET)
     endif()
 endif()
 
+# The runtime stores R5900 GPRs in __m128i lanes and reads them back with
+# _mm_extract_epi32 / _mm_extract_epi64, which are SSE4.1 intrinsics. MSVC's x64
+# codegen and /arch:AVX2 accept them unconditionally, but GCC/Clang default to the
+# baseline x86-64 ISA (SSE2 only) and fail with:
+#   error: inlining failed in call to 'always_inline' '_mm_extract_epi32':
+#          target specific option mismatch
+# Enable the ISA the code actually uses (SSE4.1, not the /arch:AVX2 MSVC reaches
+# for) on x86 GCC/Clang. MSVC is skipped because /arch:AVX2 already covers it,
+# and ARM/Android/Vita are skipped because they go through sse2neon above.
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64|i[3-6]86)$"
+   AND NOT MSVC
+   AND NOT PS2X_IS_ARM_TARGET
+   AND NOT ANDROID)
+    add_compile_options(-msse4.1)
+    message(STATUS "x86 GCC/Clang detected - enabling SSE4.1 (required by the __m128i GPR lane accessors)")
+endif()
+
 if(PS2X_BUILD_RECOMP)
     add_subdirectory("ps2xRecomp")
 endif()
