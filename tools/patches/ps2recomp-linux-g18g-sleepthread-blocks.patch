+
+            // The value and the registers still have to survive the chain, or the fix bought
+            // correctness of PC with loss of state.
+            t.Equals(gChainHandlerRan, static_cast<uint32_t>(K_CHAIN_LINKS) + 1u,
+                     "the override handler must run once per syscall in the chain");
+            t.Equals(gChainV0s, K_CHAIN_RESULT,
+                     "$v0 must carry the handler result to the tail of the chain");
+            t.Equals(gChainSentinelS2, K_CHAIN_S2_SEED,
