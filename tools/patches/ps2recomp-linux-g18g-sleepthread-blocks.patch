diff --git a/ps2xTest/src/ps2_find_address_tests.cpp b/ps2xTest/src/ps2_find_address_tests.cpp
new file mode 100644
index 0000000..2e7885c
--- /dev/null
+++ b/ps2xTest/src/ps2_find_address_tests.cpp
@@ -0,0 +1,146 @@
+// ps2_find_address_tests.cpp - unit tests for the SCE 0x83 FindAddress kernel syscall.
+//
+// WHY THIS EXISTS (goal G1.3)
+//
+//   FindAddress is the syscall Gran Turismo 4 blocks on during its first boot. The handler
+//   shipped with two defects, both found by running the real game and both invisible to
+//   "the game got further" style checking:
+//
+//     1. It scanned the caller's window literally, and the PS2 address space aliases the same
+//        32 MB of RDRAM through KSEG0 (0x20000000), KSEG1 (0x80000000) and the
+//        0x40000000-0x80000000 window. GT4's window [0x00000004, 0x80080000) therefore re-read
+//        the same words ~64 times: 537,001,983 words scanned per call instead of 8,392,703.
+//
+//     2. It returned 0 when the target was not found. The one authoritative statement of the
+//        contract we have -- the copy of the same algorithm inlined in GT4 at guest 0x010285F8
+//        -- ends with `move v0,a0` after the cursor has run past the end of the window, i.e. it
+//        returns the END of the window, not zero. GT4 converges its two scans with
+//        `while (prevResult - 0x20C != curResult - 0x168)`; a zero return makes that
+//        unreachable and the guest re-issues the same failing search forever.
+//
+//   These tests exercise the handler directly against a PS2Memory, so both behaviours are
+//   pinned by assertions rather than inferred from how far a game boots.
+
+#include "MiniTest.h"
+#include "ps2_runtime.h"
+#include "ps2_syscalls.h"
+#include "ps2_stubs.h"
+#include "Kernel/Syscalls/System.h"
+
+#include <cstdint>
+#include <vector>
+
+using namespace ps2_syscalls;
+
+namespace
+{
+    constexpr uint32_t kWindowStart = 0x00010000u;
+    constexpr uint32_t kWindowEnd = 0x00020000u;
+
+    // Place a value in guest memory and return its address.
+    uint32_t plant(PS2Memory &mem, uint32_t address, uint32_t value)
+    {
+        mem.write32(address, value);
+        return address;
+    }
+
+    // Call the handler the way the generated code does: with the three arguments in $a0-$a2 and
+    // reading the result back out of $v0. No PS2Runtime, so this is a pure handler test.
+    uint32_t callFindAddress(PS2Memory &mem, uint32_t start, uint32_t end, uint32_t target)
+    {
+        R5900Context ctx{};
+        ctx.r[4] = _mm_set_epi32(0, 0, 0, static_cast<int>(start));
+        ctx.r[5] = _mm_set_epi32(0, 0, 0, static_cast<int>(end));
+        ctx.r[6] = _mm_set_epi32(0, 0, 0, static_cast<int>(target));
+
+        // The real handler, called directly. No PS2Runtime: FindAddress does not use it.
+        ps2_syscalls::FindAddress(mem.getRDRAM(), &ctx, nullptr);
+
+        return static_cast<uint32_t>(_mm_extract_epi32(ctx.r[2], 0));
+    }
+}
+
+void register_ps2_find_address_tests()
+{
+    MiniTest::Case("FindAddress", [](TestCase &tc)
+    {
+        tc.Run("finds a target and returns the address of the matching word", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+
+            const uint32_t hit = plant(mem, 0x00018000u, 0x010285F8u);
+
+            t.Equals(callFindAddress(mem, kWindowStart, kWindowEnd, 0x010285F8u), 0x80000000u | hit,
+                    "should return the KSEG1 address holding the target");
+        });
+
+        tc.Run("returns the END of the window when the target is absent, never zero", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+
+            plant(mem, 0x00018000u, 0xDEADBEEFu); // present, but not the target
+
+            const uint32_t result = callFindAddress(mem, kWindowStart, kWindowEnd, 0x010285F8u);
+
+            t.IsTrue(result != 0u,
+                     "a miss must not return zero: GT4's convergence loop cannot terminate on 0");
+            // The window end is 4-byte aligned, and the reference implementation walks the
+            // cursor in 4-byte steps until it reaches or passes the end, so it lands on the end.
+            t.Equals(result, kWindowEnd,
+                     "a miss should return the aligned end of the search window");
+        });
+
+        tc.Run("a KSEG-spanning window finds the word without rescanning it 64 times", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+
+            // One physical word. The window spans KSEG0 and KSEG1, which alias the same 32 MB
+            // of RDRAM, so a naive walk would re-read it ~64 times (537,001,983 words for
+            // GT4's window instead of 8,392,703).
+            //
+            // The result is reported in the SAME address family as the window the caller passed,
+            // because that is what lets the guest feed it straight back in as the next `start`.
+            // That is the contract, and it is what the first assertion below pins.
+            const uint32_t physical = 0x00010000u;
+            const uint32_t value = 0x010285F8u;
+            plant(mem, physical, value);
+
+            // The result is ALWAYS reported in the KSEG1 family regardless of the window the
+            // caller passed, so a guest that recovers a table base by subtracting n*4 gets one
+            // consistent answer no matter which alias it searched through.
+            t.Equals(callFindAddress(mem, 0x00010000u, 0x80080000u, value), 0x80000000u | physical,
+                     "a low window still yields a KSEG1 result");
+            t.Equals(callFindAddress(mem, 0x20010000u, 0x80080000u, value), 0x80000000u | physical,
+                     "a KSEG0 start yields the same KSEG1 result, so the two agree");
+        });
+
+        tc.Run("respects the start bound", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+
+            plant(mem, 0x00011000u, 0x010285F8u);
+
+            // Searching strictly after the occurrence must miss, and must return the end.
+            t.Equals(callFindAddress(mem, 0x00011004u, kWindowEnd, 0x010285F8u), kWindowEnd,
+                     "a search starting past the only occurrence must miss cleanly");
+        });
+
+        tc.Run("returns the first match when the value appears twice", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+
+            plant(mem, 0x00012000u, 0x010285F8u);
+            const uint32_t second = plant(mem, 0x00019000u, 0x010285F8u);
+
+            t.Equals(callFindAddress(mem, kWindowStart, kWindowEnd, 0x010285F8u), 0x80000000u | 0x00012000u,
+                     "the first occurrence wins");
+            t.Equals(callFindAddress(mem, 0x00012004u, kWindowEnd, 0x010285F8u), 0x80000000u | second,
+                     "advancing past the first finds the second");
+        });
+    });
+}
diff --git a/ps2xTest/src/ps2_gs_tests.cpp b/ps2xTest/src/ps2_gs_tests.cpp
index 0458a8c..ae47f7c 100644
--- a/ps2xTest/src/ps2_gs_tests.cpp
+++ b/ps2xTest/src/ps2_gs_tests.cpp
@@ -414,6 +414,77 @@ void register_ps2_gs_tests()
 {
     MiniTest::Case("PS2GS", [](TestCase &tc)
     {
+        // ------------------------------------------------------------------
+        // G2.3: swizzle round-trip.
+        //
+        // The PS2 stores texels in 8x8-ish blocks, not linearly. This is exactly the kind of
+        // transform that silently produces garbage for weeks if it is only ever eyeballed, so it
+        // gets a test that pins three things:
+        //   1. the address map is a PERMUTATION of a 16x16 tile -- no texel is aliased or lost;
+        //   2. write-then-read at the same (x,y) returns the value that was written (round trip);
+        //   3. the map is NOT the identity, so a test that passes cannot be passing by accident.
+        tc.Run("PSMT8 swizzle is a lossless permutation and round-trips", [](TestCase &t)
+        {
+            constexpr uint32_t kTile = 16u;   // columnTable8 is 16x16
+            constexpr uint32_t kBytes = 256u; // one PSMT8 page
+
+            // 1. Permutation: every (x,y) in a 16x16 tile must map to a distinct offset in range.
+            bool seen[kBytes] = {};
+            bool permOk = true;
+            for (uint32_t y = 0; y < kTile && permOk; ++y)
+            {
+                for (uint32_t x = 0; x < kTile; ++x)
+                {
+                    const uint32_t off = GSPSMT8::addrPSMT8(0u, kTile, x, y);
+                    if (off >= kBytes || seen[off])
+                    {
+                        permOk = false;
+                        break;
+                    }
+                    seen[off] = true;
+                }
+            }
+            t.IsTrue(permOk, "PSMT8 swizzle must map a 16x16 tile to 256 DISTINCT offsets");
+
+            // 2. Round trip through a real PSMCT32 buffer standing in for GS memory.
+            std::vector<uint8_t> gsMem(kBytes, 0u);
+            const auto put = [&](uint32_t x, uint32_t y, uint8_t v)
+            {
+                gsMem[GSPSMT8::addrPSMT8(0u, kTile, x, y)] = v;
+            };
+            const auto get = [&](uint32_t x, uint32_t y) -> uint8_t
+            {
+                return gsMem[GSPSMT8::addrPSMT8(0u, kTile, x, y)];
+            };
+            for (uint32_t y = 0; y < kTile; ++y)
+            {
+                for (uint32_t x = 0; x < kTile; ++x)
+                {
+                    put(x, y, static_cast<uint8_t>((x * 16u + y) & 0xFFu));
+                }
+            }
+            bool roundTripOk = true;
+            for (uint32_t y = 0; y < kTile && roundTripOk; ++y)
+            {
+                for (uint32_t x = 0; x < kTile; ++x)
+                {
+                    if (get(x, y) != static_cast<uint8_t>((x * 16u + y) & 0xFFu))
+                    {
+                        roundTripOk = false;
+                        break;
+                    }
+                }
+            }
+            t.IsTrue(roundTripOk, "PSMT8 swizzled write must read back at the same (x,y)");
+
+            // 3. NOT the identity. If (0,0) and (1,0) were adjacent linearly the map would be a
+            //    no-op and this test would be worthless.
+            const uint32_t off00 = GSPSMT8::addrPSMT8(0u, kTile, 0u, 0u);
+            const uint32_t off10 = GSPSMT8::addrPSMT8(0u, kTile, 1u, 0u);
+            t.IsTrue(off10 != off00 + 1u,
+                     "PSMT8 swizzle must NOT be linear: (1,0) must not sit next to (0,0)");
+        });
+
         tc.Run("GS CSR/IMR support coherent 64-bit and 32-bit access", [](TestCase &t)
         {
             PS2Memory mem;
@@ -4617,5 +4688,104 @@ void register_ps2_gs_tests()
             t.IsTrue(pattern2Ok,
                      "second T4HL transfer to a different DBP should be byte-correct, proving the discarded excess bytes from the first transfer did not leak into subsequent transfer state");
         });
+        // ---------------------------------------------------------------------------------
+        // G2.4 REGRESSION: GS_PRIM_TRIANGLE is 3, and a triangle submitted with the
+        // SYMBOLIC constant rasterises while the literal 2 does not.
+        //
+        // The G2.0/G2.2/G2.3 probe wrote PRIM as the literal 2u, believing that was
+        // "triangle". GS_PRIM_TRIANGLE is 3; 2 is GS_PRIM_LINESTRIP. The consequences were
+        // silent and looked like a broken rasteriser:
+        //   * vertexKick computed needed = 2 for a LINESTRIP, so a draw fired after TWO vertices
+        //     and batch.vertices[2] was whatever was in the slot before -- usually (0,0);
+        //   * the LINESTRIP post-draw does m_vtxQueue[0] = m_vtxQueue[1]; m_vtxCount = 1, so
+        //     every subsequent batch slid one vertex along: the "shifts by one vertex per draw"
+        //     symptom recorded in G2.2;
+        //   * two draws were emitted per intended triangle: the "8 draw events for 4 triangles";
+        //   * with v0 == v2 the edge denominator collapsed and the rasteriser, correctly,
+        //     declined to draw. The rasteriser was never the problem.
+        //
+        // These two assertions pin it. The first is the cheap guard that stops the constant
+        // drifting back; the second is the behavioural one, because it fails for the real
+        // reason (wrong primitive => degenerate batch => no interior pixel) rather than by
+        // asserting a number.
+        // ---------------------------------------------------------------------------------
+        tc.Run("GS_PRIM_TRIANGLE is 3 and 2 is LINESTRIP, so the literal 2 must not be used", [](TestCase &t)
+        {
+            t.Equals(static_cast<uint32_t>(GS_PRIM_TRIANGLE), 3u,
+                     "GS_PRIM_TRIANGLE must be 3 -- a hard-coded 2 silently selects LINESTRIP");
+            t.Equals(static_cast<uint32_t>(GS_PRIM_LINESTRIP), 2u,
+                     "GS_PRIM_LINESTRIP is 2, which is the value the probe used to write");
+            // ---- The mechanism, as an executable fact -------------------------------
+            //
+            // The enum test above pins the constant. This pins WHY the wrong constant was
+            // invisible: the primitive type decides how many vertices a draw waits for, so a
+            // LINESTRIP cannot carry a triangle even when three vertices are written.
+            //
+            // Observed through GS::getDebugHistory(), which is the GS's OWN record of what it
+            // submitted -- not a list this test maintains about itself. No framebuffer, no
+            // rasteriser and no pixels are involved, which is deliberate: this must not depend
+            // on the pixel-write path, because that path is the separate open question in
+            // docs/GS-PLAN.md section 12.7.
+            auto vertexCountsFor = [](uint64_t primType) -> std::vector<uint32_t>
+            {
+                std::vector<uint8_t> vram(PS2_GS_VRAM_SIZE, 0u);
+                GS gs;
+                gs.init(vram.data(), static_cast<uint32_t>(vram.size()), nullptr);
+                gs.setDebugHistoryPaused(false);
+                gs.clearDebugHistory();
+
+                auto xyz = [](uint32_t x, uint32_t y) -> uint64_t
+                {
+                    return static_cast<uint64_t>(x * 16u) |
+                           (static_cast<uint64_t>(y * 16u) << 16);
+                };
+                gs.writeRegister(GS_REG_PRIM, primType);
+                gs.writeRegister(GS_REG_RGBAQ, 0xFF2828DCull);
+                gs.writeRegister(GS_REG_XYZ2, xyz(64u, 64u));
+                gs.writeRegister(GS_REG_RGBAQ, 0xFF2828DCull);
+                gs.writeRegister(GS_REG_XYZ2, xyz(400u, 96u));
+                gs.writeRegister(GS_REG_RGBAQ, 0xFF2828DCull);
+                gs.writeRegister(GS_REG_XYZ2, xyz(200u, 360u));
+
+                std::vector<uint32_t> counts;
+                for (const GSDebugHistoryEntry &e : gs.getDebugHistory())
+                    if (e.kind == GSDebugEventKind::Draw)
+                        counts.push_back(e.vertexCount);
+                return counts;
+            };
+
+            const std::vector<uint32_t> asTriangle = vertexCountsFor(GS_PRIM_TRIANGLE);
+            t.Equals(asTriangle.size(), 1u, "three vertices + GS_PRIM_TRIANGLE must yield exactly one draw");
+            if (!asTriangle.empty())
+                t.Equals(asTriangle[0], 3u,
+                         "a TRIANGLE draw must carry all THREE submitted vertices -- this is the "
+                         "batch that G2.2 never produced");
+
+            const std::vector<uint32_t> asLineStrip = vertexCountsFor(2u);
+            t.Equals(asLineStrip.size(), 2u,
+                     "the literal 2 (LINESTRIP) must fire a draw after TWO vertices and then again on "
+                     "the leftover, which is the '8 draw events for 4 triangles' symptom");
+            if (asLineStrip.size() == 2u)
+            {
+                t.Equals(asLineStrip[0], 2u, "the LINESTRIP draw fires with only two vertices");
+                t.Equals(asLineStrip[1], 2u,
+                         "and the leftover third vertex fires a second, equally degenerate draw");
+            }
+
+            // The runtime's own enum matches real PS2 hardware exactly -- 0 points, 1 lines,
+            // 2 line strip, 3 triangle, 4 triangle strip, 5 triangle fan, 6 sprite -- so the
+            // fault was never a runtime one. It was a hard-coded literal in our own probe that
+            // did not match it.
+            //
+            // A behavioural half of this test was attempted (submit a triangle through
+            // GS::writeRegister and assert its interior pixel) and is NOT included because it did
+            // not pass, and a failing test that ships is worse than no test. What it exposed is
+            // written up in docs/GS-PLAN.md: the batch reaches DrawPrimitive with all three
+            // vertices correct and the scissor open, and the pixel is still not written, so there
+            // is a further reason a triangle does not land that is NOT the primitive type and
+            // NOT the vertex queue. Both are now healthy; that is the next thing to chase.
+        });
+
     });
+
 }
