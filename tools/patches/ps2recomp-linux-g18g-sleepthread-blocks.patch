diff --git a/ps2xRuntime/include/ps2_guest_progress.h b/ps2xRuntime/include/ps2_guest_progress.h
new file mode 100644
index 0000000..68018ac
--- /dev/null
+++ b/ps2xRuntime/include/ps2_guest_progress.h
@@ -0,0 +1,131 @@
+#ifndef PS2_GUEST_PROGRESS_H
+#define PS2_GUEST_PROGRESS_H
+
+#include <cstddef>
+#include <cstdint>
+#include <unordered_map>
+#include <vector>
+
+// ---------------------------------------------------------------------------
+// Decides when a running guest has stopped making progress.
+//
+// THE PROBLEM THIS EXISTS TO SOLVE (W7):
+// The R5900's tight loops are the game's normal workload. A rasteriser walking a
+// glyph row, a physics step, a decompressor -- all of them revisit EXACTLY the
+// same addresses while they converge. A detector that treats "this PC cycle
+// repeated" as a hang therefore stops a boot that is about to make more progress.
+// On W7 that mistake ended the boot at functions_entered=95, inside a copy loop
+// that was six iterations away from its bound.
+//
+// A PC cycle repeating is evidence of a LOOP, not of a HANG. Telling those two
+// apart needs a signal outside the PC stream: the guest reaching NEW CODE, or the
+// guest touching the hardware. Only a cycle that repeats with neither is a hang.
+// ---------------------------------------------------------------------------
+
+class PS2GuestProgress
+{
+public:
+    // A cycle must repeat this many times, with no progress anywhere inside it,
+    // before the guest is called hung.
+    void setHangThreshold(uint64_t repeats) { m_threshold = repeats; }
+
+    uint64_t hangThreshold() const { return m_threshold; }
+
+    // Record one executed PC. Returns true once the guest is proven hung.
+    //
+    // reachedNewCode must be true on the observation where the guest entered code
+    // it had not run before -- a new function, or a return into a new caller --
+    // or touched the hardware. That is progress the PC stream cannot show.
+    bool observe(uint32_t pc, bool reachedNewCode);
+
+    // The first address of the cycle the guest hung on, so the wall can be read
+    // straight off the report.
+    uint32_t hangFirstPc() const { return m_cycleFirstPc; }
+
+    // How many addresses the hanging cycle runs through.
+    uint64_t hangCycleLength() const { return m_cycleLength; }
+
+    // How many times that cycle repeated before the guest was called hung.
+    uint64_t hangRepeats() const { return m_repeats; }
+
+    // The recent PC history, oldest first. The harness uses it to decode the repeating
+    // block and name what the guest is actually waiting on.
+    const std::vector<uint32_t> &history() const { return m_history; }
+
+    void reset()
+    {
+        m_startIndex.clear();
+        m_history.clear();
+        m_cycleLength = 0;
+        m_repeats = 0;
+        m_cycleFirstPc = 0;
+    }
+
+private:
+    static constexpr std::size_t kMaxHistory = 4096;
+    static constexpr std::size_t kTrimTo = 2048;
+
+    void reindex()
+    {
+        m_startIndex.clear();
+        for (std::size_t i = 0; i < m_history.size(); ++i)
+        {
+            m_startIndex[m_history[i]] = i;
+        }
+    }
+
+    uint64_t m_threshold = 24;
+    uint64_t m_repeats = 0;
+    uint64_t m_cycleLength = 0;
+    uint32_t m_cycleFirstPc = 0;
+    std::vector<uint32_t> m_history;
+    std::unordered_map<uint32_t, std::size_t> m_startIndex;
+};
+
+inline bool PS2GuestProgress::observe(uint32_t pc, bool reachedNewCode)
+{
+    // Reaching code the guest has not run before -- or touching the hardware --
+    // breaks the streak of "cycling with nothing new happening", whatever the PC
+    // stream looks like. This is the whole point of the class: a converging loop
+    // reuses one PC cycle forever while still moving forward, and only a caller
+    // that can see the forward motion can tell it from a hang.
+    if (reachedNewCode)
+    {
+        m_repeats = 0;
+    }
+
+    const auto seen = m_startIndex.find(pc);
+    if (seen != m_startIndex.end() && seen->second < m_history.size())
+    {
+        const std::size_t length = m_history.size() - seen->second;
+        if (length > 0 && length == m_cycleLength)
+        {
+            if (++m_repeats >= m_threshold)
+            {
+                return true;
+            }
+        }
+        else if (length != m_cycleLength)
+        {
+            m_cycleLength = length;
+            m_repeats = 0;
+            m_cycleFirstPc = m_history[seen->second];
+        }
+    }
+    else
+    {
+        m_cycleLength = 0;
+        m_repeats = 0;
+    }
+
+    m_startIndex[pc] = m_history.size();
+    m_history.push_back(pc);
+    if (m_history.size() > kMaxHistory)
+    {
+        m_history.erase(m_history.begin(), m_history.begin() + static_cast<std::ptrdiff_t>(kTrimTo));
+        reindex();
+    }
+    return false;
+}
+
+#endif // PS2_GUEST_PROGRESS_H
