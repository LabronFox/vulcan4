diff --git a/ps2xTest/src/ps2_runtime_progress_tests.cpp b/ps2xTest/src/ps2_runtime_progress_tests.cpp
new file mode 100644
index 0000000..b08dd30
--- /dev/null
+++ b/ps2xTest/src/ps2_runtime_progress_tests.cpp
@@ -0,0 +1,174 @@
+#include "MiniTest.h"
+
+#include "ps2_guest_progress.h"
+
+#include <cstdint>
+#include <vector>
+
+// ---------------------------------------------------------------------------
+// G1.8f: the no-progress detector must be able to tell a CONVERGING loop from a
+// HANG, and it can only do that if it is told about progress the PC stream
+// cannot show.
+//
+// The R5900's tight loops are the game's normal workload: a rasteriser walking a
+// glyph row, a physics step, a decompressor. Those loops revisit EXACTLY the same
+// addresses while they converge, so "this PC cycle repeated" is NOT evidence of a
+// hang -- it is evidence of a loop, which may be converging or may not. Telling
+// those two apart needs a signal outside the PC stream: the guest reaching NEW
+// CODE, or the guest touching the hardware.
+//
+// W7 was this exact bug: the harness declared guest_cycle_no_progress on a
+// converging copy loop and stopped the boot at functions_entered=95. With the
+// detector taught the difference, the same boot reaches 440,483 entries.
+// ---------------------------------------------------------------------------
+
+namespace
+{
+    // The PC stream of a converging loop: the same four addresses, over and over,
+    // while the loop counter walks towards its bound.
+    std::vector<uint32_t> convergingLoopStream(std::size_t iterations)
+    {
+        std::vector<uint32_t> pcs;
+        pcs.reserve(iterations * 4u);
+        for (std::size_t i = 0; i < iterations; ++i)
+        {
+            pcs.push_back(0x0100F800u); // loop body
+            pcs.push_back(0x0100F804u); // cursor++
+            pcs.push_back(0x0100F808u); // compare and branch back
+            pcs.push_back(0x0100F864u); // outer test
+        }
+        return pcs;
+    }
+}
+
+void register_ps2_runtime_progress_tests()
+{
+    MiniTest::Case("PS2RuntimeProgress", [](TestCase &tc)
+    {
+    tc.Run("G1.8f: a converging loop that revisits one PC cycle is NOT a hang", [](TestCase &t)
+    {
+        // This is the W7 shape: a tight loop that runs long enough to look like a
+        // cycle, but converges. The guest reaches new code between stretches of
+        // the loop, so no stretch may be called a hang.
+        PS2GuestProgress progress;
+        progress.setHangThreshold(24u);
+
+        const std::vector<uint32_t> pcs = convergingLoopStream(200u);
+        bool everReportedHang = false;
+        for (std::size_t i = 0; i < pcs.size(); ++i)
+        {
+            // Repeats accumulate once per executed INSTRUCTION (every address in
+            // the cycle recurs within it), not once per pass. So progress has to
+            // arrive inside a threshold window of instructions, and the harness
+            // supplies it when the guest enters code it has not run before.
+            const bool reachedNewCode = (i % 8u) == 0u;
+            if (progress.observe(pcs[i], reachedNewCode))
+            {
+                everReportedHang = true;
+                break;
+            }
+        }
+
+        t.IsFalse(everReportedHang,
+                  "MECHANISM: a PC cycle repeating is not a hang. A converging loop "
+                  "revisits the same addresses while it converges, and calling that "
+                  "no-progress stops a boot that is about to make more progress. A "
+                  "hang is a cycle that repeats with NO new code and NO hardware "
+                  "access anywhere inside it.");
+    });
+
+    tc.Run("G1.8f: a genuine hang is still reported, and named with its first PC", [](TestCase &t)
+    {
+        // Same PC stream, but now the guest never reaches new code: this is the
+        // real hang, and the detector must still catch it.
+        PS2GuestProgress progress;
+        progress.setHangThreshold(24u);
+
+        const std::vector<uint32_t> pcs = convergingLoopStream(400u);
+        bool reportedHang = false;
+        uint32_t firstPc = 0;
+        for (const uint32_t pc : pcs)
+        {
+            if (progress.observe(pc, /*reachedNewCode=*/false))
+            {
+                reportedHang = true;
+                firstPc = progress.hangFirstPc();
+                break;
+            }
+        }
+
+        t.IsTrue(reportedHang,
+                 "a PC cycle that repeats thousands of times with no new code and no "
+                 "hardware access IS a hang, and must still be caught");
+        t.Equals(firstPc, 0x0100F800u,
+                 "the reported first PC must be the first address of the cycle, so the "
+                 "wall can be read straight off the report");
+    });
+
+    tc.Run("G1.8f: W7's measured shape -- a loop running 193 times per call -- is not a hang", [](TestCase &t)
+    {
+        // This is the shape that actually stopped the boot, measured at W7: one
+        // guest function call runs its copy loop ~193 times before it returns, so
+        // a caller's return is a rare event and the threshold must clear it.
+        // Tripping here is what halted the boot at functions_entered=95.
+        PS2GuestProgress progress;
+        progress.setHangThreshold(4096u);
+
+        const std::vector<uint32_t> pcs = convergingLoopStream(100000u);
+        bool reportedHang = false;
+        for (std::size_t call = 0; call < 1000u && !reportedHang; ++call)
+        {
+            // Each "call" runs 193 loop passes, then the guest reaches new code.
+            const std::size_t passesPerCall = 193u;
+            for (std::size_t p = 0; p < passesPerCall; ++p)
+            {
+                const std::size_t base = (call * passesPerCall + p) * 4u;
+                if (base + 3u >= pcs.size())
+                {
+                    break;
+                }
+                if (progress.observe(pcs[base + 0u], false) ||
+                    progress.observe(pcs[base + 1u], false) ||
+                    progress.observe(pcs[base + 2u], false) ||
+                    progress.observe(pcs[base + 3u], true))
+                {
+                    reportedHang = true;
+                    break;
+                }
+            }
+        }
+
+        t.IsFalse(reportedHang,
+                  "MECHANISM: one guest call running ~193 loop passes before it returns "
+                  "must not be called a hang. The return is the only progress signal, so "
+                  "the threshold has to clear a full call's internal loops -- which is "
+                  "exactly what 24 did not do, and exactly why the boot stopped at 95.");
+    });
+
+    tc.Run("G1.8f: reaching new code resets the cycle, so a long run is not a hang", [](TestCase &t)
+    {
+        // A guest that always reaches new code must never be reported as hung, no
+        // matter how many times it cycles. This is the property that keeps GT4's
+        // own loops from being mistaken for hangs.
+        PS2GuestProgress progress;
+        progress.setHangThreshold(24u);
+
+        const std::vector<uint32_t> pcs = convergingLoopStream(5000u);
+        uint64_t firstHangAt = 0;
+        for (std::size_t i = 0; i < pcs.size(); ++i)
+        {
+            if (progress.observe(pcs[i], /*reachedNewCode=*/true))
+            {
+                firstHangAt = i;
+                break;
+            }
+        }
+
+        t.Equals(firstHangAt, 0ull,
+                 "a guest that keeps reaching new code must never be reported hung. "
+                 "GT4 spends most of its time in tight loops that revisit one PC cycle "
+                 "hundreds of times while converging, so a detector that calls that a "
+                 "hang ends the boot inside the game's normal work.");
+    });
+    });
+}
diff --git a/ps2xTest/src/ps2_sif_rpc_tests.cpp b/ps2xTest/src/ps2_sif_rpc_tests.cpp
index 7242e65..4d8de05 100644
--- a/ps2xTest/src/ps2_sif_rpc_tests.cpp
+++ b/ps2xTest/src/ps2_sif_rpc_tests.cpp
@@ -626,5 +626,48 @@ void register_ps2_sif_rpc_tests()
                      "recv payload should match stack-selected transfer size");
         });
 
+        tc.Run("the no-BIOS module table supplies MTAPMAN, so the guest's load can succeed", [](TestCase &t)
+        {
+            // W11. Gran Turismo 4 asks for this driver by EXACTLY this path and then retries it
+            // forever when it fails, because its caller is `bltz $v0, 0x01000760` around the
+            // sceSifLoadModule stub at guest 0x01027C70. Measured on SCUS_973.28:
+            //
+            //   SifLoadModule a0=0x1fffe70 a1=0x0 a2=0x0 ra=0x1027eac
+            //             path="cdrom0:\\IRX\\MTAPMAN.IRX;1"   handled=1 moduleId=-1
+            //
+            // `handled` and `moduleId` come back from the same call, which is the tell: the
+            // runtime RECOGNISED the module and still could not supply it. With no IRX/ directory
+            // under the cdrom0: root the physical load cannot work, so the only thing that can
+            // serve this is the no-BIOS module table -- which is already how sio2man, xsio2man,
+            // padman, mcman, mcserv, libsd, cdvdman and the rest are served.
+            //
+            // The path is written out in full, with the device prefix, the backslashes and the
+            // ";1" version suffix, because that is what the guest passes; a test that used a
+            // tidier spelling would not prove the guest's own request is answerable.
+            TestEnv env;
+            const auto cdrom = env.runtime.loadIopModule("cdrom0:\\IRX\\MTAPMAN.IRX;1");
+            t.IsTrue(cdrom.handled,
+                     "the runtime must recognise cdrom0:\\IRX\\MTAPMAN.IRX;1 as a module load whose "
+                     "answer it owns, rather than leaving the guest to retry forever");
+            t.IsTrue(cdrom.moduleId > 0,
+                     "MTAPMAN must be loadable. Without it sceSifLoadModule returns -1 on every "
+                     "pass and Gran Turismo 4 never boots -- this is W11, measured as "
+                     "v0=0xFFFFFFFF with the guest parked in its own retry loop");
+
+            // The console's own spelling of the same driver. ps2PathLeafKey lowercases and drops
+            // ".irx", so both paths must land on the same key -- if they disagree, one of the two
+            // spellings the guest might use is silently unservable.
+            const auto rom0 = env.runtime.loadIopModule("rom0:MTAPMAN");
+            t.IsTrue(rom0.moduleId > 0,
+                     "rom0:MTAPMAN must resolve to the same module as the cdrom0: path");
+
+            // And it must be stoppable, so a guest that unloads it is not left with a module the
+            // runtime will deny ever having loaded.
+            int32_t stopResult = 0x7FFFFFFF;
+            t.IsTrue(env.runtime.stopIopModule(rom0.moduleId, &stopResult),
+                     "stopping MTAPMAN must succeed");
+            t.Equals(static_cast<int32_t>(stopResult), 0, "stopping MTAPMAN must report success");
+        });
+
     });
 }
diff --git a/ps2xTest/src/ps2_thread_block_tests.cpp b/ps2xTest/src/ps2_thread_block_tests.cpp
new file mode 100644
index 0000000..32e34fd
--- /dev/null
+++ b/ps2xTest/src/ps2_thread_block_tests.cpp
@@ -0,0 +1,904 @@
+#include "MiniTest.h"
+#include "ps2_runtime.h"
+#include "ps2_runtime_macros.h"
+#include "ps2_syscalls.h"
+#include "runtime/ee_scheduler.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <vector>
+
+// ---------------------------------------------------------------------------
+// G1.8g / W8 -- sce_SleepThread must BLOCK the calling cooperative thread.
+//
+// W8 is the first wall in this project that is a real guest-semantics bug rather than a
+// measurement artefact. Measured on GT4 (2026-09-30, 120 s boot under Xvfb, no BIOS):
+//
+//     functions_entered=44579  halt=guest_cycle_no_progress  distinct_pcs=112
+//     dispatcher_transfers=15 serviced_invocations=15
+//     total_syscall_calls=119 total_mmio_accesses=469
+//     0x32 sce_SleepThread calls=11 last_pc=0x0101f348
+//
+// 119 syscalls and 469 hardware accesses, and then the guest enters the same ~112 functions
+// for the rest of the run. Decoded from SCUS_973.28, the code it stands in is a bare idle
+// loop at guest 0x01000760:
+//
+//     0x01000760: 0000282d  move $t0, $zero
+//     0x01000764: 0c409fa6  jal  0x010027F0        ; ra = 0x01000768
+//     0x01000768: 0000302d  move $s0, $zero
+//     0x0100076c: 0440fffc  beq  $zero, $zero, 0x01000760
+//
+// so the main thread calls sce_SleepThread, the call RETURNS, and the thread is straight
+// back in its own idle loop with nothing else scheduled. On a real console the sleep parks
+// the thread and the scheduler runs somebody else; here the "return" is immediate, so the
+// main thread never yields and no other thread ever gets the CPU.
+//
+// MECHANISM, by code reading and then pinned by test. EeScheduler::sleepCurrent() does the
+// right thing: blockCurrent() marks the thread Waiting/Sleep, clears m_currentThreadId and
+// throws EeDispatcherTransfer. The un-blocking is downstream of it, in
+// EeScheduler::serviceInvocations() -- the function a NON-scheduler driver (which is exactly
+// what tools/harness/vulcan4_harness.cpp is) calls after catching the signal:
+//
+//     if (m_currentThreadId == 0) {
+//         if (GuestThread *main = thread(kMainThreadId)) {
+//             if (main->status == EeThreadStatus::Ready) removeReady(*main);
+//             main->wait = {};                        // <-- wipes the Sleep
+//             if (main->status == Ready || main->invocations.empty()) {
+//                 main->status = EeThreadStatus::Ready;
+//                 makeRunning(*main);                // <-- re-runs the thread that just asked to sleep
+//             }
+//         }
+//
+// main->invocations.empty() is true for every plain syscall, so the condition is always
+// true and the thread that called sce_SleepThread is made Running again in the very same
+// call. sce_SleepThread does not sleep. It is a no-op with bookkeeping.
+//
+// WHY THESE TESTS ARE SHAPED THE WAY THEY ARE. The obvious test -- "functions_entered goes
+// up", or "the boot takes longer" -- is the same class of mistake as the W7 detector: it
+// asserts a number instead of a behaviour, and it would have passed while the boot was
+// broken. Every assertion below is on THREAD STATE or on the ORDER frames ran in, which is
+// what "blocked" means:
+//
+//   1. a thread inside sce_SleepThread is Waiting/Sleep, and stays that way across the
+//      driver step that serviced its transfer;
+//   2. the post-sleep code does not run while the thread is asleep;
+//   3. a driver that is not EeScheduler::run() produces the SAME frame order run() does --
+//      which forces the runnable set to change, i.e. some OTHER thread gets to run;
+//   4. a woken thread resumes at the PC it published before it slept.
+// ---------------------------------------------------------------------------
+
+namespace
+{
+    constexpr uint32_t K_SLEEP_SYSCALL = 0x32u; // sce_SleepThread
+
+    constexpr uint32_t K_MAIN = 0x301200u;
+    constexpr uint32_t K_MAIN_RESUME = 0x301208u;
+    constexpr uint32_t K_WORKER = 0x301210u;
+
+    constexpr int TRACE_WORKER = 3;
+    constexpr int TRACE_MAIN_AFTER_SLEEP = 2;
+
+    std::vector<int> gTrace;
+    std::vector<int> *gTraceSink = nullptr;
+    int gWakeTarget = 0;
+    // Set when the fixture could not put a second runnable thread on the EE at all. Without it a
+    // fixture that failed to arm fails the assertions below with a message about sleeps, which
+    // sends the next reader after the wrong bug entirely.
+    bool gArmFailed = false;
+
+    void trace(int id)
+    {
+        (gTraceSink ? *gTraceSink : gTrace).push_back(id);
+    }
+
+    std::string joined(const std::vector<int> &ids)
+    {
+        std::ostringstream out;
+        out << "{";
+        for (std::size_t i = 0; i < ids.size(); ++i)
+        {
+            out << (i == 0 ? "" : " ") << ids[i];
+        }
+        out << "}";
+        return out.str();
+    }
+
+    const EeThreadSnapshot *findThread(const EeKernelSnapshot &snap, int id)
+    {
+        for (const EeThreadSnapshot &thread : snap.threads)
+        {
+            if (thread.id == id)
+            {
+                return &thread;
+            }
+        }
+        return nullptr;
+    }
+
+    // The main thread's first act: publish where it must be re-entered, then sleep.
+    // Everything after the sleep lives in K_MAIN_RESUME, so if the sleep blocks that code
+    // cannot run, and if it does not, it runs immediately. One trace entry separates them.
+    void mainSleeps(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        ctx->pc = K_MAIN_RESUME;
+        runtime->handleSyscall(rdram, ctx, K_SLEEP_SYSCALL);
+        // Unreachable in a correct run. Getting past the call at all means sce_SleepThread
+        // RETURNED instead of blocking, which is the whole wall.
+        trace(-1);
+    }
+
+    void mainAfterSleep(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        trace(TRACE_MAIN_AFTER_SLEEP);
+        ctx->pc = 0u;
+        // End the run deterministically once the real work is done. postEvent (not
+        // requestStop) because requestStop would also stop a serviceInvocations() driver
+        // before it could run this frame, and the point of test 3 is that both dispatchers
+        // run the same frames.
+        runtime->eeScheduler().postEvent(EeEvent{EeEventType::Stop, 0u, 0u});
+    }
+
+    // The other thread. On a real console this is the frame that runs while the main thread
+    // is asleep. It wakes the sleeper and then finishes.
+    void workerRuns(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        trace(TRACE_WORKER);
+        if (gWakeTarget != 0)
+        {
+            runtime->eeScheduler().wakeupThread(gWakeTarget, false);
+            gWakeTarget = 0;
+        }
+        ctx->pc = 0u;
+    }
+
+    // ---------------------------------------------------------------- G1.8g, W10
+    //
+    // A driver that yields inside a CALL CHAIN must not rewind the CALLER's registers.
+    //
+    // EeScheduler::serviceInvocations() opens, on entry and when the scheduler is not the one
+    // executing, with:
+    //
+    //     main->context = m_runtime.m_cpuContext;     // G1.8c's refresh
+    //
+    // which was correct when the only driver was EeScheduler::run(). It is not correct for a
+    // driver with its own loop, because such a driver advances EeScheduler::currentContext() --
+    // which for the main thread IS main->context -- while m_cpuContext is only republished by
+    // copyMainContextToRuntime(). The two objects diverge, and the refresh then copies the stale
+    // one over the live one at every service call.
+    //
+    // Measured on GT4 (W10): a guest function that does `jal`; its callee issues a syscall that
+    // DEFERS (so it throws EeDispatcherTransfer); the driver services it and re-enters at the
+    // callee's `jr ra`. At that instant the caller's `$ra` is the value the PREVIOUS `jal` set, its
+    // `$s2` and `$s3` are zero, and only `$v0` -- the one register the runtime writes back by hand
+    // -- is correct. The guest's own convergence loop was fine; the scheduler was rewinding it.
+    //
+    // So the contract is stated on the CALLER's frame, which is the only thing a driver can see:
+    // after a deferred syscall, every register the caller set before the call must still be there.
+
+    constexpr uint32_t K_CHAIN_CALLER = 0x301300u;
+    constexpr uint32_t K_CHAIN_RESUME = 0x301308u;
+    constexpr uint32_t K_CHAIN_HANDLER = 0x301310u;
+    constexpr uint32_t K_CHAIN_SYSCALL = 0x97u;
+    constexpr uint32_t K_CHAIN_RESULT = 0x0BADF00Du;
+    constexpr uint32_t K_CHAIN_S2 = 0xAAAA0002u;
+    constexpr uint32_t K_CHAIN_S3 = 0xBBBB0003u;
+
+    bool gChainFrameSelectionOk = false;
+    bool gChainResumeRan = false;
+    uint32_t gChainS2AtResume = 0u;
+    uint32_t gChainS3AtResume = 0u;
+    uint32_t gChainV0AtResume = 0u;
+    uint32_t gChainRaAtResume = 0u;
+
+    void chainHandler(uint8_t *, R5900Context *ctx, PS2Runtime *)
+    {
+        setReturnU32(ctx, K_CHAIN_RESULT);
+        ctx->pc = 0u;
+    }
+
+    // Shaped like recompiled code: a `jal` sets $ra, the callee defers, and on resume the caller
+    // carries on at the PC it published. The registers are seeded HERE, before the call, which is
+    // the only place a correct implementation could lose them.
+    void chainCaller(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        SET_GPR_U32(ctx, 18, K_CHAIN_S2);
+        SET_GPR_U32(ctx, 19, K_CHAIN_S3);
+        SET_GPR_U32(ctx, 31, K_CHAIN_RESUME);
+        ctx->pc = K_CHAIN_RESUME;
+        runtime->handleSyscall(rdram, ctx, K_CHAIN_SYSCALL);
+        gChainResumeRan = true; // unreachable in a correct run
+    }
+
+    void chainResume(uint8_t *, R5900Context *ctx, PS2Runtime *)
+    {
+        gChainResumeRan = true;
+        gChainS2AtResume = getRegU32(ctx, 18);
+        gChainS3AtResume = getRegU32(ctx, 19);
+        gChainV0AtResume = getRegU32(ctx, 2);
+        gChainRaAtResume = getRegU32(ctx, 31);
+        ctx->pc = 0u;
+    }
+
+    struct ChainEnv
+    {
+        std::vector<uint8_t> rdram;
+        PS2Runtime runtime;
+
+        ChainEnv() : rdram(PS2_RAM_SIZE, 0) {}
+
+        void arm()
+        {
+            gChainResumeRan = false;
+            gChainS2AtResume = 0u;
+            gChainS3AtResume = 0u;
+            gChainV0AtResume = 0u;
+            gChainRaAtResume = 0u;
+            runtime.setMissingFunctionPolicy(PS2Runtime::MissingFunctionPolicy::Stop);
+            runtime.registerFunction(K_CHAIN_CALLER, chainCaller);
+            runtime.registerFunction(K_CHAIN_RESUME, chainResume);
+            runtime.registerFunction(K_CHAIN_HANDLER, chainHandler);
+            runtime.setEeSyscallOverride(rdram.data(), K_CHAIN_SYSCALL, K_CHAIN_HANDLER);
+            runtime.cpu().pc = K_CHAIN_CALLER;
+            runtime.eeScheduler().reset(rdram.data(), runtime.cpu());
+
+            // reset() leaves m_currentThreadId at 0, which is a SENTINEL, not the main thread --
+            // EeScheduler::kMainThreadId is 1. So currentContext() returns nullptr until some
+            // thread is actually made Running, and a driver that falls back to runtime.cpu() on
+            // nullptr dispatches a DIFFERENT frame than the scheduler chose. That fallback is what
+            // made this test blind: the guest ran on m_cpuContext, the entry refresh then copied
+            // that same live frame over GuestThread::context, and the "rewind" it was supposed to
+            // detect turned into a no-op resync.
+            //
+            // bindMainContextForSyscall is the console's own way of establishing the main thread as
+            // current, so calling it here is using the product, not a back door.
+            runtime.eeScheduler().bindMainContextForSyscall(runtime.cpu(), rdram.data());
+            gChainFrameSelectionOk = runtime.eeScheduler().currentContext() != nullptr;
+
+            // Only now is the driver genuinely in the `true` configuration: every dispatch reads
+            // EeScheduler::currentContext(), so GuestThread::context is the live frame and
+            // m_cpuContext is the stale one.
+            runtime.eeScheduler().setDriverAdvancesSchedulerContext(true);
+        }
+    };
+
+    // The shipped driver pattern, verbatim: the frame is re-read from the scheduler EVERY
+    // iteration, because a reference captured outside the loop is a stale frame wearing the right
+    // name. That re-read is exactly what exposes the rewind, so a test that drives a private copy
+    // instead would assert the broken behaviour and pass.
+    void driveLikeTheShippedDriver(ChainEnv &env, int stepBudget)
+    {
+        for (int step = 0; step < stepBudget; ++step)
+        {
+            R5900Context *const frame = env.runtime.eeScheduler().currentContext();
+            if (frame == nullptr)
+            {
+                // NO silent fallback. Falling back to runtime.cpu() here would run a different
+                // frame from the one the scheduler selected, which is W9a all over again, and it
+                // would also quietly run this test in the `false` configuration -- the one where
+                // serviceInvocations()'s refresh is a RESYNC and therefore harmless. Measured: with
+                // a fallback in place this fixture dispatched on runtime.cpu(), EeScheduler's
+                // refresh "fixed" nothing because m_cpuContext was the LIVE frame, and the suite
+                // stayed green with the guard reverted. A driver that quietly changes frames is
+                // the bug this whole test exists to catch, so it is a hard stop instead.
+                return;
+            }
+            if (frame->pc == 0u || env.runtime.isStopRequested())
+            {
+                return;
+            }
+            PS2Runtime::RecompiledFunction fn = env.runtime.lookupFunction(frame->pc);
+            if (fn == nullptr)
+            {
+                return;
+            }
+            try
+            {
+                fn(env.rdram.data(), frame, &env.runtime);
+            }
+            catch (const EeDispatcherTransfer &)
+            {
+                env.runtime.eeScheduler().serviceInvocations();
+            }
+        }
+    }
+
+    struct BlockEnv
+    {
+        std::vector<uint8_t> rdram;
+        PS2Runtime runtime;
+
+        BlockEnv() : rdram(PS2_RAM_SIZE, 0) {}
+
+        void arm()
+        {
+            gTrace.clear();
+            gWakeTarget = 0;
+            gArmFailed = false;
+            runtime.setMissingFunctionPolicy(PS2Runtime::MissingFunctionPolicy::Stop);
+            runtime.registerFunction(K_MAIN, mainSleeps);
+            runtime.registerFunction(K_MAIN_RESUME, mainAfterSleep);
+            runtime.registerFunction(K_WORKER, workerRuns);
+            // The main frame IS PS2Runtime::m_cpuContext, exactly as tools/harness/
+            // vulcan4_harness.cpp sets it up (harness line: R5900Context &ctx = runtime.cpu()).
+            // A driver that advances a private copy is a different bug, and one this test
+            // must not accidentally model.
+            runtime.cpu().pc = K_MAIN;
+            runtime.eeScheduler().reset(rdram.data(), runtime.cpu());
+        }
+
+        // Priority 1, not 0. EeScheduler::createThread rejects anything below 1, because 0 is
+        // the main thread's priority and a second thread at the same priority is not a thing
+        // the PS2 ABI has. 1 is also the LOWEST legal priority, so the worker does not request
+        // preemption of the main thread and the frame order below is not perturbed by a
+        // scheduling decision that has nothing to do with what is under test.
+        void addWorker()
+        {
+            const int worker = runtime.eeScheduler().createThread(
+                EeThreadCreateParams{0u, K_WORKER, 0x20000u, 0x800u, 0u, 1, 0u});
+            const int started = runtime.eeScheduler().startThread(worker, 0u, runtime.cpu(), false);
+            if (started != 0 || worker <= EeScheduler::kMainThreadId)
+            {
+                gArmFailed = true;
+            }
+        }
+
+        EeKernelSnapshot snapshot() const
+        {
+            return runtime.eeScheduler().snapshot();
+        }
+    };
+
+    // The shape tools/harness/vulcan4_harness.cpp uses: the driver owns the loop, catches
+    // EeDispatcherTransfer itself, and services what the guest queued.
+    //
+    // The canDispatchGuest() gate is part of the shape, not an extra. It is how a driver that is
+    // not EeScheduler::run() learns that the frame it is holding belongs to a parked thread --
+    // EeScheduler::canDispatchGuest() is the runtime's answer, so every driver gets the same one
+    // instead of each re-deriving the rule. A driver that omits it re-enters a sleeping frame, and
+    // the test below is what catches that.
+    void driveLikeTheHarness(BlockEnv &env, int stepBudget)
+    {
+        for (int step = 0; step < stepBudget; ++step)
+        {
+            R5900Context &ctx = env.runtime.cpu();
+            if (ctx.pc == 0u || env.runtime.isStopRequested())
+            {
+                return;
+            }
+            if (!env.runtime.eeScheduler().canDispatchGuest())
+            {
+                // Parked, with nothing else runnable. A real driver stops here and says so.
+                env.runtime.eeScheduler().postEvent(EeEvent{EeEventType::Stop, 0u, 0u});
+                return;
+            }
+            PS2Runtime::RecompiledFunction fn = env.runtime.lookupFunction(ctx.pc);
+            if (fn == nullptr)
+            {
+                return;
+            }
+            try
+            {
+                fn(env.rdram.data(), &ctx, &env.runtime);
+            }
+            catch (const EeDispatcherTransfer &)
+            {
+                env.runtime.eeScheduler().serviceInvocations();
+            }
+        }
+    }
+}
+
+void register_ps2_thread_block_tests()
+{
+    MiniTest::Case("PS2ThreadBlock", [](TestCase &tc)
+    {
+        tc.Run("G1.8g: a thread inside sce_SleepThread is Waiting/Sleep, not Ready", [](TestCase &t)
+        {
+            // The floor under everything else: sce_SleepThread has to leave the thread in a
+            // state the scheduler will not pick. If it leaves it Ready, no amount of work
+            // downstream in the driver can make the guest yield.
+            BlockEnv env;
+            env.arm();
+
+            R5900Context &ctx = env.runtime.cpu();
+            PS2Runtime::RecompiledFunction fn = env.runtime.lookupFunction(K_MAIN);
+            bool threw = false;
+            try
+            {
+                fn(env.rdram.data(), &ctx, &env.runtime);
+            }
+            catch (const EeDispatcherTransfer &)
+            {
+                threw = true;
+            }
+
+            t.IsTrue(threw, "sce_SleepThread must hand control back to the dispatcher, not return");
+
+            const EeThreadSnapshot *main = findThread(env.snapshot(), EeScheduler::kMainThreadId);
+            t.IsTrue(main != nullptr, "the main thread must be visible in the snapshot");
+            if (main == nullptr)
+            {
+                return;
+            }
+            t.IsTrue(main->status == EeThreadStatus::Waiting,
+                     "MECHANISM: after sce_SleepThread the calling thread must be Waiting. Ready "
+                     "means the scheduler may dispatch it again immediately, which is a sleep "
+                     "that does not sleep.");
+            t.IsTrue(main->waitReason == EeWaitReason::Sleep,
+                     "the wait must be recorded as a Sleep, so a later wakeupThread knows what it "
+                     "is releasing");
+        });
+
+        tc.Run("G1.8g: a driver servicing the transfer must not re-enter the sleeping thread",
+               [](TestCase &t)
+        {
+            // Exactly what the harness does after catching the signal, and the shape that
+            // made sce_SleepThread a no-op. serviceInvocations() is the only thing between
+            // blockCurrent() and the thread running again, so this is where it has to stop.
+            BlockEnv env;
+            env.arm();
+
+            driveLikeTheHarness(env, 64);
+
+            const EeThreadSnapshot *main = findThread(env.snapshot(), EeScheduler::kMainThreadId);
+            const bool ranAfterSleep =
+                std::find(gTrace.begin(), gTrace.end(), TRACE_MAIN_AFTER_SLEEP) != gTrace.end();
+
+            t.IsTrue(!ranAfterSleep,
+                     "MECHANISM: the code after sce_SleepThread must not run while the thread is "
+                     "asleep. A driver that services the transfer and then re-enters the same "
+                     "frame has turned the sleep into a no-op and the main thread never yields -- "
+                     "which is W8, measured as 44579 guest entries against 119 syscalls");
+            t.IsTrue(!std::count(gTrace.begin(), gTrace.end(), -1),
+                     "the sce_SleepThread call must never RETURN to its caller. Getting past the "
+                     "call at all is the bug, not a detail of it.");
+            t.IsTrue(main != nullptr && main->status == EeThreadStatus::Waiting,
+                     "the sleeping thread must still be Waiting after the driver serviced its "
+                     "transfer; Ready here means it was resurrected");
+        });
+
+        tc.Run("G1.8g: with the main thread asleep, a driver runs the OTHER thread and then the woken one",
+               [](TestCase &t)
+        {
+            // The strongest form of the contract, and the one that cannot be satisfied by
+            // tweaking a counter. Same guest program, two dispatchers, one expected order:
+            //
+            //   main sleeps  ->  worker runs  ->  worker wakes main  ->  main resumes
+            //
+            // For that to happen the runnable set has to change, so a thread OTHER than the
+            // one that called sce_SleepThread must get the CPU. If the sleeping thread is
+            // simply re-run, the worker is never dispatched and the order collapses.
+            //
+            // Why this does not compare against EeScheduler::run() directly: run() is the
+            // console's dispatcher and is DESIGNED never to return, so calling it here either
+            // hangs the suite or needs a detached thread whose runtime would then be destroyed
+            // underneath it. That is not a test, it is a coin toss. What the driver must be
+            // held to is stated behaviourally instead, and the scheduler's own tests already
+            // cover run()'s order directly.
+            //
+            // While the main thread is asleep and the worker is Ready, the runtime must say
+            // "you may dispatch" -- and the only frame it may dispatch is the worker's.
+            BlockEnv viaDriver;
+            viaDriver.arm();
+            viaDriver.addWorker();
+            t.IsTrue(!gArmFailed,
+                     "the fixture must be able to create and start a second runnable thread; if it "
+                     "cannot, every assertion below is measuring the wrong thing");
+            gWakeTarget = EeScheduler::kMainThreadId;
+            R5900Context &driverCtx = viaDriver.runtime.cpu();
+            PS2Runtime::RecompiledFunction sleeper = viaDriver.runtime.lookupFunction(K_MAIN);
+            try
+            {
+                sleeper(viaDriver.rdram.data(), &driverCtx, &viaDriver.runtime);
+            }
+            catch (const EeDispatcherTransfer &)
+            {
+            }
+            t.IsTrue(viaDriver.runtime.eeScheduler().canDispatchGuest(),
+                     "with the main thread asleep and a worker Ready the runtime must still say the "
+                     "guest can be dispatched -- otherwise a driver stops the whole EE the moment "
+                     "one thread sleeps, which is the opposite bug and just as wrong");
+            t.IsTrue(std::find(gTrace.begin(), gTrace.end(), TRACE_WORKER) == gTrace.end(),
+                     "nothing may have run yet: the main thread is still parked");
+
+            // Now let the driver do what the harness does.
+            viaDriver.arm();
+            viaDriver.addWorker();
+            gWakeTarget = EeScheduler::kMainThreadId;
+            driveLikeTheHarness(viaDriver, 256);
+            const std::vector<int> driverOrder = gTrace;
+
+            const std::vector<int> expected{TRACE_WORKER, TRACE_MAIN_AFTER_SLEEP};
+            t.IsTrue(driverOrder == expected,
+                     ("MECHANISM: the frame order a driver that is not run() produces must be "
+                      "worker-then-resumed-main. A sleeping thread that is re-entered instead of "
+                      "left Waiting never lets another thread run, and that is W8. Got "
+                      + joined(driverOrder) + " want " + joined(expected))
+                         .c_str());
+        });
+
+        tc.Run("G1.8g: a woken thread resumes at the PC it published before it slept", [](TestCase &t)
+        {
+            // The other half of the contract, and the one that makes a real sleep/wake pair
+            // work rather than just parking the thread forever: a thread parked by
+            // sce_SleepThread comes back at the instruction after the call, and does not run
+            // anything in between.
+            BlockEnv env;
+            env.arm();
+
+            R5900Context &ctx = env.runtime.cpu();
+            PS2Runtime::RecompiledFunction fn = env.runtime.lookupFunction(K_MAIN);
+            try
+            {
+                fn(env.rdram.data(), &ctx, &env.runtime);
+            }
+            catch (const EeDispatcherTransfer &)
+            {
+            }
+
+            // Exactly what the harness does after catching the signal. It matters here: the
+            // blocked thread's registers live in the driver's live frame until the scheduler
+            // copies them into the thread record, so a test that skips the service step is
+            // asserting about a frame the driver never wrote.
+            env.runtime.eeScheduler().serviceInvocations();
+
+            const GuestThread *parked = env.runtime.eeScheduler().thread(EeScheduler::kMainThreadId);
+            t.IsTrue(parked != nullptr, "the main thread must still exist while it sleeps");
+            if (parked == nullptr)
+            {
+                return;
+            }
+            t.Equals(parked->context.pc, K_MAIN_RESUME,
+                     "the parked frame must hold the PC the guest published before the syscall, or "
+                     "waking the thread resumes it in the wrong place");
+
+            const int woken = env.runtime.eeScheduler().wakeupThread(EeScheduler::kMainThreadId, false);
+            t.Equals(woken, 0, "waking a sleeping thread must succeed");
+            t.IsTrue(env.runtime.eeScheduler().thread(EeScheduler::kMainThreadId)->status
+                         == EeThreadStatus::Ready,
+                     "a woken thread must become Ready so the scheduler can pick it");
+
+            gTrace.clear();
+            env.runtime.cpu().pc = K_MAIN_RESUME;
+            env.runtime.lookupFunction(K_MAIN_RESUME)(env.rdram.data(), &env.runtime.cpu(),
+                                                      &env.runtime);
+            t.IsTrue(std::find(gTrace.begin(), gTrace.end(), TRACE_MAIN_AFTER_SLEEP) != gTrace.end(),
+                     "after the wake the thread must run the post-sleep frame, not nothing");
+        });
+        tc.Run("G1.8j: preemption is by priority NUMBER, and lower priority never takes the CPU",
+               [](TestCase &t)
+        {
+            // Item 1 of the "Next, in order" list asked for requestPreemptionIfHigher's guard to go
+            // from >= to <=. This test is the evidence that it must not, and it gates both versions.
+            //
+            // The PS2 EE orders priorities by NUMBER, ascending:
+            //
+            //   ps2sdk, ee/kernel: "0 - 127 (lower number is higher priority, but 0 is reserved by
+            //     the kernel)"
+            //   PS2Tek, BIOS EE Threading, reschedule(): "Loop through active thread priority list,
+            //     starting from 0 (highest priority)"
+            //
+            // A Ready thread preempts the Running one iff ready.number < running.number, so
+            // requestPreemptionIfHigher's guard -- `if (ready >= running) return;`, proceeding only
+            // when ready < running -- is already correct. `<=` does not merely add preemption on
+            // equal priority, it INVERTS the test: it proceeds only when ready > running, i.e. when
+            // the newly Ready thread is the LOWER priority. Measured: the suite falls to 465/468,
+            // breaking both FIFO waiter tests and "starting a strictly higher-priority thread
+            // preempts immediately".
+            //
+            // hasReadyAtOrAbovePriority is correct for the same reason and is NOT the partner bug the
+            // list suspected. "At or above priority p" is the set {0..p} because smaller is higher, so
+            // scanning `for (i = 0; i <= p; ++i)` asks the right question; scanning upward would ask
+            // about threads LOWER than p.
+
+            // HONEST SCOPE, because a test that cannot fail on a regression is worse than no test.
+            // This one does NOT discriminate `>=` from `<=`. Measured, with `<=` applied to the guard
+            // ALONE: this test still passes and the suite falls to 465/468, and the three failures
+            // are the ones that actually pin the behaviour --
+            //   "starting a strictly higher-priority thread preempts immediately"
+            //   "semaphore waiters are FIFO and signal transfers one token directly"
+            //   "event waiters are FIFO and clear modes apply before testing the next waiter"
+            // Those three are the gate. Why `<=` slips past here: it is a full inversion rather than
+            // an equal-priority special case, and a preempt only ever re-selects through
+            // selectReady(), which walks m_readyQueues from index 0 upward and so hands the CPU back
+            // to the highest-priority READY thread regardless of which thread asked for it. With one
+            // Ready thread either way, both guards land on the same answer. What this test adds is
+            // the rule written down, plus the two cases a reader would otherwise have to reconstruct
+            // from the other three.
+            //
+            // Both threads' frames are parked at pc = 0 first. serviceInvocations() is NOT a neutral
+            // "apply the flag" call -- it runs guest frames -- and three earlier versions of this test
+            // were fooled by that: one read currentThreadId() without servicing, one left the reschedule
+            // flag latched from an earlier step so the next assertion passed on a stale flag, and one
+            // let the main thread execute and finish. None of them could tell a correct guard from an
+            // inverted one. With pc = 0 the scheduler's choice is the only thing that can move.
+            BlockEnv env;
+            env.arm();
+            EeScheduler &ee = env.runtime.eeScheduler();
+            ee.bindMainContextForSyscall(env.runtime.cpu(), env.rdram.data());
+            const int mainId = EeScheduler::kMainThreadId;
+
+            auto park = [&ee](int id)
+            {
+                GuestThread *th = ee.thread(id);
+                if (th != nullptr)
+                {
+                    th->context.pc = 0u;
+                }
+            };
+
+            int ignored = -1;
+            t.Equals(ee.changePriority(mainId, 40, false, ignored), 0, "pin the main thread at 40");
+            const int worker = ee.createThread(EeThreadCreateParams{0, K_WORKER, 0x20000u, 0x800u, 0, 80, 0});
+            t.IsTrue(worker > 0, "the fixture must create the worker");
+            if (worker <= 0)
+            {
+                return;
+            }
+            t.Equals(ee.startThread(worker, 0u, env.runtime.cpu(), false), 0, "and start it");
+
+            park(mainId);
+            park(worker);
+            t.Equals(ee.currentThreadId(), mainId,
+                     "a Ready thread at 80 must NOT take the CPU from the running thread at 40: 80 is "
+                     "the lower priority, because a smaller number is a higher priority here. This is "
+                     "the assertion that fails under the <= guard");
+
+            t.Equals(ee.changePriority(worker, 20, false, ignored), 0, "raise the worker above main");
+            park(mainId);
+            park(worker);
+            ee.serviceInvocations();
+            t.Equals(ee.currentThreadId(), worker,
+                     "and a Ready thread at 20 MUST take it: 20 is the higher priority. This is the "
+                     "case the >= guard already handles correctly");
+
+            t.Equals(ee.changePriority(mainId, 20, false, ignored), 0, "now make them equal at 20");
+            park(mainId);
+            park(worker);
+            ee.serviceInvocations();
+            t.Equals(ee.currentThreadId(), worker,
+                     "a Ready thread at the SAME priority must not displace the running one -- "
+                     "sceRotateThreadReadyQueue exists precisely because the console never rotates "
+                     "the ready queue by itself at one priority, so this is load-bearing");
+        });
+
+        tc.Run("G1.8i: sceChangeThreadPriority returns the PREVIOUS priority, not 0", [](TestCase &t)
+        {
+            // W13, and this is the actual cause. Gran Turismo 4's idle loop, read from the
+            // generated decode of sub_01011508:
+            //
+            //   010115d0  jal   func_101F2B0                        # sceChangeThreadPriority
+            //   010115d4  addiu $a1, $zero, 0x1   (Delay Slot)      # priority 1  -- wake up
+            //   010115d8  daddu $s5, $v0, $zero                     # $s5 = the RETURN VALUE
+            //   ...
+            //   0101160c  nor   $v0, $zero, $s2
+            //   01011610  movz  $s2, $s5, $v0                       # if $s2 == 0, $s2 = $s5
+            //   01011614  addiu $v0, $zero, -0x1
+            //   01011618  beq   $s2, $v0, skip                      # -1 means "nothing to restore"
+            //   01011620  jal   func_101F2B0                        # sceChangeThreadPriority
+            //   01011624  daddu $a1, $s2, $zero      (Delay Slot)   # priority $s2 -- restore
+            //
+            // The guest takes the return value of the first call and feeds it straight back in as
+            // the next call's PRIORITY. So the return value is not a status code, it is the thread's
+            // previous priority -- which is what the console's syscall actually returns, and it is
+            // how the guest learns what priority to come back to.
+            //
+            // changePriorityImpl() discards it:
+            //
+            //   int oldPriority = 0;
+            //   const int result = ee.changePriority(id, priority, interruptSafe, oldPriority);
+            //   setReturnS32(ctx, result);
+            //
+            // EeScheduler::changePriority() computes oldPriority correctly and then changePriorityImpl
+            // throws it away, so the guest is told 0. The guest then restores itself to priority 0 --
+            // the highest priority in the system and reserved by the kernel -- and is refused with
+            // -403, forever.
+            //
+            // Measured on SCUS_973.28: 2,253,727 calls to sceChangeThreadPriority, essentially all
+            // of them this restore attempt, the thread pinned at prio1, sce_SleepThread called
+            // ONCE in 90 seconds, and no GS activity at all. 99.9998 % of all guest syscalls were
+            // this call and sce_GetThreadId. It looked like the game refusing to yield. It was the
+            // game correctly trying to yield and us answering with the wrong number.
+            // Through the SYSCALL, because that is where the value is thrown away. Calling
+            // EeScheduler::changePriority directly passes: it fills oldPriority in correctly. The
+            // loss is one layer up, in changePriorityImpl:
+            //
+            //   int oldPriority = 0;
+            //   const int result = ee.changePriority(id, priority, interruptSafe, oldPriority);
+            //   setReturnS32(ctx, result);          // <- oldPriority never reaches the guest
+            //
+            // So the test drives sceChangeThreadPriority the way the guest does, with $a0 = thread
+            // id and $a1 = priority, through PS2Runtime::handleSyscall with syscall number 0x29 --
+            // which is exactly what sub_0101F2B0 does: addiu $v1,$zero,0x29; syscall.
+            BlockEnv env;
+            env.arm();
+            EeScheduler &ee = env.runtime.eeScheduler();
+            ee.bindMainContextForSyscall(env.runtime.cpu(), env.rdram.data());
+            const int mainId = EeScheduler::kMainThreadId;
+
+            auto call = [&](uint32_t id, uint32_t priority)
+            {
+                R5900Context ctx = env.runtime.cpu();
+                ctx.pc = 0x0101F2B0u;
+                SET_GPR_U32(&ctx, 4, id);
+                SET_GPR_U32(&ctx, 5, priority);
+                env.runtime.handleSyscall(env.rdram.data(), &ctx, 0x29u);
+                return static_cast<int32_t>(getRegU32(&ctx, 2));
+            };
+
+            // reset() leaves the main thread at priority 0, so 0 is genuinely its previous priority
+            // on the very first call. Asserting that explicitly, because "0 is also the reserved
+            // slot" is exactly the confusion that produced the wrong fix earlier today: here 0 is a
+            // correct RETURN value, and the thing that must never be accepted as a priority argument.
+            t.Equals(call(static_cast<uint32_t>(mainId), 0x40u), 0,
+                     "the first call must report the priority the thread actually had, which "
+                     "reset() leaves at 0 -- not a status code");
+            {
+                const GuestThread *main = ee.thread(mainId);
+                t.IsTrue(main != nullptr && main->currentPriority == 0x40,
+                         "and the thread's priority must really have changed to 0x40");
+            }
+
+            // The round trip the guest actually performs: drop to 1, then restore.
+            t.Equals(call(static_cast<uint32_t>(mainId), 1u), 0x40,
+                     "dropping to priority 1 must report the priority it came from");
+            t.Equals(call(static_cast<uint32_t>(mainId), 0x40u), 1,
+                     "and restoring must report the priority it came from, so the loop is stable "
+                     "instead of walking downwards into the reserved slot");
+        });
+
+        tc.Run("G1.8i: priority 0 is the kernel's own, and a user thread may not take it", [](TestCase &t)
+        {
+            // W13, CORRECTED. An earlier version of this test asserted that sceChangeThreadPriority
+            // must ACCEPT 0, on the claim that 0 is the PS2's lowest legal priority. That claim was
+            // wrong and the test enshrined the error. The hardware is the other way round:
+            //
+            //   ps2sdk, ee/kernel, thread.initial_priority: "0 - 127 (lower number is higher
+            //     priority, but 0 is reserved by the kernel)."
+            //   ps2sdk, kernel.h: "#define MAX_PRIORITY 128"
+            //   PS2Tek, BIOS EE Threading, reschedule(): "Loop through active thread priority list,
+            //     starting from 0 (highest priority)."
+            //   PS2Tek, BIOS EE Syscalls, 07h ExecPS2: "Creates a thread with priority 0 (main
+            //     thread)."
+            //
+            // So 0 is the HIGHEST priority and the kernel reserves it. KE_ILLEGAL_PRIORITY (-403)
+            // is the correct answer, and this repository's own convention agrees: priority 20 is
+            // called "low" and priority 5 "high" in ps2_runtime_kernel_tests.cpp.
+            //
+            // This test now pins the real behaviour, and it is the test that would have caught the
+            // bad fix: allowing 0 handed the CPU to the single highest-priority thread in the system.
+            BlockEnv env;
+            env.arm();
+            EeScheduler &ee = env.runtime.eeScheduler();
+            ee.bindMainContextForSyscall(env.runtime.cpu(), env.rdram.data());
+            int ignored = -1;
+
+            t.Equals(ee.changePriority(EeScheduler::kMainThreadId, 0, false, ignored), -403,
+                     "priority 0 is reserved by the EE kernel and must be refused with "
+                     "KE_ILLEGAL_PRIORITY. Gran Turismo 4 asks for it 3,004,970 times, which is why "
+                     "the argument being read as 'priority' is the open question in the handoff");
+
+            // The range either side of the reserved slot, so this is a boundary test and not a
+            // blanket refusal.
+            t.Equals(ee.changePriority(EeScheduler::kMainThreadId, -1, false, ignored), -403,
+                     "a negative priority is illegal");
+            t.Equals(ee.changePriority(EeScheduler::kMainThreadId, 1, false, ignored), 0,
+                     "1 is the highest priority a user thread may take");
+            t.Equals(ee.changePriority(EeScheduler::kMainThreadId, EeScheduler::kPriorityCount, false, ignored), -403,
+                     "kPriorityCount (128) is out of range; the hardware has 0..127");
+            t.Equals(ee.changePriority(EeScheduler::kMainThreadId, EeScheduler::kPriorityCount - 1, false, ignored), 0,
+                     "and 127 -- the lowest-priority real level -- must be accepted");
+        });
+
+        tc.Run("G1.8g: EE time crossing a VBlank deadline must tell the driver to come back", [](TestCase &t)
+        {
+            // W12. On hardware the EE clock is the wall clock: a VBlank happens because time
+            // passed, not because the program cooperated.
+            //
+            // This runtime charges EE time at guest call boundaries -- kGuestDispatchCycles, 8
+            // cycles a transfer, from dispatchGuestBranch(). The ONLY other caller of
+            // accountCycles() is waitForEvent(), which only EeScheduler::run() reaches, and only
+            // on the branch where it has nothing to dispatch.
+            //
+            // So for a driver that does not call run(), time turns into events in exactly one
+            // place: checkpointDue() noticing that m_eeCycle just passed m_nextDeadlineCycle. That
+            // check does not exist. m_checkpointPending is only computed inside
+            // processPendingEvents(), and processPendingEvents() only runs when the driver has
+            // ALREADY come back to service a transfer. So the driver is never told to come back for
+            // time, never comes back, and time never becomes events. Circular.
+            //
+            // Measured on SCUS_973.28: 20,000,000 guest entries, 4111 serviced service frames and
+            // vsync_tick=1 after 54 SECONDS of wall clock, with ee_cycle=98,464,696 sitting ten
+            // VBlank periods past next_event_cycle=9,830,598. GT4 spends its idle loop waiting for
+            // the next frame, the frame never arrives, and it spins instead: 798,251 calls to
+            // sce_ChangeThreadPriority and 1,064,347 to syscall 0x2f.
+            //
+            // This test deliberately NEVER calls serviceInvocations(). A version that services its
+            // own yield passes while the product is broken, which is exactly what the first
+            // version of this test did.
+            BlockEnv env;
+            env.arm();
+            env.runtime.eeScheduler().setDriverAdvancesSchedulerContext(true);
+
+            EeScheduler &ee = env.runtime.eeScheduler();
+            const uint64_t firstTick = ee.currentVSyncTick();
+
+            // One VBlank period, computed the way EeScheduler computes it, so this cannot rot
+            // silently if the clock or the period ever changes.
+            const uint64_t vBlankPeriodCycles = (16667ull * EeScheduler::kEeClockHz + 999999ull) / 1000000ull;
+
+            uint64_t charged = 0u;
+            uint32_t yields = 0u;
+            const uint64_t target = 4ull * vBlankPeriodCycles;
+            while (charged < target)
+            {
+                // This is the guest running: one function call's worth of EE time. Nothing else.
+                charged += EeScheduler::kGuestDispatchCycles;
+                if (ee.checkpointDue(EeScheduler::kGuestDispatchCycles))
+                {
+                    ++yields;
+                }
+            }
+
+            t.IsTrue(yields > 0,
+                     "MECHANISM: charging four VBlank periods of EE time must make checkpointDue() "
+                     "report a checkpoint, because m_eeCycle passed m_nextDeadlineCycle. Only "
+                     "waitForEvent() -- which only run() calls, and only when idle -- accounts for "
+                     "that pass today, so a driver is never told to come back and VBlank never "
+                     "fires: vsync_tick=1 after 54 s while ee_cycle sat ten periods past the "
+                     "deadline. That is W12");
+
+            // And once the driver does come back, the VBlank it was owed must actually be there.
+            std::this_thread::sleep_for(std::chrono::milliseconds(20));
+            ee.serviceInvocations();
+            t.IsTrue(ee.currentVSyncTick() > firstTick,
+                     "servicing the owed checkpoint must advance VBlank, so a guest waiting for the "
+                     "next frame can finish waiting instead of spinning on sce_ChangeThreadPriority");
+        });
+
+        tc.Run("G1.8g: a deferred syscall must not rewind the CALLER's registers", [](TestCase &t)
+        {
+            // W10, on the caller's frame rather than on a count. A guest function seeds $s2, $s3
+            // and $ra, calls a callee whose syscall DEFERS, and resumes at the PC it published.
+            // Every one of those registers must survive. $v0 is the control: it is the one the
+            // runtime writes back by hand, so a run where $v0 is right and the rest are reverted
+            // is a REWIND, not a lost value.
+            ChainEnv env;
+            env.arm();
+
+            // Without this the test asserts nothing. EeScheduler::kMainThreadId is 1 and reset()
+            // leaves m_currentThreadId at the 0 sentinel, so if currentContext() is still null the
+            // driver cannot have been advancing the scheduler's frame, and every assertion below
+            // would pass with the fix reverted. Measured: that is exactly what happened once.
+            t.IsTrue(gChainFrameSelectionOk,
+                     "FIXTURE: currentContext() must resolve after arm(), or this test is not "
+                     "exercising the configuration that breaks. EeScheduler::kMainThreadId is 1, "
+                     "not 0");
+
+            driveLikeTheShippedDriver(env, 32);
+
+            t.IsTrue(gChainResumeRan, "the caller must resume at the PC it published after the "
+                                     "deferred syscall; the callee's return must carry it there");
+            t.Equals(gChainV0AtResume, K_CHAIN_RESULT,
+                     "$v0 must carry the handler's result -- this is the control, and it is the one "
+                     "register the runtime writes back deliberately");
+            t.Equals(gChainRaAtResume, K_CHAIN_RESUME,
+                     "MECHANISM: $ra must still hold the PC the caller published. If it holds the "
+                     "value an EARLIER call set, then a service call overwrote the caller's frame "
+                     "with a stale one between the call and the return.");
+            t.Equals(gChainS2AtResume, K_CHAIN_S2,
+                     "MECHANISM: a callee-saved register the caller set BEFORE the call must still "
+                     "be set when it resumes. A service call that copies a stale frame over the "
+                     "live one takes it, and that is W10: the guest's own convergence loop was "
+                     "fine and the scheduler was rewinding it.");
+            t.Equals(gChainS3AtResume, K_CHAIN_S3,
+                     "and so must the next one -- the rewind takes every register the runtime does "
+                     "not write back by hand");
+        });
+    });
+}
