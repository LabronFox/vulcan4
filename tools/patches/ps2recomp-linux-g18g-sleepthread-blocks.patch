+            t.Equals(mem.translateAddress(0x80011F80u), 0x00011F80u,
+                     "KSEG0 alias of that table must reach the same physical word");
+            t.IsTrue(mem.translateAddress(0x01011F80u) != mem.translateAddress(0x80011F80u),
