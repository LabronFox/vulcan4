+            env.runtime.registerFunction(0x300900u, chainOverrideHandler);
+            env.runtime.registerFunction(K_CHAIN_ENTRY, chainEntry);
+            env.runtime.registerFunction(K_CHAIN_LINK0, chainLink0);
+            env.runtime.registerFunction(K_CHAIN_LINK1, chainLink1);
+            env.runtime.registerFunction(K_CHAIN_LINK2, chainLink2);
+            env.runtime.registerFunction(K_CHAIN_TAIL, chainTail);
+            env.runtime.setEeSyscallOverride(env.rdram.data(), K_CHAIN_SYSCALL, 0x300900u);
+
+            gChainEntryEntries = 0u;
+            gChainLinkEntries = 0u;
+            gChainTailEntries = 0u;
+            gChainHandlerRan = 0u;
+            gChainV0s = 0u;
+            gChainSentinelS2 = 0u;
+            gChainSentinelS3 = 0u;
+            gChainResumePcs.clear();
+
+            env.runtime.cpu().pc = K_CHAIN_ENTRY;
+            const bool drove = driveGuestLikeTheHarness(env.runtime,
+                                                        env.runtime.cpu(),
+                                                        env.rdram.data(),
+                                                        256);
+
+            std::ostringstream detail;
+            detail << "entry=" << gChainEntryEntries
+                   << " links=" << gChainLinkEntries
+                   << " tail=" << gChainTailEntries
+                   << " handler=" << gChainHandlerRan
+                   << " restarted_inside_link=" << gChainResumePcs.size()
+                   << " v0=0x" << std::hex << gChainV0s
+                   << " s2=0x" << gChainSentinelS2
+                   << " s3=0x" << gChainSentinelS3 << std::dec;
+
+            t.IsTrue(drove, ("the driver must reach the end of the chain" + detail.str()).c_str());
+            t.IsTrue(gChainTailEntries == 1u,
+                     ("the chain must run to its tail exactly once" + detail.str()).c_str());
+
+            // THE assertion. Today the entry is entered once per link.
+            t.IsTrue(gChainEntryEntries == 1u,
+                     ("MECHANISM: the entry point must be entered exactly ONCE across a chain of "
+                      "overridden syscalls; being re-entered once per link is GT4 re-running its own "
+                      "CRT init forever"
+                      + detail.str())
+                         .c_str());
+
+            // And the links themselves, once each -- no skipped link, no repeated one.
+            // The entry frame also makes one syscall, so a correct run has K_CHAIN_LINKS + 1.
+            const uint32_t expectedLinks = static_cast<uint32_t>(K_CHAIN_LINKS) + 1u;
+            t.IsTrue(gChainLinkEntries == expectedLinks,
+                     ("each of the " + std::to_string(K_CHAIN_LINKS)
+                      + " links plus the entry must make exactly one syscall each"
+                      + detail.str())
+                         .c_str());
+
+            // Which context the resume PC came from. If the driver re-entered at a PC held in the
+            // scheduler's private copy rather than the one the frame published into
+            // PS2Runtime::m_cpuContext, the entry is what you get.
+            t.IsTrue(gChainResumePcs.empty(),
+                     ("no frame may be restarted from inside a link: a frame that publishes a resume "
+                      "PC and then keeps executing in the same invocation was never resumed"
+                      + detail.str())
+                         .c_str());
+
+            // The value and the registers still have to survive the chain, or the fix bought
+            // correctness of PC with loss of state.
+            t.Equals(gChainHandlerRan, static_cast<uint32_t>(K_CHAIN_LINKS) + 1u,
+                     "the override handler must run once per syscall in the chain");
+            t.Equals(gChainV0s, K_CHAIN_RESULT,
+                     "$v0 must carry the handler result to the tail of the chain");
+            t.Equals(gChainSentinelS2, K_CHAIN_S2_SEED,
+                     "$s2, seeded once at the entry, must survive every link of the chain");
+            t.Equals(gChainSentinelS3, K_CHAIN_S3_SEED,
+                     "$s3, seeded once at the entry, must survive every link of the chain");
+        });
+
+        tc.Run("G1.8e: a heap configured with a real limit is not zero-length", [](TestCase &t)
+        {
+            // W7, eight measurement passes down. GT4 calls sce_SetupHeap(0x010519AC, 0xFFFFFFFF)
+            // and the log line is:
+            //   [SetupHeap] base=0x10519ac alignedBase=0x10519b0 size=0xffffffff
+            //               runtimeBase=0x10519b0 runtimeEnd=0x10519b0
+            // base == end. The heap has NO room, so every allocation the guest makes walks off a
+            // ceiling that never moves, and the copy loop at 0x0100f800 gets an inverted range
+            // (start=0x01051A40, end=0x01051A3F) on the very first call.
+            //
+            // This asserts the heap is usable on its own terms, with no game and no ELF. A
