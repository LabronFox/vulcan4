+                    removeReady(*main);
+                    makeRunning(*main);
+                }
+                else if (!m_pendingInvocations.empty() && main->invocations.empty())
+                {
+                    // Nothing else can run, but the guest queued an invocation. It needs an
+                    // owner and the main frame is the only one there is. This is a scheduling
+                    // necessity, not a wake: the thread still runs, and the invocation is what
+                    // it is running for.
+                    main->status = EeThreadStatus::Ready;
+                    makeRunning(*main);
+                }
+            }
