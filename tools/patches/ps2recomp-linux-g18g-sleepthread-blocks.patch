+            t.Equals(gChainSentinelS3, K_CHAIN_S3_SEED,
+                     "$s3, seeded once at the entry, must survive every link of the chain");
+        });
+
+        tc.Run("G1.8e: a heap configured with a real limit is not zero-length", [](TestCase &t)
+        {
+            // W7, eight measurement passes down. GT4 calls sce_SetupHeap(0x010519AC, 0xFFFFFFFF)
+            // and the log line is:
+            //   [SetupHeap] base=0x10519ac alignedBase=0x10519b0 size=0xffffffff
+            //               runtimeBase=0x10519b0 runtimeEnd=0x10519b0
