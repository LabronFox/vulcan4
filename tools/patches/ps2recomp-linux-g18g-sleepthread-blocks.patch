+            // considered.
+            TestEnv env;
+            constexpr uint32_t kBase = 0x010519B0u;
+            constexpr uint32_t kLimit = 0x01F00000u;
+
+            env.runtime.configureGuestHeap(kBase, kLimit);
+
+            t.IsTrue(env.runtime.guestHeapLimit() > kBase,
+                     "a configured heap must have a limit above its base");
+            t.IsTrue(env.runtime.guestHeapEnd() > env.runtime.guestHeapBase(),
+                     "MECHANISM: a heap whose end equals its base has zero length, so every "
+                     "allocation fails or overruns and no guest can make progress. The end must "
+                     "start at or above the base, not pinned to it.");
+            t.IsTrue(env.runtime.guestHeapLimit() >= env.runtime.guestHeapEnd(),
+                     "the limit must not be below the current end");
+        });
+
+        tc.Run("G1.8e: SetupHeap(-1) gives a heap with room, not a zero-length one", [](TestCase &t)
+        {
+            // The exact call GT4 makes, through the real syscall path, so the handler's own
+            // special-casing of 0xFFFFFFFF is covered and not just the runtime's setter.
+            TestEnv env;
+            R5900Context ctx{};
+            ctx.pc = 0x1000u;
+            setRegU32(ctx, 4, 0x010519ACu); // $a0 = heap base (as GT4 passes it)
+            setRegU32(ctx, 5, 0xFFFFFFFFu); // $a1 = -1, "rest of RAM"
+
+            dispatchNumericSyscall(0x3Du, env.rdram.data(), &ctx, &env.runtime);
+
+            t.IsTrue(env.runtime.guestHeapLimit() > 0x010519B0u,
+                     "-1 must mean rest-of-RAM, i.e. a limit far above the base, not a zero-length heap");
+            t.IsTrue(env.runtime.guestHeapEnd() > env.runtime.guestHeapBase(),
+                     "after SetupHeap(-1) the heap must have room; today end == base and the guest "
+                     "cannot allocate anything at all");
+            t.IsTrue(env.runtime.guestHeapEnd() <= env.runtime.guestHeapLimit(),
+                     "the end must stay within the limit");
+        });
