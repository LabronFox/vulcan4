+++ b/ps2xTest/src/ps2_find_address_tests.cpp
@@ -0,0 +1,146 @@
+// ps2_find_address_tests.cpp - unit tests for the SCE 0x83 FindAddress kernel syscall.
+//
+// WHY THIS EXISTS (goal G1.3)
+//
+//   FindAddress is the syscall Gran Turismo 4 blocks on during its first boot. The handler
+//   shipped with two defects, both found by running the real game and both invisible to
+//   "the game got further" style checking:
+//
+//     1. It scanned the caller's window literally, and the PS2 address space aliases the same
+//        32 MB of RDRAM through KSEG0 (0x20000000), KSEG1 (0x80000000) and the
+//        0x40000000-0x80000000 window. GT4's window [0x00000004, 0x80080000) therefore re-read
+//        the same words ~64 times: 537,001,983 words scanned per call instead of 8,392,703.
+//
+//     2. It returned 0 when the target was not found. The one authoritative statement of the
+//        contract we have -- the copy of the same algorithm inlined in GT4 at guest 0x010285F8
+//        -- ends with `move v0,a0` after the cursor has run past the end of the window, i.e. it
+//        returns the END of the window, not zero. GT4 converges its two scans with
+//        `while (prevResult - 0x20C != curResult - 0x168)`; a zero return makes that
+//        unreachable and the guest re-issues the same failing search forever.
+//
+//   These tests exercise the handler directly against a PS2Memory, so both behaviours are
+//   pinned by assertions rather than inferred from how far a game boots.
+
+#include "MiniTest.h"
+#include "ps2_runtime.h"
+#include "ps2_syscalls.h"
+#include "ps2_stubs.h"
+#include "Kernel/Syscalls/System.h"
+
+#include <cstdint>
+#include <vector>
+
+using namespace ps2_syscalls;
+
+namespace
+{
+    constexpr uint32_t kWindowStart = 0x00010000u;
+    constexpr uint32_t kWindowEnd = 0x00020000u;
+
+    // Place a value in guest memory and return its address.
+    uint32_t plant(PS2Memory &mem, uint32_t address, uint32_t value)
+    {
+        mem.write32(address, value);
+        return address;
+    }
+
+    // Call the handler the way the generated code does: with the three arguments in $a0-$a2 and
+    // reading the result back out of $v0. No PS2Runtime, so this is a pure handler test.
+    uint32_t callFindAddress(PS2Memory &mem, uint32_t start, uint32_t end, uint32_t target)
+    {
+        R5900Context ctx{};
+        ctx.r[4] = _mm_set_epi32(0, 0, 0, static_cast<int>(start));
+        ctx.r[5] = _mm_set_epi32(0, 0, 0, static_cast<int>(end));
+        ctx.r[6] = _mm_set_epi32(0, 0, 0, static_cast<int>(target));
+
+        // The real handler, called directly. No PS2Runtime: FindAddress does not use it.
+        ps2_syscalls::FindAddress(mem.getRDRAM(), &ctx, nullptr);
+
+        return static_cast<uint32_t>(_mm_extract_epi32(ctx.r[2], 0));
+    }
+}
+
+void register_ps2_find_address_tests()
+{
+    MiniTest::Case("FindAddress", [](TestCase &tc)
+    {
+        tc.Run("finds a target and returns the address of the matching word", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+
+            const uint32_t hit = plant(mem, 0x00018000u, 0x010285F8u);
+
+            t.Equals(callFindAddress(mem, kWindowStart, kWindowEnd, 0x010285F8u), 0x80000000u | hit,
+                    "should return the KSEG1 address holding the target");
+        });
+
+        tc.Run("returns the END of the window when the target is absent, never zero", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+
+            plant(mem, 0x00018000u, 0xDEADBEEFu); // present, but not the target
+
+            const uint32_t result = callFindAddress(mem, kWindowStart, kWindowEnd, 0x010285F8u);
+
+            t.IsTrue(result != 0u,
+                     "a miss must not return zero: GT4's convergence loop cannot terminate on 0");
+            // The window end is 4-byte aligned, and the reference implementation walks the
+            // cursor in 4-byte steps until it reaches or passes the end, so it lands on the end.
+            t.Equals(result, kWindowEnd,
+                     "a miss should return the aligned end of the search window");
+        });
+
+        tc.Run("a KSEG-spanning window finds the word without rescanning it 64 times", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+
+            // One physical word. The window spans KSEG0 and KSEG1, which alias the same 32 MB
+            // of RDRAM, so a naive walk would re-read it ~64 times (537,001,983 words for
+            // GT4's window instead of 8,392,703).
+            //
+            // The result is reported in the SAME address family as the window the caller passed,
+            // because that is what lets the guest feed it straight back in as the next `start`.
+            // That is the contract, and it is what the first assertion below pins.
+            const uint32_t physical = 0x00010000u;
+            const uint32_t value = 0x010285F8u;
+            plant(mem, physical, value);
+
+            // The result is ALWAYS reported in the KSEG1 family regardless of the window the
+            // caller passed, so a guest that recovers a table base by subtracting n*4 gets one
+            // consistent answer no matter which alias it searched through.
+            t.Equals(callFindAddress(mem, 0x00010000u, 0x80080000u, value), 0x80000000u | physical,
+                     "a low window still yields a KSEG1 result");
+            t.Equals(callFindAddress(mem, 0x20010000u, 0x80080000u, value), 0x80000000u | physical,
+                     "a KSEG0 start yields the same KSEG1 result, so the two agree");
+        });
+
+        tc.Run("respects the start bound", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+
+            plant(mem, 0x00011000u, 0x010285F8u);
+
+            // Searching strictly after the occurrence must miss, and must return the end.
+            t.Equals(callFindAddress(mem, 0x00011004u, kWindowEnd, 0x010285F8u), kWindowEnd,
+                     "a search starting past the only occurrence must miss cleanly");
+        });
+
+        tc.Run("returns the first match when the value appears twice", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+
+            plant(mem, 0x00012000u, 0x010285F8u);
+            const uint32_t second = plant(mem, 0x00019000u, 0x010285F8u);
+
+            t.Equals(callFindAddress(mem, kWindowStart, kWindowEnd, 0x010285F8u), 0x80000000u | 0x00012000u,
+                     "the first occurrence wins");
+            t.Equals(callFindAddress(mem, 0x00012004u, kWindowEnd, 0x010285F8u), 0x80000000u | second,
+                     "advancing past the first finds the second");
+        });
+    });
+}
