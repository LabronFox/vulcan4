+                const uint32_t physicalOffset = static_cast<uint32_t>(entryPtr - rdram);
+                if (haveScannedRdram && physicalOffset <= highestScannedPhysicalOffset)
+                {
+                    continue;
+                }
+                highestScannedPhysicalOffset = physicalOffset;
+                haveScannedRdram = true;
+            }
+
