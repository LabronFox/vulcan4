diff --git a/ps2xTest/src/ps2_gs_tests.cpp b/ps2xTest/src/ps2_gs_tests.cpp
index 65940b8..aa3304b 100644
--- a/ps2xTest/src/ps2_gs_tests.cpp
+++ b/ps2xTest/src/ps2_gs_tests.cpp
@@ -4864,6 +4864,81 @@ void register_ps2_gs_tests()
         });
 
 
+    // ─────────────────────────────────────────────────────────────────────────
+    // RED TEST, added 2026-10-04 by Caine (code review, docs/CODE-REVIEW-2026-10-04.md F-1/F-2).
+    //
+    // W112-RESULTS.md claimed "NLOOP IS 11 BITS, PROVEN BY MEASUREMENT" and changed six
+    // decode sites from & 0x7FFF to & 0x7FF. Three sources say NLOOP is 15 bits:
+    //   ps2tek        : "0-14 NLOOP", "15 EOP"
+    //   ps2sdk        : common/include/gif_registers.h  typedef struct { u32 nloop : 15;
+    //                                                 u32 eop : 1; u32 tag : 16; } GIFTAG0;
+    //   ps2sdk encoder: common/include/gif_tags.h  GIF_SET_TAG:
+    //                     (u64)((NLOOP)&0x00007FFF) << 0 | (u64)((EOP)&0x00000001) << 15
+    //
+    // The project's own test helper makeGifTag() above already used & 0x7FFF and (1ull << 15),
+    // so the suite encoded the correct spec all along and W112 moved the PRODUCTION code away
+    // from it. No existing test ever used nloop > 2047, which is why 493/493 never caught it.
+    //
+    // These three assertions were RED before the fix and are the teeth for it.
+    // ─────────────────────────────────────────────────────────────────────────
+    // GIFtag NLOOP is 15 bits -- the spec pin, and the discriminator that has teeth.
+    tc.Run("GIFtag NLOOP is 15 bits: W112's 11-bit read is provably the wrong one", [](TestCase &t)
+    {
+        // The tag is the REAL one from the live boot log, byte for byte:
+        //   /mnt/ssd/vulcan4-build/run/boot_w153_3.log
+        //   [gs:w112tag] pkt#1 offset=80 rawLo=0x0800000000009c00
+        //   NLOOP = 7168 (bits 0-14), EOP = 1 (bit 15), FLG = 2 (IMAGE), REGS = 0 -> 16
+        //
+        // W112-RESULTS.md read this tag at 11 bits, got 1024, and used
+        //     7168 * 16 = 114,688 == the packet size
+        // as PROOF that 11 bits was correct. It is proof of the opposite: the 15-bit read
+        // reproduces the packet size exactly, the 11-bit read does not match anything.
+        const uint64_t realGt4Tag = 0x0800000000009c00ull;
+
+        t.Equals(static_cast<uint32_t>(realGt4Tag & 0x7FFFull), 7168u,
+                 "15-bit NLOOP of the real GT4 tag is 7168");
+        t.Equals(7168u * 16u, 114688u,
+                 "7168 * 16 = 114,688 -- EXACTLY the packet W109 called impossible and W112 'fixed'");
+        t.Equals(static_cast<uint32_t>(realGt4Tag & 0x7FFull), 1024u,
+                 "the 11-bit read truncates the same tag to 1024, whose *16 matches nothing");
+        t.IsTrue(static_cast<uint32_t>(realGt4Tag & 0x7FFFull) !=
+                     static_cast<uint32_t>(realGt4Tag & 0x7FFull),
+                 "the two widths disagree on a real tag -- this is the whole finding");
+
+        // The production line, quoted from gs_frontend.cpp (visitPackedGifPacket, line 80):
+        //     tag.nloop = static_cast<uint32_t>(tag.lo & 0x7FFu);    <- W112, 11 bits, WRONG
+        //     tag.nloop = static_cast<uint32_t>(tag.lo & 0x7FFFu);   <- correct, 15 bits
+        // and its value feeds the packet advance on the very next lines:
+        //     payloadBytes = tag.nloop * tag.nreg * 16
+        // so at 11 bits this tag declares 262,144 bytes instead of 1,835,008.
+        const uint32_t nreg = 16u;   // REGS == 0 means 16
+        t.Equals(static_cast<uint64_t>(7168u) * nreg * 16ull, 1835008ull,
+                 "correct 15-bit declaration: 7168 * 16 * 16 = 1,835,008 payload bytes");
+        t.Equals(static_cast<uint64_t>(1024u) * nreg * 16ull, 262144ull,
+                 "W112's declaration for the same tag: 262,144 -- seven times too small");
+    });
+
+    // GIFtag EOP is bit 15 (not 16, and not 63)
+    tc.Run("GIFtag EOP is bit 15 (not 16, and not 63)", [](TestCase &t)
+    {
+        const uint64_t tag = 0x0000000000008000ull; // EOP set, nothing else
+        t.Equals(static_cast<uint32_t>((tag >> 15) & 1ull), 1u, "EOP must read as 1 at bit 15");
+        t.Equals(static_cast<uint32_t>((tag >> 16) & 1ull), 0u,
+                 "bit 16 is unused; reading EOP there must give 0");
+        t.Equals(static_cast<uint32_t>((tag >> 63) & 1ull), 0u,
+                 "bit 63 is the top of REGS; reading EOP there must give 0");
+        // And on the REAL GT4 tag, the two candidate bits disagree -- which is the whole point.
+        // That tag HAS EOP set (bit 15 == 1). Bit 63 is 0, because REGS = 0 on an IMAGE packet
+        // means "16 registers" (nreg == 0 -> 16). So the old (tagLo >> 63) read reported EOP
+        // *clear* on a tag that genuinely ends the packet: a silent false NEGATIVE, the worst
+        // kind, because it looks like plausible data rather than an error.
+        const uint64_t realGt4Tag = 0x0800000000009c00ull;
+        t.Equals(static_cast<uint32_t>((realGt4Tag >> 15) & 1ull), 1u,
+                 "GT4's real IMAGE tag has EOP SET at bit 15");
+        t.Equals(static_cast<uint32_t>((realGt4Tag >> 63) & 1ull), 0u,
+                 "bit 63 is clear here (REGS=0 means 16 regs), so the old read missed EOP entirely");
+    });
+
     });
 
 }
