+        // R14/E2. The EE→IOP SIF1 send must produce the IOP→EE SIF0 completion: the engine's SIF0
+        // completion handler sub_005B1328 (reached on hardware via the ch5 DMAC completion) frees the
+        // posted command's pool entry and SignalSema(46), so [0x00888240]'s 32 slots are reused.
+        // Without it the pool fills, the allocator returns NULL, and the 0x580db0 delay loop spins.
+        // The recompiled runtime has no real IOP, so reproduce the completion here by queuing the
+        // handler for each posted command (a0 = the command's EE source address).
+        if (runtime)
+        {
+            for (uint32_t i = 0; i < pendingCount; ++i)
+            {
+                const Ps2SifDmaTransfer &xfer = pending[i];
+                if (runtime->hasFunction(0x005B1328u))
+                {
+                    GuestInvocation invocation{};
+                    invocation.kind = GuestInvocationKind::Interrupt;
+                    invocation.tag = 0x8000000Au; // SIF command "free slot" id the handler checks
+                    invocation.context = runtime->cpu();
+                    invocation.context.pc = 0x005B1328u;
+                    SET_GPR_U32(&invocation.context, 4, xfer.src);
+                    SET_GPR_U32(&invocation.context, 29, 0u);
+                    SET_GPR_U32(&invocation.context, 31, 0u);
+                    runtime->eeScheduler().queueInvocation(std::move(invocation));
+                }
+            }
+        }
