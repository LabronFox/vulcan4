 {
+    const bool watch = w275BusyProbe() && w275BusyByte(vaddr);
+    if (watch)
+        g_w275GuestBusyHandled = true;
     try
     {
-        return m_memory.read8(vaddr);
+        const uint8_t v = m_memory.read8(vaddr);
+        if (watch)
+        {
+            g_w275GuestBusyHandled = false;
+            w275LogReadByte("PS2Runtime::Load8", vaddr, v, ctx->pc);
+        }
+        return v;
     }
     catch (const std::exception &)
     {
+        if (watch)
+            g_w275GuestBusyHandled = false;
         SignalException(ctx, EXCEPTION_ADDRESS_ERROR_LOAD);
         return 0;
     }
