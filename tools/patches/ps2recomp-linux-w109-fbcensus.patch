+            // W109 MEASUREMENT. Dump the raw GIFTAG words for the big packets. A PACKED tag with
+            // nloop==0 executes the inner loops ZERO times, so the outer loop then re-reads the
+            // whole payload as a fresh stream of GIFTAGs -- i.e. register payload is decoded as
+            // tags. Whether that is what hardware means, or our tag decode is wrong, is decided by
+            // looking at the raw words rather than at the fields we derived from them.
+            if (sizeBytes >= 65536u)
+            {
+                const uint64_t tHi = loadLE64(data + 8);
+                std::ostringstream oss;
+                oss << "[gs:giftag] idx=" << packetIndex << " size=" << sizeBytes << " words:";
+                for (uint32_t w = 0; w < 6u && (w * 8u + 8u) <= sizeBytes; ++w)
+                    oss << " " << std::hex << loadLE64(data + w * 8u) << std::dec;
+                oss << " | nloop_lo15=" << (tagLo & 0x7FFFu)
+                    << " bit16=" << ((tagLo >> 16) & 1u)
+                    << " bit17_altmode=" << ((tagLo >> 17) & 1u)
+                    << " bit46_PRE=" << ((tagLo >> 46) & 1u)
+                    << " flg_58_59=" << ((tagLo >> 58) & 3u)
+                    << " nreg_60_63=" << ((tagLo >> 60) & 0xFu)
+                    << " tagHi=" << std::hex << tHi << std::dec;
+                // W109: is the WHOLE packet empty, or just its head? A packet whose head is zero
+                // could be a bad tag decode; a packet with zero non-zero words is an EMPTY SOURCE,
+                // which is a completely different wall and points at whoever was supposed to fill
+                // the buffer. Report both numbers so the two cannot be confused again.
+                uint64_t nonZero = 0u;
+                uint32_t firstNonZero = 0u;
+                bool haveFirst = false;
+                for (uint32_t off = 0; off + 4u <= sizeBytes; off += 4u)
+                {
+                    uint32_t w = 0u;
+                    std::memcpy(&w, data + off, sizeof(w));
+                    if (w != 0u)
+                    {
+                        ++nonZero;
+                        if (!haveFirst)
+                        {
+                            firstNonZero = off;
+                            haveFirst = true;
+                        }
+                    }
+                }
+                oss << " | nonZeroWords=" << nonZero << "/" << (sizeBytes / 4u)
+                    << " head0x60:";
+                // W109: decode the region around the first non-zero word as GIFTAGs, so we can see
+                // whether a valid tag starts there. If it does, the packet we were handed begins
+                // 108 bytes early and the head is something else (a DMA header), which is a
+                // completely different bug from "the guest sent zeros".
+                for (uint32_t off = 0x60u; off <= 0x90u && off + 8u <= sizeBytes; off += 16u)
+                {
+                    const uint64_t w0 = loadLE64(data + off);
+                    const uint64_t w1 = loadLE64(data + off + 8u);
+                    oss << " @" << std::hex << off << std::dec
+                        << "{nloop=" << (w0 & 0x7FFFu)
+                        << ",flg=" << ((w0 >> 58) & 3u)
+                        << ",nreg=" << (((w0 >> 60) & 0xFu) ? (((w0 >> 60) & 0xFu)) : 16u)
+                        << ",w1=" << std::hex << w1 << std::dec << "}";
+                }
+                if (haveFirst)
+                    oss << " firstNonZero@0x" << std::hex << firstNonZero << std::dec;
+                else
+                    oss << " ALL-ZERO BUFFER";
+                RUNTIME_LOG(oss.str() << std::endl);
+            }
         }
     });
 

