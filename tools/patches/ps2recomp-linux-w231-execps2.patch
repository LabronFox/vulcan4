     return m_stopRequested.load(std::memory_order_relaxed);
 }
 
+void PS2Runtime::clearStop()
+{
+    // Clears only this object's stop flag. EeScheduler::reset() clears its own m_stopRequested,
+    // so the ExecPS2 relaunch (which calls reset) needs both halves: this one and the reset.
+    m_stopRequested.store(false, std::memory_order_relaxed);
+}
+
+void PS2Runtime::requestExecPS2(uint32_t entry, uint32_t gp, uint32_t argc, uint32_t argv)
+{
+    // Record the relaunch request and stop the guest so the driver can perform it at a safe
+    // point (outside the current invocation frame). See the header for why it cannot reset here.
+    m_execPS2Entry = entry;
+    m_execPS2Gp = gp;
+    m_execPS2Argc = argc;
+    m_execPS2Argv = argv;
+    m_pendingExecPS2.store(true, std::memory_order_release);
+    requestStop();
+}
+
+bool PS2Runtime::consumePendingExecPS2(uint32_t &entry, uint32_t &gp, uint32_t &argc, uint32_t &argv)
+{
+    if (!m_pendingExecPS2.load(std::memory_order_acquire))
+    {
+        return false;
+    }
+    entry = m_execPS2Entry;
+    gp = m_execPS2Gp;
+    argc = m_execPS2Argc;
+    argv = m_execPS2Argv;
+    m_pendingExecPS2.store(false, std::memory_order_release);
+    return true;
+}
