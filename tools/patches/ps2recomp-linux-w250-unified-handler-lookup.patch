 bool PS2Runtime::hasFunction(uint32_t address) const
 {
+    // W250. Normalise the KSEG0/KSEG1 mirror (0x80000000/0xA0000000 -> physical) first: the override
+    // table stores the guest's mirror-form handler (e.g. 0x80075000 for 0x00075000), while both
