+    const uint64_t seq = ps2NextTraceSequence();
+    if (isMis)
+    {
+        std::cerr << "[w252:copy] MIS=" << std::dec << g_w252Mis
+                  << " w=" << g_w252InRange
+                  << " got=0x" << std::hex << val
+                  << " exp=0x" << exp
+                  << " pc=0x" << pc
+                  << " dst=0x" << guestAddr
+                  << " seq=" << std::dec << seq
+                  << " n=" << g_w252InRange;
+    }
+    else
+    {
+        std::cerr << "[w252:copy] seq=" << std::dec << seq
+                  << " pc=0x" << std::hex << pc
+                  << " dst=0x" << guestAddr
+                  << " val=0x" << val
