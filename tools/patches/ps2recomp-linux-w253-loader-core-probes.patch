+        const uint32_t prev = g_w252LastDst;
+        std::cerr << "[w252:win] w=" << std::dec << g_w252InRange
+                  << " pc=0x" << std::hex << pc
+                  << " dst=0x" << guestAddr
+                  << " (blob=0x" << (guestAddr - g_w252RefBase) << ")"
+                  << " prev=0x" << prev
+                  << (prev != 0u && guestAddr < prev ? " REWIND" : "")
+                  << " ra=0x" << getRegU32(ctx, 31)
+                  << " sp=0x" << getRegU32(ctx, 29)
+                  << " t0=0x" << getRegU32(ctx, 8)
+                  << " t1=0x" << getRegU32(ctx, 9)
+                  << " t2=0x" << getRegU32(ctx, 10)
+                  << " t3=0x" << getRegU32(ctx, 11)
+                  << " t4=0x" << getRegU32(ctx, 12)
+                  << " t5=0x" << getRegU32(ctx, 13)
+                  << " a2=0x" << getRegU32(ctx, 6)
+                  << " a3=0x" << getRegU32(ctx, 7)
+                  << " s0=0x" << getRegU32(ctx, 16)
+                  << " s1=0x" << getRegU32(ctx, 17)
+                  << " s2=0x" << getRegU32(ctx, 18)
+                  << " s3=0x" << getRegU32(ctx, 19)
+                  << " s4=0x" << getRegU32(ctx, 20)
+                  << std::dec << std::endl;
