+// ==============================================================================================
+// W252 (builder-1, TRACK A). SETTLE THE CORE.GT4 DIVERGENCE BY DIRECT OBSERVATION.
+//
+// What is already measured: our decode of CORE.GT4 is byte-identical to hardware for 872,988
+// bytes, then diverges at blob 0xD521C (decode buffer 0xD5320, guest 0x1394420) and re-converges
+// at blob 0xD80B1 -- 11,365 differing bytes, 517 runs, ALL inside one 64 KB bucket. Our diverging
+// bytes are exactly a valid 21-byte copy of the (identical) prefix at distance 72; the reference
+// token stream says hardware emitted a 12-byte copy at distance 24 there. 15 bits vs 18 bits of
+// Huffman budget cannot both be true inside one dynamic block that never re-syncs, yet the bytes
+// DO re-sync. Inference has produced a contradiction. Only the decoder itself can end it.
+//
+// The emitted match-copy (ps2_recompiled_functions.cpp:77897-78470) is:
+//   0x100f758  beql $t5,$zero,0x100f7f8   ; t5 == window base.  LIKELY branch:
+//   0x100f75c  subu $s1,$t1,$s1  (Delay Slot)   taken  -> s1 = src pointer, delay slot EXECUTES
+//                                               not-taken -> delay slot is NULLIFIED, s1 stays = DISTANCE
+//   0x100f760  window path (t5 != 0):  v0 = (t3 - s1) & 0x7FFF; v0 += t5; a1 = t5 + t3
+//   0x100f77c  lbu $v1,0(v0)   source load      <- window source
+//   0x100f780  sb  $v1,0(t1)   DEST store       <- out pointer
+//   0x100f78c  sb  $v1,0(a1)   window MIRROR store (delay slot of the bne at 0x100f788)
+//   0x100f7f8  direct path (t5 == 0): s2 = s1 + s3 (src end); s1 = src
+//   0x100f7fc  lbu $v0,0(s1)   source load
+//   0x100f800  sb  $v0,0(t1)   DEST store
+// So at a store inside either loop:  t1 = out, t4 = out end, s3 = bytes remaining (== L on the
+// first iteration), and s1 is the DISTANCE in the window path or the SOURCE POINTER in the direct
+// path. Registers a2/a3/t0/t2 (bit count / bit buffer / input ptr / input end) are NOT touched by
+// the byte loops, so they still carry the live bit state at the store.
+//
+// That is the whole measurement: log the first stores at and around the divergent word, with the
+// registers, and compare (L, D, bit position) against the reference token stream. READ-ONLY.
+// OFF unless VULCAN4_W252_COPY is set; LO/HI default to the divergent word 0x1394420.
+// ==============================================================================================
+static uint32_t g_w252Lo = 0x01394400u;
+static uint32_t g_w252Hi = 0x01394480u;
+static uint32_t g_w252Cap = 200u;
+static uint32_t g_w252On = 0u;
+static uint32_t g_w252LoopStores = 0u;   // every WRITE8 from the copy loops, any address
+static uint32_t g_w252InRange = 0u;      // those landing in [LO,HI)
+static uint32_t g_w252FirstLogged = 0u;
+static uint32_t g_w252WinLo = 0u;        // W252 WINDOW: print every in-range write with ordinal in [Lo,Hi]
+static uint32_t g_w252WinHi = 0u;        // 0 = window off (the default)
+static uint32_t g_w252LastDst = 0u;      // previous in-range destination, for the REWIND flag
+
+// W252 CHECKPOINT CROSS-REFERENCE. A store ordinal is the only number that can place a scheduler
+// checkpoint against a store. The W229 checkpoint probes fire on EVERY backward edge, so their cap
+// is spent long before the interesting moment; and a checkpoint that returns (due=true) hands control
+// to servicePendingEventsAtCheckpoint() -- which runs GUEST CODE -- between the last store of one run
+// and the first store of the next. If the rewind coincides with such a checkpoint, that is the cause
+// and it is nameable as two adjacent lines. OFF unless VULCAN4_W252_CKW=LO:HI (decimal, on the
+// in-blob write ordinal).
+static uint32_t g_w252CkwLo = 0u;
+static uint32_t g_w252CkwHi = 0u;        // 0 = off (the default)
+
+// W252 REF MODE. Plain range logging has a cap and cannot answer "was a byte an earlier pass wrote
+// CORRECTLY overwritten LATER?" -- the region is decoded more than once. In REF mode every in-range
+// WRITE8 is compared against a reference blob and only the writes whose value DIFFERS are printed,
+// in emission order, uncapped in count. The first such line IS the first divergence. The store index
+// `w=` is the position in emission order; a byte written twice appears twice, so a later bad pass is
+// visible instead of being hidden behind a cap. OFF unless VULCAN4_W252_REF names a file.
+static const unsigned char *g_w252Ref = nullptr;
+static uint64_t g_w252RefLen = 0u;
+static uint32_t g_w252RefBase = 0x012bf204u;
+static uint32_t g_w252RefOn = 0u;
+static uint32_t g_w252Mis = 0u;          // in-range writes whose value != reference
+static uint32_t g_w252MisCap = 60u;      // how many differing writes to print in full
+static uint32_t g_w252StatEvery = 200u;  // print a progress line every N in-range writes (0 = off)
+
+static const char *w252RegName(int r)
+{
+    static const char *const kNames[32] = {
+        "zero", "at", "v0", "v1", "a0", "a1", "a2", "a3",
+        "t0", "t1", "t2", "t3", "t4", "t5", "t6", "t7",
+        "s0", "s1", "s2", "s3", "s4", "s5", "s6", "s7",
+        "t8", "t9", "k0", "k1", "gp", "sp", "fp", "ra"};
+    return (r >= 0 && r < 32) ? kNames[r] : "??";
+}
+
+static void vulcan4W252CopySub(uint32_t guestAddr,
+                               uint32_t size,
+                               uint64_t valueLo,
+                               const R5900Context *ctx,
+                               const char *op,
+                               uint32_t /*flags*/)
+{
+    if (g_w252On == 0u) { return; }
+    const uint32_t pc = (ctx != nullptr) ? ctx->pc : 0u;
+    if (op == nullptr || std::strcmp(op, "WRITE8") != 0) { return; }
+    const bool inLoop = (pc >= 0x100f390u && pc < 0x100f8c8u);
+    if (!inLoop) { return; }
+    if (g_w252LoopStores == 0u)
+    {
+        // Coverage line: proof the probe is installed AND that the copy loops store at all.
+        std::cerr << "[w252:copy] FIRST copy-loop WRITE8 pc=0x" << std::hex << pc
+                  << " dst=0x" << guestAddr << std::dec
+                  << " (range 0x" << std::hex << g_w252Lo << "..0x" << g_w252Hi << ")" << std::dec
+                  << std::endl;
+    }
+    ++g_w252LoopStores;
+    if (guestAddr < g_w252Lo || guestAddr >= g_w252Hi) { return; }
