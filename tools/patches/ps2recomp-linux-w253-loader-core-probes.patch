+// W253. THE CORE-ENTRY ORDINAL, THE REWIND LOG, AND THE INVISIBLE BYTE STORE.
+//
+// WHY: the loader's DEFLATE decode is CORRECT end to end (0 wrong bytes through w = 6,120,817) and then,
+// 816 bytes before the end, the core writer's OUT POINTER rewinds to blob off 0xD521C and the driver
+// livelocks, rewriting one 11,461-byte band [0xD52CC, 0xD7F91] forever. The writer is FUN_0100F390
+// (guest 0x0100F390), whose retry head is 0x0100F418 -- FIVE of that function's eight backward edges
+// land on it -- and the driver that re-enters it is FUN_0100F8C8 (guest 0x0100F8C8).
+//
+// Neither the retry head nor the byte store at 0x100F800 is visible to the per-entry dispatcher: both
+// run inside one generated function body (the documented reason vulcan4W129CopyProbe lives here too).
+// So all three pieces are emitted BY THE TRANSLATOR, from inline helpers defined here:
+//   (1) vulcan4W253CoreEnter -- prefixed to the instruction at 0x0100F418; counts entries to the retry
+//                              head and prints the four job-struct registers the core consumes.
+//   (2) vulcan4W253Jump      -- emitted at every BACKWARD conditional branch inside
+//                              [0x0100F390, 0x01011000); prints the current ordinal and the same four
+//                              registers, so a rewind reads as "<retry #N> pc -> target".
+//   (4) vulcan4W253ByteStore -- emitted at the byte store 0x100F800, which has NO W130 store-watch
+//                              guard (every neighbouring `sw` does), so today that write is invisible.
+//
+// The knob is read ONCE into a function-local static, so when VULCAN4_W253 is unset every call is a load
+// and a test on an inline-visible variable and nothing is printed: unset = today's behaviour.
+inline bool vulcan4W253On() noexcept
+{
+    static const bool on = std::getenv("VULCAN4_W253") != nullptr;
+    return on;
+}
+
+// The ordinal is shared by the enter counter and the jump log, so a rewind can be read as
+// "retry #N moved the out pointer to X" instead of as an isolated print with no history.
+inline uint64_t &vulcan4W253Ordinal() noexcept
+{
+    static uint64_t ordinal = 0;
+    return ordinal;
+}
+
+inline void vulcan4W253CoreEnter(uint32_t insnAddr, uint32_t ctxPc, uint32_t t1, uint32_t t0,
+                                 uint32_t a3, uint32_t a2) noexcept
+{
+    if (!vulcan4W253On())
+    {
+        return;
+    }
+    const uint64_t n = ++vulcan4W253Ordinal();
+    if (n <= 16u || (n % 100000u) == 0u)
+    {
+        std::fprintf(stderr,
+                     "[w253:core] entry n=%llu insn=0x%08x ctxpc=0x%08x t1=0x%08x t0=0x%08x "
+                     "a3=0x%08x a2=0x%08x\n",
+                     static_cast<unsigned long long>(n), insnAddr, ctxPc, t1, t0, a3, a2);
+    }
+}
+
+inline void vulcan4W253Jump(uint32_t pc, uint32_t target, bool taken, uint32_t t1, uint32_t t0,
+                            uint32_t a3, uint32_t a2) noexcept
+{
+    if (!vulcan4W253On())
+    {
+        return;
+    }
+    static uint64_t jumpHits = 0;
+    ++jumpHits;
+    // BOUNDED ON PURPOSE: the whole bug is a livelock, so an unbounded log is a many-GB file, not a
+    // measurement. The first 64 edges name the shape; the %100000 hits prove it is still going.
+    if (jumpHits <= 64u || (jumpHits % 100000u) == 0u)
+    {
+        std::fprintf(stderr,
+                     "[w253:jump] n=%llu ordinal=%llu pc=0x%08x -> 0x%08x taken=%d t1=0x%08x "
+                     "t0=0x%08x a3=0x%08x a2=0x%08x\n",
+                     static_cast<unsigned long long>(jumpHits),
+                     static_cast<unsigned long long>(vulcan4W253Ordinal()), pc, target, taken ? 1 : 0,
+                     t1, t0, a3, a2);
+    }
+}
+
+inline void vulcan4W253ByteStore(uint32_t addr, uint32_t value, uint32_t writerPc) noexcept
+{
+    if (!vulcan4W253On())
+    {
+        return;
+    }
+    static uint64_t storeHits = 0;
+    ++storeHits;
+    if (storeHits <= 64u || (storeHits % 1000000u) == 0u)
+    {
+        std::fprintf(stderr, "[w253:sb] n=%llu pc=0x%08x addr=0x%08x value=0x%02x\n",
+                     static_cast<unsigned long long>(storeHits), writerPc, addr, value & 0xFFu);
+    }
+}
+
+
