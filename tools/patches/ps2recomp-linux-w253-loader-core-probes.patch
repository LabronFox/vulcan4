+              << " D=" << (t5 == 0u ? "src" : "s1") << "=0x" << s1
+              << " out=0x" << t1
+              << " (out-off-in-blob=0x" << (t1 - 0x12bf204u) << ")"
+              << " winIdx=0x" << getRegU32(ctx, 11)
+              << " winBase=0x" << t5
