+        const long long absBits = static_cast<long long>(inPtr - (0x10d1ac0u + 6u)) * 8LL
+                                  - static_cast<long long>(bitCnt + 32u);
+        std::cerr << " FIRST-EVENT absbits(est)=0x" << std::hex << absBits
+                  << " (" << std::dec << absBits << ")" << std::hex;
+    }
+    std::cerr << std::dec << std::endl;
+}
+
+// ==============================================================================================
+// W252B (builder-1 / TRACK A). AN INSTRUMENT THAT CAN SAY ZERO. The W252 subscriber returns early
+// unless op == "WRITE8" AND pc is inside the decoder AND dst is in [LO,HI); it is therefore blind to
+// wider writes and to every pc outside 0x100f390-0x100f8c8, and a zero from it is not evidence
+// about a region at all (that mistake is recorded in docs/W252-RESULTS.md, A3 + its retraction).
+// This one has NO op filter, NO size filter and NO pc filter: every store of any width that touches
+// [LO,HI) is counted, and the first CAP are printed with pc/ra/op/size/value. Two liveness controls
+// ride along (total store calls, and stores into the hot stack window) so "0 hits" and "never ran"
+// are distinguishable, and a progress line is printed every 500000 calls so a silent run is visible.
+// READ-ONLY, OFF unless VULCAN4_W252B_HIT is set. LO/HI are HEX; CAP is decimal.
+// ==============================================================================================
+static uint32_t g_w252BLo = 0u;
+static uint32_t g_w252BHi = 0u;          // 0 = off (the default): unset env reproduces today exactly
+static uint32_t g_w252BCap = 200u;
+static uint32_t g_w252BHits = 0u;        // stores touching [LO,HI)
+static uint32_t g_w252BCalls = 0u;       // every store, anywhere (liveness control)
+static uint32_t g_w252BCtrl = 0u;        // stores into the stack window (positive control)
+
+// W252B REF MODE. A REFERENCE blob (the hardware blob, byte for byte) turns "these bytes are wrong"
+// into "THIS store, from THIS pc, wrote THIS wrong value". Every byte of every store in [LO,HI) is
+// compared against ref[addr - REFBASE] and only the mismatching bytes are printed, in emission
+// order, so the LAST mismatch for an address is the surviving one. OFF unless VULCAN4_W252B_REF.
+static const unsigned char *g_w252BRef = nullptr;
+static uint32_t g_w252BRefBase = 0u;
+static uint32_t g_w252BRefLen = 0u;
+static uint32_t g_w252BMis = 0u;
+static uint32_t g_w252BMisCap = 400u;
+
+// W252B TAIL RING. When the first mismatching store is found, WHAT the decoder did immediately
+// before it is the question: a literal that is wrong means the BIT READER was already misaligned,
+// and the misalignment was caused by a token a few stores earlier. The last 32 in-window stores are
+// kept verbatim (ordinal, addr, value, pc, op) and dumped, oldest first, on the first mismatch.
+struct W252BRec { uint32_t idx; uint32_t addr; uint32_t val; uint32_t pc; const char *op; };
+static W252BRec g_w252BRing[32];
+static uint32_t g_w252BRingPos = 0u;
+
+// W252B SEQUENCE MAP. Whether the decoder's out pointer ever goes BACKWARDS inside the window is
+// the difference between "one linear decode" and "several passes over the same bytes", and the ring
+// says it does (0x139cfff -> 0x139441f, measured). This prints every non-sequential step so the pass
+// structure is visible instead of inferred. Duplicates (the pc==0 fast-path echo) are skipped.
+static uint32_t g_w252BPrevAddr = 0u;
+static uint32_t g_w252BSeqLines = 0u;
+static uint32_t g_w252BSeqCap = 3000u;
+
+// W252B. The store observer hands us a context but no RDRAM, and at the fault the decoder's STREAM
+// STRUCT (s0) is the thing that matters: bit buffer, bit count, input pointer, window index. Capture
+// the host RDRAM pointer once from PS2Runtime::run(), where it is in scope.
+static uint8_t *g_w252BRdram = nullptr;
+
+static uint32_t vulcan4W252BLoad32(uint32_t guestAddr)
+{
+    return (g_w252BRdram != nullptr) ? *reinterpret_cast<const uint32_t *>(g_w252BRdram + (guestAddr & 0x01FFFFFFu)) : 0u;
+}
+
+static void vulcan4W252BDumpStreamStruct(uint32_t s0)
+{
+    if (g_w252BRdram == nullptr) { std::cerr << "[w252b:str] no rdram captured" << std::endl; return; }
+    std::cerr << "[w252b:str] struct=0x" << std::hex << s0
+              << " buf=0x" << vulcan4W252BLoad32(s0 + 0x00u)
+              << " bufHi=0x" << vulcan4W252BLoad32(s0 + 0x04u)
+              << " nbits=" << std::dec << vulcan4W252BLoad32(s0 + 0x08u)
+              << " in=0x" << std::hex << vulcan4W252BLoad32(s0 + 0x0cu)
+              << " inEnd=0x" << vulcan4W252BLoad32(s0 + 0x10u)
+              << " winBase=0x" << vulcan4W252BLoad32(s0 + 0x14u)
+              << " winIdx=" << std::dec << vulcan4W252BLoad32(s0 + 0x18u)
+              << " out=0x" << std::hex << vulcan4W252BLoad32(s0 + 0x20u)
+              << " outEnd=0x" << vulcan4W252BLoad32(s0 + 0x24u)
+              << " s8=0x" << vulcan4W252BLoad32(s0 + 0x30u)
+              << " m38=0x" << vulcan4W252BLoad32(s0 + 0x38u)
+              << " m3c=0x" << vulcan4W252BLoad32(s0 + 0x3cu)
+              << std::dec << std::endl;
+}
+
+static void vulcan4W252BDumpRing()
+{
+    std::cerr << "[w252b:tail] ---- last 32 in-window stores, oldest first ----" << std::endl;
+    for (uint32_t k = 0u; k < 32u; ++k)
+    {
+        const uint32_t i = (g_w252BRingPos + k) & 31u;
+        const W252BRec &r = g_w252BRing[i];
+        if (r.idx == 0u) { continue; }
+        std::cerr << "[w252b:tail] n=" << std::dec << r.idx
+                  << " addr=0x" << std::hex << r.addr
+                  << " val=0x" << r.val
+                  << " pc=0x" << r.pc
+                  << " op=" << (r.op != nullptr ? r.op : "?") << std::dec << std::endl;
+    }
+    std::cerr << "[w252b:tail] ---- end ----" << std::endl;
+}
+
+static void vulcan4W252BSub(uint32_t guestAddr,
+                            uint32_t size,
+                            uint64_t valueLo,
+                            const R5900Context *ctx,
+                            const char *op,
+                            uint32_t /*flags*/)
+{
+    if (g_w252BHi == 0u) { return; }
+    const uint32_t span = (size != 0u) ? (size - 1u) : 0u;
+    const uint32_t last = guestAddr + span;
+    ++g_w252BCalls;
+    if (guestAddr >= 0x1fff0000u && guestAddr < 0x1ffff000u) { ++g_w252BCtrl; }
+    const bool inWin = (last >= g_w252BLo) && (guestAddr < g_w252BHi);
+    if (inWin)
+    {
+        ++g_w252BHits;
+        const uint32_t curPc = (ctx != nullptr ? ctx->pc : 0u);
+        if (curPc != 0u)
+        {
+            // The pc==0 echo is the fast-path duplicate of the store just seen; it would otherwise
+            // make every single store look like a backwards jump.
+            if (g_w252BSeqLines < g_w252BSeqCap &&
+                g_w252BPrevAddr != 0u && guestAddr != g_w252BPrevAddr + 1u)
+            {
+                ++g_w252BSeqLines;
+                std::cerr << "[w252b:seq] n=" << std::dec << g_w252BHits
+                          << " prev=0x" << std::hex << g_w252BPrevAddr
+                          << " addr=0x" << guestAddr
+                          << " delta=" << std::dec << static_cast<int32_t>(guestAddr - g_w252BPrevAddr - 1u)
+                          << " val=0x" << std::hex << static_cast<uint32_t>(valueLo)
+                          << " pc=0x" << curPc
+                          << " op=" << (op != nullptr ? op : "?") << std::dec << std::endl;
+            }
+            g_w252BPrevAddr = guestAddr;
+            g_w252BRing[g_w252BRingPos & 31u] = W252BRec{g_w252BHits, guestAddr,
+                                                         static_cast<uint32_t>(valueLo),
+                                                         curPc, op};
+            g_w252BRingPos = (g_w252BRingPos + 1u) & 31u;
+        }
+        if (g_w252BHits <= g_w252BCap)
+        {
+            std::cerr << "[w252b:hit] n=" << std::dec << g_w252BHits
+                      << " addr=0x" << std::hex << guestAddr
+                      << " size=" << std::dec << size
+                      << " val=0x" << std::hex << static_cast<uint32_t>(valueLo)
+                      << " pc=0x" << (ctx != nullptr ? ctx->pc : 0u)
+                      << " ra=0x" << (ctx != nullptr ? getRegU32(ctx, 31) : 0u)
+                      << " a0=0x" << (ctx != nullptr ? getRegU32(ctx, 4) : 0u)
+                      << " a1=0x" << (ctx != nullptr ? getRegU32(ctx, 5) : 0u)
+                      << " op=" << (op != nullptr ? op : "?") << std::dec << std::endl;
+        }
+        if (g_w252BRef != nullptr && size <= 8u)
+        {
+            // Scalar stores only. A bulk op (memset/memcpy) is reported as ONE call covering the
+            // whole span; the two in this run both run BEFORE the decode and are fully overwritten,
+            // and counting their transient bytes buries the signal (10.5M false mismatches, measured).
+            for (uint32_t i = 0u; i < size; ++i)
+            {
+                const uint32_t a = guestAddr + i;
+                const uint32_t off = a - g_w252BRefBase;
+                if (off >= g_w252BRefLen) { continue; }
+                const uint32_t got = static_cast<uint32_t>((valueLo >> (8u * i)) & 0xFFu);
+                const uint32_t exp = static_cast<uint32_t>(g_w252BRef[off]);
+                if (got == exp) { continue; }
+                ++g_w252BMis;
+                if (g_w252BMis == 1u)
+                {
+                    vulcan4W252BDumpRing();
+                    if (ctx != nullptr)
+                    {
+                        vulcan4W252BDumpStreamStruct(getRegU32(ctx, 16));
+                        // Full GPR snapshot at the faulting store: the decoder keeps its stream
+                        // struct in s0 (bit buffer, bit count, in ptr, window index, out ptr).
+                        for (uint32_t r = 1u; r < 32u; ++r)
+                        {
+                            std::cerr << "[w252b:reg] $" << std::dec << r
+                                      << "=0x" << std::hex << getRegU32(ctx, r)
+                                      << ((r % 4u == 0u) ? "\n" : "  ");
+                        }
+                        std::cerr << std::dec << std::endl;
+                    }
+                }
+                if (g_w252BMis <= g_w252BMisCap)
+                {
+                    std::cerr << "[w252b:MIS] mis=" << std::dec << g_w252BMis
+                              << " hit=" << g_w252BHits
+                              << " addr=0x" << std::hex << a
+                              << " off=0x" << off
+                              << " ours=0x" << got
+                              << " ref=0x" << exp
+                              << " sz=" << std::dec << size
+                              << " pc=0x" << std::hex << (ctx != nullptr ? ctx->pc : 0u)
+                              << " ra=0x" << (ctx != nullptr ? getRegU32(ctx, 31) : 0u)
+                              << " a0=0x" << (ctx != nullptr ? getRegU32(ctx, 4) : 0u)
+                              << " a1=0x" << (ctx != nullptr ? getRegU32(ctx, 5) : 0u)
+                              << " op=" << (op != nullptr ? op : "?") << std::dec << std::endl;
+                }
+            }
+        }
+    }
+    if ((g_w252BCalls % 500000u) == 0u)
+    {
+        std::cerr << "[w252b:live] calls=" << std::dec << g_w252BCalls
+                  << " hits=" << g_w252BHits
+                  << " ctrl=" << g_w252BCtrl
+                  << " mis=" << g_w252BMis
+                  << " lastAddr=0x" << std::hex << guestAddr << std::dec << std::endl;
+    }
+}
