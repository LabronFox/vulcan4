+            uint32_t entry = 0u;
+            std::memcpy(&number, table + (i * 8u), sizeof(number));
+            std::memcpy(&entry, table + (i * 8u) + 4u, sizeof(entry));
+            if (number == wanted)
+            {
+                setReturnU32(ctx, entry);
+                return true;
+            }
+        }
