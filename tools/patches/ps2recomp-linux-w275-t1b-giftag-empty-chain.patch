+// W275 T1-followup. Targeted DMAC busy-byte / CHCR watch, gated on VULCAN4_W275_BUSY (OFF by
+// default). These live on the guest memory entry points because they are the only place with the
+// guest PC in hand; the memory-layer probe in ps2_memory.cpp is suppressed during the inner call
+// (g_w275GuestBusyHandled) so an event is logged with its PC exactly once. A guest poll of the busy
+// byte can run hot, so reads are printed on value change and on a heartbeat; writes always.
+extern thread_local bool g_w275GuestBusyHandled;
+
+static bool w275BusyProbe() noexcept
+{
+    static const bool on = std::getenv("VULCAN4_W275_BUSY") != nullptr;
+    return on;
+}
+// Address map correction (T1-followup #2). The guest helper sub_0100DE58 is called with the DMAC
+// channel index in $a0 and computes the busy byte as
+//     0x100de88 sll  $v1,$s0,1 ; 0x100de94 addu $v1,$v1,$s0 ; 0x100de9c sll $v1,$v1,2
+//     0x100dea4 addiu $v1,$v1,0x60 ; 0x100dea8 lui $a0,0x7000 ; 0x100deb0 ...
+//     0x100deb4 addiu $a1,$zero,1 ; 0x100debc sb $a1,0xD($a0)
+// i.e. byte = 0x70002000 + s0*12 + 0x60 + 0xD = 0x7000206D + s0*0xC. The stride is 12, NOT 16:
+// s0=0 (VIF0) -> 0x7000206D, s0=1 (VIF1) -> 0x70002079, s0=2 (GIF) -> 0x70002085,
+// s0=3 -> 0x70002091. The earlier watch set (0x6D/0x7D/0x89) could never have seen the GIF byte.
+static bool w275BusyByte(uint32_t a) noexcept
+{
+    // Widened to the whole possible window on the third measurement. The second run showed 2924
+    // SleepThread calls whose caller returns to 0x100afa8 -- the loop's own `lbu $v1,0x0($s0)` -- but
+    // only ONE watched read at that pc, so the polled byte must be at an address the enumerated set
+    // never covered. A range has no blind spot: 0x70002060..0x700020A0 covers stride 12 (0x6D/79/85/
+    // 91), stride 16 (0x6D/7D/8D/9D) and everything in between.
+    return a >= 0x70002060u && a <= 0x700020A0u;
