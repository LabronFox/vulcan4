+    // W275 T1-followup. Targeted DMAC busy-byte watch, gated on VULCAN4_W275_BUSY (OFF by default:
+    // unset reproduces today's behaviour byte for byte). The EE DMAC channel-busy byte lives in
+    // scratchpad at 0x7000206D + channel*12 for channels 0/1/2. This prints the raw scratchpad
+    // traffic on those bytes (and the 32-bit words that contain them) plus the three CHCR registers,
+    // so the write/read ordering can be read off a single boot.
+    inline bool w275BusyEnabled()
+    {
+        static const bool on = (std::getenv("VULCAN4_W275_BUSY") != nullptr);
+        return on;
+    }
+    inline bool w275BusyByte(uint32_t addr)
+    {
+        return addr == 0x7000206Du || addr == 0x7000207Du || addr == 0x70002089u;
+    }
+    inline bool w275BusyWord(uint32_t addr)
+    {
+        return addr == 0x7000206Cu || addr == 0x7000207Cu || addr == 0x70002088u;
+    }
+    inline bool w275ChcrAddr(uint32_t addr)
+    {
+        return addr == 0x10008000u || addr == 0x10009000u || addr == 0x1000A000u;
+    }
+
+    // W275 T1-followup #2. GIF chain-walk trace, gated on VULCAN4_W275_GIFTAG (OFF by default).
+    // The boot halts with a live-locking tid2 waiting on the ch2 (GIF, 0x1000A000) chain transfer:
+    // the CHCR kick (0x10000185 = DIR|MOD=1|TIE) enters the mode==1 walker and no completion ever
+    // follows. This prints TADR, every tag the walker actually reads (raw 16 bytes) and what became
+    // of chainBuf, so the drop point is readable instead of inferred.
+    inline bool w275GifTagEnabled()
+    {
+        static const bool on = (std::getenv("VULCAN4_W275_GIFTAG") != nullptr);
+        return on;
+    }
+    inline const char *w275ChName(uint32_t channelBase)
