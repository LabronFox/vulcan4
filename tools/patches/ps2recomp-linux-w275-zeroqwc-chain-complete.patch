+        case 0x10008000u: return "VIF0";
+        case 0x10009000u: return "VIF1";
+        case 0x1000A000u: return "GIF";
+        case 0x1000D000u: return "SPR_FROM";
+        case 0x1000D400u: return "SPR_TO";
+        default: return "?";
+        }
+    }
