=== W277: LOADFILE SifLoadModule (rpc=0) + IopHost::loadModule bridge ===
# The engine loads its IOP drivers via raw SIF RPC LOADFILE (sid 0x80000006) rpc=0
# (SifLoadModule), which the R29 loadfile service refused. This patch:
#  1. adds IopHost::loadModule (bridges the loadfile service to PS2Runtime::loadIopModule)
#  2. implements rpc=0 in loadfile.cpp: read the inline path, load the IRX, reply moduleId.
# Verified: 16 IRX modules load (SIO2MAN..SMAP), dbcman+cdvd+0x80000400 bind and answer.

diff --git a/ps2xIOP/include/ps2x/iop/iop_host.h b/ps2xIOP/include/ps2x/iop/iop_host.h
index 1eceb08..7fe7956 100644
--- a/ps2xIOP/include/ps2x/iop/iop_host.h
+++ b/ps2xIOP/include/ps2x/iop/iop_host.h
@@ -109,6 +109,20 @@ namespace ps2x::iop
 
         virtual int32_t memoryCard(const MemoryCardRequest &request) = 0;
 
+        // Load an IOP module (IRX) from the disc image, the same path the EE syscall
+        // sceSifLoadModule uses. W277: the raw SIF RPC LOADFILE rpc=0 (SifLoadModule) reaches the
+        // loadfile service instead of the syscall, and the service must be able to perform the load.
+        // The default fails so host/test stubs stay source-compatible; PS2IopHostAdapter overrides it.
+        virtual ModuleLoadResult loadModule(std::string_view path,
+                                            const void *arguments,
+                                            uint32_t argumentSize)
+        {
+            (void)path;
+            (void)arguments;
+            (void)argumentSize;
+            return ModuleLoadResult{false, -1, -1};
+        }
+
         virtual bool hasGuestFunction(uint32_t address) const = 0;
         virtual bool invokeGuestFunction(uint64_t callToken,
                                          uint32_t address,
diff --git a/ps2xRuntime/src/lib/ps2_iop_host.cpp b/ps2xRuntime/src/lib/ps2_iop_host.cpp
index 8d46e03..d3563b6 100644
--- a/ps2xRuntime/src/lib/ps2_iop_host.cpp
+++ b/ps2xRuntime/src/lib/ps2_iop_host.cpp
@@ -405,6 +405,16 @@ void PS2IopHostAdapter::closeHostFile(uint64_t handle)
     }
 }
 
+ps2x::iop::ModuleLoadResult PS2IopHostAdapter::loadModule(std::string_view path,
+                                                          const void *arguments,
+                                                          uint32_t argumentSize)
+{
+    // W277: the loadfile service (raw SIF RPC LOADFILE rpc=0 = SifLoadModule) performs the same
+    // physical IRX load as the EE syscall sceSifLoadModule. Route both through the runtime's single
+    // loader so a module loaded by either path ends up in the one IOP emulator.
+    return m_runtime.loadIopModule(path, arguments, argumentSize);
+}
+
 int32_t PS2IopHostAdapter::memoryCard(const ps2x::iop::MemoryCardRequest &request)
 {
     using Handler = void (*)(uint8_t *, R5900Context *, PS2Runtime *);
diff --git a/ps2xRuntime/src/lib/ps2_iop_host.h b/ps2xRuntime/src/lib/ps2_iop_host.h
index 89d8576..eb9e763 100644
--- a/ps2xRuntime/src/lib/ps2_iop_host.h
