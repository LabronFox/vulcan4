@@ -74,6 +74,12 @@ public:
 
     int32_t memoryCard(const ps2x::iop::MemoryCardRequest &request) override;
 
+    // W277: the raw SIF RPC LOADFILE rpc=0 (SifLoadModule) reaches the loadfile service, which must
