     std::unique_ptr<IopService> createFileIoService(IopHost &host);
     std::unique_ptr<IopService> createMcservService(IopHost &host);
+    std::unique_ptr<IopService> createCdvdService(IopHost &host);
+    // W276 R29. LOADFILE, sid 0x80000006.
+    std::unique_ptr<IopService> createLoadFileService(IopHost &host);
+    // W277. "PCDV" = PDI_CDVD_Manager, sid 0x50434456, the DVD streaming layer.
+    std::unique_ptr<IopService> createPdicdvdService(IopHost &host);
