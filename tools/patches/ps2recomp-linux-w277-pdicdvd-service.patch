=== W277: PDI CDVD service stubs (sids 0x50434456 "PCDV" + 0x50636476 "Pcdv") ===
# The engine loads PDICDVD.IRX + LIBPDI.IRX (LOADFILE rpc=0) then binds both sids; no route
# existed so the binds retried forever. This adds a stub service (like dbcman) that claims both
# sids, gated on pdicdvd/libpdi module aliases, logs every RPC, and invents no replies.
# Verified: both binds resolve (boot_w277pcdv2.log), game proceeds to PCDV rpc=0 then a
# Ghidra-missed fn (0x578288) closed at the tool input (w276-engine_r30.toml).

diff --git a/ps2xIOP/CMakeLists.txt b/ps2xIOP/CMakeLists.txt
index e35218d..cf7b90a 100644
--- a/ps2xIOP/CMakeLists.txt
+++ b/ps2xIOP/CMakeLists.txt
@@ -29,6 +29,13 @@ add_library(ps2_iop STATIC
     src/modules/libsd.cpp
     src/modules/fileio.cpp
     src/modules/mcserv.cpp
+    src/modules/cdvd.cpp
+    # W276 R29. LOADFILE (sid 0x80000006). GT4 binds it and the bind has no server, so the guest's
+    # own retry loop never exits: 15 binds and 8 "has no server ... Not fabricating a server" lines
+    # in run/boot_w276r28on.log before the run dies at 0x5c1d50.
+    src/modules/loadfile.cpp
+    # W277. "PCDV" (0x50434456) = PDI_CDVD_Manager, the DVD streaming layer.
+    src/modules/pdicdvd.cpp
 )
 
 target_compile_features(ps2_iop PUBLIC cxx_std_20)
diff --git a/ps2xIOP/src/iop_subsystem.cpp b/ps2xIOP/src/iop_subsystem.cpp
index 11262fc..453c75e 100644
--- a/ps2xIOP/src/iop_subsystem.cpp
+++ b/ps2xIOP/src/iop_subsystem.cpp
@@ -24,6 +24,15 @@ namespace ps2x::iop
             coreServices.emplace_back(detail::createDbcmanService(host));
             coreServices.emplace_back(detail::createLibSdService(host));
             coreServices.emplace_back(detail::createFileIoService(host));
+            coreServices.emplace_back(detail::createCdvdService(host));
+            // W276 R29. LOADFILE (0x80000006). Without this route canBindRpc(0x80000006) is false,
+            // SifRpcRawBind leaves client->server NULL, and the guest's bind-once wrapper at
+            // 0x5b6268 spins its own retry loop instead of ever issuing the call it guards.
+            coreServices.emplace_back(detail::createLoadFileService(host));
+            // W277. "PCDV" (0x50434456) = PDI_CDVD_Manager, the DVD streaming layer. The engine
+            // loads PDICDVD.IRX via LOADFILE rpc=0 then binds this sid; without a route the bind
+            // retries forever (boot_w277r30.log tail).
+            coreServices.emplace_back(detail::createPdicdvdService(host));
             refreshServiceModuleKeys();
             rebuildRoutes();
         }
