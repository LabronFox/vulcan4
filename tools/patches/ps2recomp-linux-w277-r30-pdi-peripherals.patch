diff --git a/ps2xIOP/src/modules/loadfile.cpp b/ps2xIOP/src/modules/loadfile.cpp
new file mode 100644
index 0000000..e48603f
--- /dev/null
+++ b/ps2xIOP/src/modules/loadfile.cpp
@@ -0,0 +1,333 @@
+#include "module_factories.h"
+#include "rpc_reply.h"
+
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        // LOADFILE -- the IOP Module/ELF loader, SIF RPC server id 0x80000006.
+        //
+        // WHY THIS FILE EXISTS. GT4's EE code binds 0x80000006 and never gets a server, so the
+        // guest's own retry loop cannot exit. MEASURED 2026-10-08, /mnt/ssd/vulcan4-build/run/
+        // boot_w276r28on.log lines 65684..66511: `[SIFRPC] bind a=0x889e80 b=0x80000006 c=0x0 d=0x0`
+        // occurs FIFTEEN times before the run dies, and each one is preceded by the runtime's own
+        //
+        //   VULCAN 4 LIMITATION: SIF RPC bind sid=0x80000006 client=0x889e80 has no server (no
+        //   emulated IRX registered that sid and no HLE route can bind it), so cd->server stays NULL
+        //   and the guest retries. Not fabricating a server.
+        //
+        // The bind caller, disassembled out of w231-engine.elf (0x5b6268..0x5b6354), is a
+        // bind-once wrapper gated on a flag at 0x658358: it calls sceSifBindRpc(0x889e80,
+        // 0x80000006, 0) at 0x5b629c, then at 0x5b62b4 executes `lw v0,36(s0)` -- client->server at
+        // client+0x24 -- and `beqz v0, 0x5b631c` takes the RETRY path when the runtime could not
+        // bind. So the guest has no way past this line except a non-NULL server word.
+        //
+        // The server word and the call it guards are BOTH ORACLE-MEASURED against the live PCSX2
+        // (see kFfReplyWord and kRpcFf below), which is why this service answers rather than
+        // refuses: this is behaviour read off the real machine, not behaviour invented here.
+        //
+        // WHAT IS *NOT* CLAIMED. This is not a module loader. Nothing here reads an IRX or an ELF
+        // off the disc; the disc-side load path is dbcman's, and it is untouched by this file. The
+        // five documented LOADFILE functions (ps2tek resources/09-ps2tek.md:6583 -- 00h
+        // SifLoadModule .. 05h SifLoadElfEncrypted) are NOT decoded and are refused below with an
+        // explicit limitation. Only the one function number this image actually issues is answered,
+        // and only with the word the oracle was measured writing.
+        constexpr uint32_t kLoadFileSid = 0x80000006u;
+
+        // Function number on kLoadFileSid, from the call site at 0x5b62c8 (`li a1,255`). It is not
+        // any of ps2tek's documented 00h..05h, and the corpus has nothing on it -- so the number is
+        // all that is known and it is not given a meaning here.
+        constexpr uint32_t kRpcFf = 0xffu;
+
+        // ORACLE MEASUREMENT, not an invention. PCSX2, live EE, breakpoint at the instruction after
+        // the guest's sceSifCallRpc (0x5b62e8, Cycles 1810654115): the call returned v0 = 0, and the
+        // 4-byte receive buffer 0x889c80 went from all-zeros to 33 30 30 30 .. i.e. this word. The
+        // guest then copies exactly those 4 bytes to client+0x28 = 0x889ea8 (0x5b6304-0x5b6310).
+        //
+        // The SEMANTICS of the word are not decoded. It is written because matching the oracle is
+        // the safest possible choice here: whatever the guest does with client+0x28 downstream, the
+        // real machine does it with this value, so reproducing the value reproduces the machine's
+        // state. A LIMITATION line states the gap once, at the first reply, rather than passing the
+        // value off as understood.
+        constexpr uint32_t kFfReplyWord = 0x30303033u;
+
+        // cdvdfsv/fileio reasoning, and it applies verbatim: LOADFILE is resident on the IOP (it is
+        // the thing that does the loading), so GT4 never sceSifLoadModule's it. A service gated on
+        // an alias that no load event will ever fire would stay dormant and the bind would keep
+        // failing -- which is exactly the bug this file fixes. No aliases = always routed.
+        class LoadFileService final : public IopService
+        {
+        public:
+            explicit LoadFileService(IopHost &host)
+                : m_host(host)
+            {
+            }
+
+            [[nodiscard]] std::string_view name() const override { return "loadfile"; }
+
+            [[nodiscard]] std::span<const uint32_t> sids() const override { return kSids; }
+
+            [[nodiscard]] std::span<const std::string_view> moduleAliases() const override
+            {
+                return {};
+            }
+
+            void reset() override
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_ffCalls = 0u;
+                m_refusals = 0u;
+                m_moduleLoads = 0u;
+                m_announcedFfLimitation = false;
+            }
+
+            [[nodiscard]] RpcResult handleRpc(const RpcRequest &request) override
+            {
+                if (request.sid != kLoadFileSid)
+                {
+                    return RpcResult{};
+                }
+
+                if (request.function == kRpcFf)
+                {
+                    return doFf(request);
+                }
+
+                // W277. rpc=0 is SifLoadModule (ps2tek 09-ps2tek.md L6583). The engine loads its IOP
+                // drivers this way -- the first one measured is cdrom0:\IRX\SIO2MAN.IRX;1. Answer it
+                // by actually loading the IRX through the same loader the EE syscall uses, not by
+                // refusing; a refusal is what kept the guest in its retry loop.
+                if (request.function == 0u)
+                {
+                    return doLoadModule(request);
+                }
+
+                return refuse(request);
+            }
+
+            void appendDebugMetrics(std::vector<DebugMetric> &metrics) const override
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                metrics.push_back({"loadfile_ff_calls", m_ffCalls, false});
+                metrics.push_back({"loadfile_module_loads", m_moduleLoads, false});
+                metrics.push_back({"loadfile_refusals", m_refusals, false});
+            }
+
+        private:
+            // The measured reply above is only meaningful if it fits: the guest asks for 4 bytes
+            // (`li t2,4` at 0x5b62dc). Refuse loudly rather than truncating silently if that ever
+            // changes, because a short write here would hand the guest a half-updated buffer.
+            RpcResult doFf(const RpcRequest &request)
+            {
+                uint64_t calls = 0u;
+                bool announce = false;
+                {
+                    std::lock_guard<std::mutex> lock(m_mutex);
+                    calls = ++m_ffCalls;
+                    announce = !m_announcedFfLimitation;
+                    m_announcedFfLimitation = true;
+                }
+
+                if (request.receive.address == 0u || request.receive.size < sizeof(kFfReplyWord))
+                {
+                    std::fprintf(stderr,
+                                 "VULCAN 4 LIMITATION: LOADFILE sid=0x%08x rpc=0xff asked for a %u-byte "
+                                 "reply (receive=0x%08x) and the only measured reply is %zu bytes — "
+                                 "refusing rather than truncating it into the guest's buffer\n",
+                                 request.sid, request.receive.size, request.receive.address,
+                                 sizeof(kFfReplyWord));
+                    return replyWord(request, 0);
+                }
+
+                if (announce)
+                {
+                    std::fprintf(stderr,
+                                 "VULCAN 4 LIMITATION: LOADFILE rpc=0xff reply 0x%08x is the word the "
+                                 "oracle wrote to 0x889c80 (PCSX2, breakpoint 0x5b62e8, Cycles "
+                                 "1810654115) — its SEMANTICS are not decoded, only its value is "
+                                 "measured; the guest copies it to client+0x28. Every other LOADFILE "
+                                 "rpc (00h..05h SifLoadModule/SifLoadElf) is refused, not faked\n",
+                                 kFfReplyWord);
+                }
+
+                {
+                    std::ostringstream message;
+                    message << "[LOADFILE:HLE] rpc=0xff reply=0x" << std::hex << kFfReplyWord
+                            << " call=" << std::dec << calls;
+                    m_host.log(LogLevel::Info, message.str());
+                }
+
+                return replyWord(request, static_cast<int32_t>(kFfReplyWord));
+            }
+
+            RpcResult replyWord(const RpcRequest &request, int32_t value) const
+            {
+                const uint32_t word = static_cast<uint32_t>(value);
+                if (request.receive.address != 0u &&
+                    request.receive.size >= sizeof(uint32_t))
+                {
+                    (void)m_host.writeGuest(request.receive.address, &word, sizeof(word));
+                }
+
+                RpcResult result;
+                result.handled = true;
+                result.resultAddress = request.receive.address;
+                return result;
+            }
+
+            // W277 diagnostic: for rpc=0 (SifLoadModule) the send buffer is the loadfile inpacket
+            // { mode, arg1, arg2, arg3 } where arg1 is the guest pointer to the module path. Dump it
+            // so the exact module being asked for is known, before deciding whether to serve it.
+            void dumpSend(const RpcRequest &request) const
+            {
+                if (request.send.address == 0u || request.send.size < 16u)
+                {
+                    std::fprintf(stderr, "[LOADFILE:send] rpc=%u send=0x%08x size=%u (no packet)\n",
+                                 request.function, request.send.address, request.send.size);
+                    return;
+                }
+                uint32_t packet[4]{};
+                (void)m_host.readGuest(request.send.address, packet, sizeof(packet));
+                const uint32_t mode = packet[0];
+                const uint32_t arg1 = packet[1];
+                const uint32_t arg2 = packet[2];
+                const uint32_t arg3 = packet[3];
+                std::string path;
+                if (arg1 != 0u && arg1 < 0x02000000u)
+                {
+                    char buf[128]{};
+                    (void)m_host.readGuest(arg1, buf, sizeof(buf) - 1u);
+                    path.assign(buf);
+                    if (path.size() > 100u)
+                    {
+                        path.resize(100u);
+                    }
+                }
+                std::fprintf(stderr,
+                             "[LOADFILE:send] rpc=%u mode=0x%08x arg1=0x%08x arg2=0x%08x arg3=0x%08x "
+                             "path=\"%s\"\n",
+                             request.function, mode, arg1, arg2, arg3, path.c_str());
+            }
+
+            // W277: SifLoadModule. The send buffer is the loadfile inpacket, MEASURED 2026-10-08 on
+            // the live run (boot_w277diag.log): { mode @0, arg_len @4, then the null-terminated
+            // module path INLINE starting at @8, then the argument bytes }. arg1 is NOT a pointer in
+            // this image's protocol -- the path travels inside the packet, so read it from +8.
+            RpcResult doLoadModule(const RpcRequest &request)
+            {
+                if (request.send.address == 0u || request.send.size < 9u)
+                {
+                    return refuse(request);
+                }
+
+                const uint32_t pathAddr = request.send.address + 8u;
+                const uint32_t remaining = request.send.size - 8u;
+                char path[256]{};
+                size_t pathLen = 0u;
+                while (pathLen < sizeof(path) - 1u && pathLen < remaining)
+                {
+                    char c = '\0';
+                    if (!m_host.readGuest(pathAddr + static_cast<uint32_t>(pathLen), &c, 1u))
+                    {
+                        break;
+                    }
+                    if (c == '\0')
+                    {
+                        break;
+                    }
+                    path[pathLen++] = c;
+                }
+                path[pathLen] = '\0';
+                if (pathLen == 0u)
+                {
+                    return refuse(request);
+                }
+
+                uint32_t argLen = 0u;
+                (void)m_host.readGuest(request.send.address + 4u, &argLen, sizeof(argLen));
+                std::vector<uint8_t> args;
+                if (argLen != 0u && argLen <= 0x10000u)
+                {
+                    args.resize(argLen);
+                    const uint32_t argsAddr = pathAddr + static_cast<uint32_t>(pathLen) + 1u;
+                    if (!m_host.readGuest(argsAddr, args.data(), argLen))
+                    {
+                        args.clear();
+                    }
+                }
+
+                const ps2x::iop::ModuleLoadResult loaded =
+                    m_host.loadModule(path, args.empty() ? nullptr : args.data(), argLen);
+                const int32_t reply =
+                    (loaded.handled && loaded.moduleId > 0) ? loaded.moduleId : -1;
+
+                {
+                    std::lock_guard<std::mutex> lock(m_mutex);
+                    ++m_moduleLoads;
+                }
+                {
+                    std::ostringstream message;
+                    message << "[LOADFILE:HLE] SifLoadModule path=\"" << path << "\" argLen="
+                            << argLen << " -> moduleId=" << (loaded.handled ? loaded.moduleId : -1);
+                    m_host.log(LogLevel::Info, message.str());
+                }
+                if (reply < 0)
+                {
+                    std::fprintf(stderr,
+                                 "VULCAN 4 LIMITATION: LOADFILE SifLoadModule path=\"%s\" could not "
+                                 "be loaded (handled=%d moduleId=%d) — the file is missing from the "
+                                 "cdrom0: root or the IOP loader refused it; the guest will retry\n",
+                                 path, loaded.handled ? 1 : 0, loaded.moduleId);
+                }
+                return replyWord(request, reply);
+            }
+
+            // Law 2 / Law 3: name the gap, answer failure. A module load that claims success would
+            // make the guest jump into an IRX that was never loaded -- a wild branch several hundred
+            // frames later, which is a far more expensive bug than an honest -1 here.
+            RpcResult refuse(const RpcRequest &request)
+            {
+                {
+                    std::lock_guard<std::mutex> lock(m_mutex);
+                    ++m_refusals;
+                }
+
+                if (request.function == 0u)
+                {
+                    dumpSend(request);
+                }
+
+                std::fprintf(stderr,
+                             "VULCAN 4 LIMITATION: LOADFILE sid=0x%08x rpc=%u is not implemented — "
+                             "the guest asked the module loader for a function this provider does not "
+                             "decode (only the measured rpc=0xff is answered); the disc-side load path "
+                             "is dbcman's and is not touched here, and answering success would be a "
+                             "lie\n",
+                             request.sid, request.function);
+
+                return replyWord(request, 0);
+            }
+
+            IopHost &m_host;
+            mutable std::mutex m_mutex;
+            uint64_t m_ffCalls = 0u;
+            uint64_t m_refusals = 0u;
+            uint64_t m_moduleLoads = 0u;
+            bool m_announcedFfLimitation = false;
+            inline static constexpr std::array<uint32_t, 1> kSids{kLoadFileSid};
+        };
+    }
+
+    std::unique_ptr<IopService> createLoadFileService(IopHost &host)
+    {
+        return std::make_unique<LoadFileService>(host);
+    }
+}
diff --git a/ps2xIOP/src/modules/pdicdvd.cpp b/ps2xIOP/src/modules/pdicdvd.cpp
new file mode 100644
index 0000000..5f5d68c
--- /dev/null
+++ b/ps2xIOP/src/modules/pdicdvd.cpp
@@ -0,0 +1,140 @@
+#include "module_factories.h"
+#include "rpc_reply.h"
+
+#include <array>
+#include <cstdint>
+#include <mutex>
+#include <sstream>
+#include <string>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        // W277. The PDI CDVD services. GT4's libpdi/PDICDVD layer registers TWO SIF RPC sids,
+        // measured in run/boot_w277pcdv.log:
+        //   0x50434456 = "PCDV"  (bind a=0x86cb84) -- unblocked by this stub
+        //   0x50636476 = "Pcdv"  (bind a=0x86cc84) -- the NEXT bind, still failing after "PCDV"
+        // Both are provided by the PDI_CDVD_Manager / pdicdvd / libpdi IRX modules (PDICDVD.IRX and
+        // LIBPDI.IRX), which the engine loads via LOADFILE rpc=0 (moduleIds 21 and 16 in
+        // boot_w277r30.log) immediately before binding these sids. The R29 loadfile fix made those
+        // loads succeed; the binds then fail because no route exists, and the guest retries forever.
+        //
+        // This file is a STUB in the same sense dbcman.cpp is: it claims the sids so the binds
+        // resolve, and it LOGS every RPC so the protocol is revealed, but it does not yet decode or
+        // serve the DVD read/seek/stream RPCs. No function is answered with an invented value; a
+        // known function is answered only when its reply is measured.
+        constexpr uint32_t kPcdvSid = 0x50434456u; // "PCDV"
+        constexpr uint32_t kPcdvSidMixed = 0x50636476u; // "Pcdv"
+        constexpr uint32_t kMaxUnknownRpcLogs = 64u;
+
+        class PdicdvdService final : public IopService
+        {
+        public:
+            explicit PdicdvdService(IopHost &host)
+                : m_host(host)
+            {
+            }
+
+            [[nodiscard]] std::string_view name() const override { return "pdicdvd"; }
+
+            [[nodiscard]] std::span<const uint32_t> sids() const override { return kSids; }
+
+            [[nodiscard]] std::span<const std::string_view> moduleAliases() const override
+            {
+                return kModuleAliases;
+            }
+
+            void reset() override
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_unknownRpcLogCount = 0u;
+            }
+
+            [[nodiscard]] RpcResult handleRpc(const RpcRequest &request) override
+            {
+                RpcResult result;
+                if (request.sid != kPcdvSid && request.sid != kPcdvSidMixed)
+                {
+                    return result;
+                }
+
+                result.handled = true;
+                result.resultAddress = request.receive.address;
+                // W277. rpc=0 is the PDI CDVD init: a fire-and-forget NOWAIT RPC (recv=0). On real
+                // hardware the IOP signals the client's completion semaphore when init finishes, so the
+                // EE thread parked in sce_WaitSema wakes. Without this flag the runtime never signals,
+                // and the streamer's completion semaphores stay parked forever (halt=stuck_in_syscall).
+                // Only rpc=0 is signalled for now; any later rpc (read/seek/stream) still needs its
+                // protocol decoded from the oracle before it is answered.
+                if (request.function == 0u)
+                {
+                    result.signalCompletion = true;
+                }
+
+                bool shouldLog = false;
+                {
+                    std::lock_guard<std::mutex> lock(m_mutex);
+                    if (m_unknownRpcLogCount < kMaxUnknownRpcLogs)
+                    {
+                        ++m_unknownRpcLogCount;
+                        shouldLog = true;
+                    }
+                }
+                if (shouldLog)
+                {
+                    std::ostringstream message;
+                    message << "[PCDV:stub]"
+                            << " rpc=0x" << std::hex << request.function
+                            << " send=0x" << request.send.address
+                            << " sendSize=0x" << request.send.size
+                            << " recv=0x" << request.receive.address
+                            << " recvSize=0x" << request.receive.size
+                            << " mode=0x" << request.mode
+                            << " endFn=0x" << request.endFunction
+                            << " endParam=0x" << request.endParameter;
+                    m_host.log(LogLevel::Info, message.str());
+                }
+                // W277: dump the send buffer as 32-bit words so the init packet (rpc=0, 0x40 bytes)
+                // is legible without another run. The DVD init params live here.
+                if (request.send.address != 0u && request.send.size >= 4u)
+                {
+                    const uint32_t count =
+                        (request.send.size > 64u ? 64u : request.send.size) / 4u;
+                    std::ostringstream dump;
+                    dump << "[PCDV:send] rpc=0x" << std::hex << request.function << " words=" << std::dec
+                         << count << ":";
+                    for (uint32_t i = 0u; i < count; ++i)
+                    {
+                        uint32_t w = 0u;
+                        if (m_host.readGuest(request.send.address + i * 4u, &w, 4u))
+                        {
+                            dump << ' ' << std::hex << w;
+                        }
+                    }
+                    m_host.log(LogLevel::Info, dump.str());
+                }
+                return result;
+            }
+
+            void appendDebugMetrics(std::vector<DebugMetric> &metrics) const override
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                metrics.push_back({"pdicdvd_unknown_rpc_logs", m_unknownRpcLogCount, false});
+            }
+
+        private:
+            inline static constexpr std::array<uint32_t, 2> kSids{kPcdvSid, kPcdvSidMixed};
+            inline static constexpr std::array<std::string_view, 3> kModuleAliases{"pdicdvd", "pdi_cdvd_manager", "libpdi"};
+
+            IopHost &m_host;
+            mutable std::mutex m_mutex;
+            uint32_t m_unknownRpcLogCount = 0u;
+        };
+    }
+
+    std::unique_ptr<IopService> createPdicdvdService(IopHost &host)
+    {
+        return std::make_unique<PdicdvdService>(host);
+    }
+}
diff --git a/ps2xIOP/src/modules/pdiperiph.cpp b/ps2xIOP/src/modules/pdiperiph.cpp
new file mode 100644
index 0000000..b72f251
--- /dev/null
+++ b/ps2xIOP/src/modules/pdiperiph.cpp
@@ -0,0 +1,180 @@
+#include "module_factories.h"
+#include "rpc_reply.h"
+
+#include <array>
+#include <cstdint>
+#include <mutex>
+#include <sstream>
+#include <string>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        // W277. The remaining PDI services GT4 binds after the DVD streamer, measured in
+        // boot_w277r30h.log. Each is registered by an IRX whose init never runs in our IOP, so each
+        // bind has "no server" and the guest retries. Claimed here so the binds resolve; every RPC is
+        // logged and NONE is answered with an invented value until its reply is measured.
+        //
+        //   0x53545250 "STRP"  PDISTR.IRX   PDI stream / movie player (retried 4x = the r30h wall)
+        //   0x534d5550 "SMUP"  PDISPU2.IRX  PDI audio (SPU2)
+        //   0x54485550 "THUP"  PDIUSB.IRX   PDI USB host
+        //   0x45535550 "ESUP"  PDIUSB.IRX   PDI USB (extension)
+        //   0x424b5550 "BKUP"  PDIUSB.IRX   PDI USB keyboard/backup
+        //
+        // The P-prefixed service convention matches pdicdvd ("PCDV" 0x50434456) and ustorage
+        // ("PUST" 0x50555354). Same stub shape: signal completion for rpc=0 (the fire-and-forget
+        // init every PDI service uses) and log the rest.
+        constexpr uint32_t kPdistrSid = 0x53545250u; // "STRP"
+        constexpr uint32_t kPdispu2Sid = 0x534d5550u; // "SMUP"
+        constexpr uint32_t kSpupSid = 0x53505550u; // "SPUP" = PDISPU2 SPU2 audio (r30n wall)
+        constexpr uint32_t kSputSid = 0x53505554u; // "SPUT" = PDISPU2 SPU2 (r30o wall)
+        constexpr uint32_t kPdiusbHostSid = 0x54485550u; // "THUP"
+        constexpr uint32_t kPdiusbMainSid = 0x62737550u; // "Pusb" = PDIUSB main (r30p wall)
+        constexpr uint32_t kPdiusbExtSid = 0x45535550u; // "ESUP"
+        constexpr uint32_t kPdiusbKbSid = 0x424b5550u; // "BKUP"
+        constexpr uint32_t kPbgmSid = 0x5042474du; // "PBGM" (bound after PDIUSB/USTORAGE; LGDEV/POWOFF/RTINETB era)
+        constexpr uint32_t kNumericSid = 0x046d046du; // Logitech USB vendor id 0x046d twice = LGDEV.IRX
+        constexpr uint32_t kMpg1Sid = 0x4d504731u; // "MPG1" = MPEG-1 video decoder
+        constexpr uint32_t kMpg2Sid = 0x4d504732u; // "MPG2" = MPEG-2 video decoder
+        constexpr uint32_t kVoiceSid = 0x564f4943u; // "VOIC" = voice/ADPCM decoder
+        constexpr uint32_t kMaxUnknownRpcLogs = 64u;
+
+        const char *sidName(uint32_t sid)
+        {
+            switch (sid)
+            {
+            case kPdistrSid: return "pdistr";
+            case kPdispu2Sid: return "pdispu2";
+            case kSpupSid: return "spup";
+            case kSputSid: return "sput";
+            case kPdiusbHostSid: return "pdiusb-host";
+            case kPdiusbMainSid: return "pdiusb-main";
+            case kPdiusbExtSid: return "pdiusb-ext";
+            case kPdiusbKbSid: return "pdiusb-kb";
+            case kPbgmSid: return "pbgm";
+            case kNumericSid: return "lgdev";
+            case kMpg1Sid: return "mpg1";
+            case kMpg2Sid: return "mpg2";
+            case kVoiceSid: return "voice";
+            default: return "pdi?";
+            }
+        }
+
+        class PdiPeripheralService final : public IopService
+        {
+        public:
+            explicit PdiPeripheralService(IopHost &host)
+                : m_host(host)
+            {
+            }
+
+            [[nodiscard]] std::string_view name() const override { return "pdiperiph"; }
+
+            [[nodiscard]] std::span<const uint32_t> sids() const override { return kSids; }
+
+            [[nodiscard]] std::span<const std::string_view> moduleAliases() const override
+            {
+                return kModuleAliases;
+            }
+
+            void reset() override
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_unknownRpcLogCount = 0u;
+            }
+
+            [[nodiscard]] RpcResult handleRpc(const RpcRequest &request) override
+            {
+                RpcResult result;
+                if (request.sid != kPdistrSid && request.sid != kPdispu2Sid &&
+                    request.sid != kSpupSid && request.sid != kSputSid &&
+                    request.sid != kPdiusbHostSid && request.sid != kPdiusbMainSid &&
+                    request.sid != kPdiusbExtSid &&
+                    request.sid != kPdiusbKbSid && request.sid != kPbgmSid &&
+                    request.sid != kNumericSid && request.sid != kMpg1Sid &&
+                    request.sid != kMpg2Sid && request.sid != kVoiceSid)
+                {
+                    return result;
+                }
+
+                result.handled = true;
+                result.resultAddress = request.receive.address;
+                // These PDI peripheral rpcs are all NOWAIT fire-and-forget (mode=0x1, endFn=0). The
+                // guest parks in WaitSema until the completion semaphore fires, so every one must be
+                // signalled. The reply buffer is left as the (zeroed) send buffer; for the observed
+                // init/probe calls an empty buffer means "no device", which is the honest default
+                // until the oracle measures a real reply.
+                result.signalCompletion = true;
+
+                bool shouldLog = false;
+                {
+                    std::lock_guard<std::mutex> lock(m_mutex);
+                    if (m_unknownRpcLogCount < kMaxUnknownRpcLogs)
+                    {
+                        ++m_unknownRpcLogCount;
+                        shouldLog = true;
+                    }
+                }
+                if (shouldLog)
+                {
+                    std::ostringstream message;
+                    message << "[PDI:" << sidName(request.sid) << "]"
+                            << " rpc=0x" << std::hex << request.function
+                            << " send=0x" << request.send.address
+                            << " sendSize=0x" << request.send.size
+                            << " recv=0x" << request.receive.address
+                            << " recvSize=0x" << request.receive.size
+                            << " mode=0x" << request.mode
+                            << " endFn=0x" << request.endFunction
+                            << " endParam=0x" << request.endParameter;
+                    m_host.log(LogLevel::Info, message.str());
+                }
+                if (request.send.address != 0u && request.send.size >= 4u)
+                {
+                    const uint32_t count =
+                        (request.send.size > 64u ? 64u : request.send.size) / 4u;
+                    std::ostringstream dump;
+                    dump << "[PDI:" << sidName(request.sid) << ":send]"
+                         << " rpc=0x" << std::hex << request.function << " words=" << std::dec << count
+                         << ":";
+                    for (uint32_t i = 0u; i < count; ++i)
+                    {
+                        uint32_t w = 0u;
+                        if (m_host.readGuest(request.send.address + i * 4u, &w, 4u))
+                        {
+                            dump << ' ' << std::hex << w;
+                        }
+                    }
+                    m_host.log(LogLevel::Info, dump.str());
+                }
+                return result;
+            }
+
+            void appendDebugMetrics(std::vector<DebugMetric> &metrics) const override
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                metrics.push_back({"pdiperiph_unknown_rpc_logs", m_unknownRpcLogCount, false});
+            }
+
+        private:
+            inline static constexpr std::array<uint32_t, 13> kSids{kPdistrSid, kPdispu2Sid,
+                                                                    kSpupSid, kSputSid,
+                                                                    kPdiusbHostSid, kPdiusbMainSid,
+                                                                    kPdiusbExtSid,
+                                                                    kPdiusbKbSid, kPbgmSid,
+                                                                    kNumericSid, kMpg1Sid,
+                                                                    kMpg2Sid, kVoiceSid};
+            inline static constexpr std::array<std::string_view, 3> kModuleAliases{"pdistr", "pdispu2", "pdiusb"};
+
+            IopHost &m_host;
+            mutable std::mutex m_mutex;
+            uint32_t m_unknownRpcLogCount = 0u;
+        };
+    }
+
+    std::unique_ptr<IopService> createPdiPeripheralService(IopHost &host)
+    {
+        return std::make_unique<PdiPeripheralService>(host);
+    }
+}
diff --git a/ps2xIOP/src/modules/ustorage.cpp b/ps2xIOP/src/modules/ustorage.cpp
new file mode 100644
index 0000000..7d26b71
--- /dev/null
+++ b/ps2xIOP/src/modules/ustorage.cpp
@@ -0,0 +1,130 @@
+#include "module_factories.h"
+#include "rpc_reply.h"
+
+#include <array>
+#include <cstdint>
+#include <mutex>
+#include <sstream>
+#include <string>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        // W277. GT4's USB mass-storage service, registered by USTORAGE.IRX. The engine loads
+        // USTORAGE.IRX (moduleId 25 in boot_w277r30g.log) then binds this sid; without a route the
+        // bind retries forever (the r30g wall). Same class as pdicdvd.cpp: the IRX is loaded as a
+        // physical blob but its init never runs, so no server is registered and no HLE route exists.
+        //
+        // The sid 0x50555354 reads "PUST" = "P" + "UST" (USB storage), Polyphony's P-prefixed
+        // service convention (cf. "PCDV" 0x50434456). Claimed here so the bind resolves; every RPC
+        // is logged and NONE is answered with an invented value until its reply is measured.
+        constexpr uint32_t kUstorageSid = 0x50555354u; // "PUST"
+        constexpr uint32_t kMaxUnknownRpcLogs = 64u;
+
+        class UstorageService final : public IopService
+        {
+        public:
+            explicit UstorageService(IopHost &host)
+                : m_host(host)
+            {
+            }
+
+            [[nodiscard]] std::string_view name() const override { return "ustorage"; }
+
+            [[nodiscard]] std::span<const uint32_t> sids() const override { return kSids; }
+
+            [[nodiscard]] std::span<const std::string_view> moduleAliases() const override
+            {
+                return kModuleAliases;
+            }
+
+            void reset() override
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_unknownRpcLogCount = 0u;
+            }
+
+            [[nodiscard]] RpcResult handleRpc(const RpcRequest &request) override
+            {
+                RpcResult result;
+                if (request.sid != kUstorageSid)
+                {
+                    return result;
+                }
+
+                result.handled = true;
+                result.resultAddress = request.receive.address;
+                // Mirror pdicdvd: rpc=0 is the init. If it is a fire-and-forget NOWAIT call
+                // (recv=0) the completion semaphore must be signalled or the guest parks in
+                // WaitSema. This is a measured behaviour for PCDV; for USTORAGE it is logged first
+                // (mode/endFn) so the shape is verified before any reply value is invented.
+                if (request.function == 0u)
+                {
+                    result.signalCompletion = true;
+                }
+
+                bool shouldLog = false;
+                {
+                    std::lock_guard<std::mutex> lock(m_mutex);
+                    if (m_unknownRpcLogCount < kMaxUnknownRpcLogs)
+                    {
+                        ++m_unknownRpcLogCount;
+                        shouldLog = true;
+                    }
+                }
+                if (shouldLog)
+                {
+                    std::ostringstream message;
+                    message << "[USTORAGE:stub]"
+                            << " rpc=0x" << std::hex << request.function
+                            << " send=0x" << request.send.address
+                            << " sendSize=0x" << request.send.size
+                            << " recv=0x" << request.receive.address
+                            << " recvSize=0x" << request.receive.size
+                            << " mode=0x" << request.mode
+                            << " endFn=0x" << request.endFunction
+                            << " endParam=0x" << request.endParameter;
+                    m_host.log(LogLevel::Info, message.str());
+                }
+                if (request.send.address != 0u && request.send.size >= 4u)
+                {
+                    const uint32_t count =
+                        (request.send.size > 64u ? 64u : request.send.size) / 4u;
+                    std::ostringstream dump;
+                    dump << "[USTORAGE:send] rpc=0x" << std::hex << request.function << " words="
+                         << std::dec << count << ":";
+                    for (uint32_t i = 0u; i < count; ++i)
+                    {
+                        uint32_t w = 0u;
+                        if (m_host.readGuest(request.send.address + i * 4u, &w, 4u))
+                        {
+                            dump << ' ' << std::hex << w;
+                        }
+                    }
+                    m_host.log(LogLevel::Info, dump.str());
+                }
+                return result;
+            }
+
+            void appendDebugMetrics(std::vector<DebugMetric> &metrics) const override
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                metrics.push_back({"ustorage_unknown_rpc_logs", m_unknownRpcLogCount, false});
+            }
+
+        private:
+            inline static constexpr std::array<uint32_t, 1> kSids{kUstorageSid};
+            inline static constexpr std::array<std::string_view, 1> kModuleAliases{"ustorage"};
+
+            IopHost &m_host;
+            mutable std::mutex m_mutex;
+            uint32_t m_unknownRpcLogCount = 0u;
+        };
+    }
+
+    std::unique_ptr<IopService> createUstorageService(IopHost &host)
+    {
+        return std::make_unique<UstorageService>(host);
+    }
+}
diff --git a/ps2xRecomp/src/lib/control_flow_emitter.cpp b/ps2xRecomp/src/lib/control_flow_emitter.cpp
