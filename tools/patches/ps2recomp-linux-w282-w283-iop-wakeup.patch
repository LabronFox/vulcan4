+    IopThreadStats IopKernel::debugStats() const noexcept
+    {
+        IopThreadStats stats;
+        stats.total = m_threads.size();
+        for (const auto &[id, thread] : m_threads)
+        {
+            switch (thread.state)
+            {
+            case IopThreadState::Dormant:   ++stats.dormant; break;
+            case IopThreadState::Ready:     ++stats.ready; break;
+            case IopThreadState::Running:   ++stats.running; break;
+            case IopThreadState::Sleep:     ++stats.sleep; break;
+            case IopThreadState::Delay:
+                ++stats.delay;
+                if (stats.earliestWake == 0u || thread.wakeCycle < stats.earliestWake)
+                    stats.earliestWake = thread.wakeCycle;
+                break;
+            case IopThreadState::Semaphore: ++stats.semaphore; break;
+            case IopThreadState::EventFlag: ++stats.eventFlag; break;
+            case IopThreadState::Suspended: ++stats.suspended; break;
+            case IopThreadState::Dead:      ++stats.dead; break;
+            }
+        }
+        if (m_currentThread != nullptr)
+        {
+            stats.sampleId = m_currentThread->id;
+            stats.samplePc = m_currentThread->cpu.pc;
+            stats.sampleState = static_cast<uint8_t>(m_currentThread->state);
+        }
+        return stats;
+    }
+
+    std::vector<IopThreadInfo> IopKernel::debugThreads() const
+    {
+        std::vector<IopThreadInfo> out;
+        out.reserve(m_threads.size());
+        for (const auto &[id, thread] : m_threads)
+        {
+            IopThreadInfo info;
+            info.id = thread.id;
+            info.state = static_cast<uint8_t>(thread.state);
+            info.entry = thread.entry;
+            info.pc = thread.cpu.pc;
+            info.priority = thread.priority;
+            info.wakeCycle = thread.wakeCycle;
+            info.waitId = thread.waitId;
+            info.waitBits = thread.waitBits;
+            info.waitMode = thread.waitMode;
+            info.wakeupCount = thread.wakeupCount;
+            out.push_back(info);
+        }
+        return out;
+    }
