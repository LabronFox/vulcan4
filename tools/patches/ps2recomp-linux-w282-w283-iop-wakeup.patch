+// W282 (2026-10-10, Caine). THE BACK-EDGE PC OBSERVER — because the branch observer never fires for a
+// tight loop INSIDE one recompiled function.
+//
+// Measured twice now: `VULCAN4_PC_PROBE=0x580dd8` produced **zero** hits while the same run's PC
+// histogram put 84 % of its samples at exactly that address. A recompiled `bne` back-edge is a direct
+// goto, not a `dispatchGuestBranch`, and the generated code's only return to the runtime inside such a
+// loop is `eeCheckpointDue()` — so a loop head was invisible to the entry-anchored probe and the
+// comparison against the oracle could not be made at all. This hook is called there.
+//
+// Same contract as the branch observer: one predictable null check per checkpoint when nothing is
+// installed, nothing when the environment does not ask for it (Law 12).
+using PS2PcObserver = void (*)(const R5900Context *ctx);
+
+inline PS2PcObserver g_ps2PcObserver = nullptr;
+
+inline void ps2SetPcObserver(PS2PcObserver observer)
+{
+    g_ps2PcObserver = observer;
+}
+
+inline void ps2TracePc(const R5900Context *ctx)
+{
+    if (g_ps2PcObserver != nullptr)
+    {
+        g_ps2PcObserver(ctx);
+    }
+}
